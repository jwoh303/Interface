			<groupId>sapjco</groupId>
			<artifactId>sapjco</artifactId>
			<version>2.1.8</version>
			<scope>system</scope>
			<systemPath>${project.basedir}/src/main/webapp/WEB-INF/lib/sapjco.jar</systemPath>

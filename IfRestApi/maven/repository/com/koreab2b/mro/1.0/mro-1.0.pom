		<dependency>
			<groupId>webserviceutils</groupId>
			<artifactId>webserviceutils</artifactId>
			<version>1.0</version>
			<scope>system</scope>
			<systemPath>${project.basedir}/src/main/webapp/WEB-INF/lib/webserviceutils.jar</systemPath>
		</dependency>

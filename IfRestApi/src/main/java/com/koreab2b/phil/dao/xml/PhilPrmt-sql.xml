<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap      
    PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
    "http://ibatis.apache.org/dtd/sql-map-2.dtd">    
<sqlMap namespace="philPrmt">	
	<insert id="insertPointBatch" parameterClass="java.util.Map">
		INSERT INTO TBL_APIF_PMI_POINT (
			MEMID,
			TOTAL_POINT
		) VALUES (
			#memId#,
			#totalPoint#        
		)
	</insert>

	<select id="checkConnection" resultClass="java.lang.Integer">
    	SELECT 1
	</select>
</sqlMap>   
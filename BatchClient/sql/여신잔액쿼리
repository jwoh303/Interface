SELECT CD_PARTNER, MAX(NM_PARTNER) AS NM_PARTNER,
       CD_CC, MAX(NM_CC) NM_CC, 
       GUBUN, SUM(N_AMOUNT) AS "잔액"
  FROM (
  SELECT CD_PARTNER, NM_PARTNER,
         CASE
           WHEN CD_ACCT IN ('1111010', '1111020', '1111030') THEN '채권'
           WHEN CD_ACCT IN ('1111110', '1111120') THEN '어음'
           WHEN CD_ACCT IN ('2141000') THEN '선수금'
           ELSE 'X'
         END AS GUBUN,
         N_AMOUNT,
         CD_CC, NM_CC
    FROM EAI.ERP_TACCOUNT_IF A
   WHERE CD_CC NOT IN ('1000', '*', '110010', '010000', '130100000','210100') 
  )
 GROUP BY CD_PARTNER, CD_CC, GUBUN
 ORDER BY CD_CC, CD_PARTNER, GUBUN
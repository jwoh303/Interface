SELECT * 
  FROM (
SELECT CD_CC, MAX(NM_CC) NM_CC, CD_PARTNER, MAX(NM_PARTNER) NM_PARTNER, SUM(선수금) "선수금", SUM(어음) "어음", SUM(채권) "채권"
  FROM (
SELECT CD_CC, NM_CC, CD_PARTNER, NM_PARTNER, 
       CASE GUBUN
         WHEN '선수금' THEN AMOUNT ELSE 0
       END AS "선수금", 
       CASE GUBUN
         WHEN '어음' THEN AMOUNT ELSE 0
       END AS "어음", 
       CASE GUBUN
         WHEN '채권' THEN AMOUNT ELSE 0
       END AS "채권"
  FROM (
    SELECT 
           GUBUN, CD_CC, MAX(NM_CC) NM_CC, CD_PARTNER, MAX(NM_PARTNER) NM_PARTNER, SUM(N_AMOUNT) AS AMOUNT
      FROM (
        SELECT 
               CASE
                 WHEN CD_ACCT LIKE '11110%' THEN '채권'
                 WHEN CD_ACCT LIKE '11111%' THEN '어음'
                 WHEN CD_ACCT LIKE '2%' THEN '선수금'
                 ELSE 'X'
               END GUBUN, A.*
          FROM EAI.ERP_TACCOUNT_IF A
         WHERE CD_COMPANY = '1000'
           AND CD_CC NOT IN ('*','010000')
         ORDER BY CD_CC, CD_ACCT, CD_PARTNER  
      )
     GROUP BY GUBUN, CD_CC, CD_PARTNER 
     ORDER BY CD_CC, GUBUN, CD_PARTNER
  )
)
 GROUP BY CD_CC, CD_PARTNER 
 ORDER BY CD_CC, CD_PARTNER 
  );
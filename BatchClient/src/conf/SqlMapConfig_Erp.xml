<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE sqlMapConfig      
    PUBLIC "-//ibatis.apache.org//DTD SQL Map Config 2.0//EN"      
    "http://ibatis.apache.org/dtd/sql-map-config-2.dtd">

<sqlMapConfig>
  <settings 
  		cacheModelsEnabled="true"
  		enhancementEnabled="true"
  		lazyLoadingEnabled="true"
  		maxRequests="30"
  		maxSessions="10"
  		maxTransactions="5"
  />
  
  <!-- USING JDBC CONNECTION -->    
  <transactionManager type="JDBC" commitRequired="false">
    <dataSource type="SIMPLE">
      <property name="JDBC.Driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
      <property name="JDBC.ConnectionURL" value="jdbc:sqlserver://192.168.101.34;SelectMethod=cursor;DatabaseName=ERPIF;"/>
      <property name="JDBC.Username" value="if_user"/>
      <property name="JDBC.Password" value="if_user"/>
    </dataSource>
  </transactionManager>
  
  <sqlMap resource="com/kep/taxbill/dao/xml/TaxAccountIf_ERP.xml"/>
  
  <!-- Monthly Closing Interface -->
  <sqlMap resource="com/kep/monthclosing/dao/xml/MonthClosingKhrm.xml"/>

</sqlMapConfig>
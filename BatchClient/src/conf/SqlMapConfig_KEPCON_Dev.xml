<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE sqlMapConfig      
    PUBLIC "-//ibatis.apache.org//DTD SQL Map Config 2.0//EN"      
    "http://ibatis.apache.org/dtd/sql-map-config-2.dtd">

<sqlMapConfig>
  <settings 
  		cacheModelsEnabled="true"
  		enhancementEnabled="true"
  		lazyLoadingEnabled="true"
  		maxRequests="30"
  		maxSessions="10"
  		maxTransactions="5"
  />
  
  <!-- USING JDBC CONNECTION -->    
  <transactionManager type="JDBC" commitRequired="false">
    <dataSource type="SIMPLE">
      <property name="JDBC.Driver" value="oracle.jdbc.driver.OracleDriver"/>
      <property name="JDBC.ConnectionURL" value="jdbc:oracle:thin:@devcon.cukhtzeurgnz.ap-northeast-2.rds.amazonaws.com:1521:KEPCON"/>
      <property name="JDBC.Username" value="kepcon"/>
      <property name="JDBC.Password" value="kep1357!"/>
    </dataSource>
  </transactionManager>
  
  <!-- EDI-Parsing -->
  <sqlMap resource="com/kep/supplyon/dao/xml/ParseEDI.xml"/>
  
  <!-- ExchangeRate -->
  <sqlMap resource="com/kep/exchangerate/dao/xml/ExchangeRate.xml"/>

  <!-- TaxBill -->
  <sqlMap resource="com/kep/taxbill/dao/xml/TaxBillAuth.xml"/>
  <sqlMap resource="com/kep/taxbill/dao/xml/TaxBillStatus.xml"/>
  <sqlMap resource="com/kep/taxbill/dao/xml/TaxAccountIf.xml"/>
  
  <!-- Monthly Closing Interface -->
  <sqlMap resource="com/kep/monthclosing/dao/xml/MonthClosingKepcon.xml"/>
  
  <!-- GS Approval Interface -->
  <sqlMap resource="com/kep/gsenc/dao/xml/GsencApp.xml"/>
  
  <!-- common -->
  <sqlMap resource="com/kep/common/dao/xml/CommonQueries.xml"/>
  
  <!-- Duzon ERP -->
  <sqlMap resource="com/kep/duzon/dao/xml/ErpKepcon.xml"/>

</sqlMapConfig>

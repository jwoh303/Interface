<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap      
    PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
    "http://ibatis.apache.org/dtd/sql-map-2.dtd">

<sqlMap namespace="Hanjin">

	<resultMap id="order" class="java.util.HashMap">
		<result property="custEdiCd" column="CUSTEDICD"/>
		<result property="svcCatCd" column="SVCCATCD"/>
		<result property="custOrdNo" column="CUSTORDNO"/>		
		<result property="cntractNo" column="CNTRACTNO"/>
		<result property="pickupAskDt" column="PICKUPASKDT"/>
		<result property="sndrZip" column="SNDRZIP"/>
		<result property="sndrBaseAddr" column="SNDRBASEADDR"/>
		<result property="sndrDtlAddr" column="SNDRDTLADDR"/>
		<result property="sndrNm" column="SNDRNM"/>
		<result property="sndrTelNo" column="SNDRTELNO"/>
		<result property="rcvrZip" column="RCVRZIP"/>
		<result property="rcvrBaseAddr" column="RCVRBASEADDR"/>
		<result property="rcvrDtlAddr" column="RCVRDTLADDR"/>
		<result property="rcvrNm" column="RCVRNM"/>
		<result property="rcvrTelNo" column="RCVRTELNO"/>
		<result property="rcvrMobileNo" column="RCVRMOBILENO"/>
		<result property="rcvrAskCntent" column="RCVRASKCNTENT"/>
		<result property="rcvrRefCntent" column="RCVRREFCNTENT"/>
		<result property="payTypCd" column="PAYTYPCD"/>
		<result property="boxTypCd" column="BOXTYPCD"/>
		<result property="comodityNm" column="COMODITYNM"/>	
	</resultMap>
	<resultMap id="cancel" class="java.util.HashMap">
		<result property="custEdiCd" column="CUSTEDICD"/>		
		<result property="custOrdNo" column="CUSTORDNO"/>		
	</resultMap>
	<resultMap id="print" class="java.util.HashMap">
		<result property="client_id" column="CLIENT_ID"/>		
		<result property="csr_num" column="CSR_NUM"/>
		<result property="address" column="ADDRESS"/>
		<result property="snd_zip" column="SND_ZIP"/>
		<result property="rcv_zip" column="RCV_ZIP"/>
		<result property="msg_key" column="MSG_KEY"/>		
	</resultMap>
	
	
	<select id="selectHanjinItemList" parameterClass="java.util.Map" resultMap="order">
		SELECT CUSTEDICD,      SVCCATCD,       CUSTORDNO,      CNTRACTNO,
		       PICKUPASKDT,    SNDRZIP,        SNDRBASEADDR,   SNDRDTLADDR,
		       SNDRNM,         SNDRTELNO,      RCVRZIP,        RCVRBASEADDR,
		       RCVRDTLADDR,    RCVRNM,         RCVRTELNO,      RCVRMOBILENO,
		       RCVRASKCNTENT,  RCVRREFCNTENT,  PAYTYPCD,       BOXTYPCD,
		       COMODITYNM
		  FROM KEP_PARCEL_HJ
		 WHERE IF_FLAG = 'N'
	</select>
	
	<update id="updateHanjinOrder"  parameterClass="java.util.Map">
		UPDATE KEP_PARCEL_HJ 
		   SET WBLNO = #wblNo#,
		   	   IF_FLAG = #flag#,
		       IF_DATE = SYSDATE,
		       IF_MSG = #resultMessage#
		 WHERE CUSTORDNO = #custOrdNo#
		   AND IF_FLAG = 'N'	  		  
	</update>	
	
	<update id="updateHanjinOrderAllFail"  parameterClass="java.util.Map">
		UPDATE KEP_PARCEL_HJ 
		   SET IF_FLAG = 'E',
		       IF_DATE = SYSDATE
		 WHERE IF_FLAG = 'N'		  
	</update>
	
	<select id="selectHanjinCancelList" parameterClass="java.util.Map" resultMap="cancel">
		SELECT 'KORB2B' as CUSTEDICD,
			   custOrdNo as CUSTORDNO
		  FROM KEP.kep_parcel
		 WHERE IF_FLAG = 'N' 
	</select>	
	
	<update id="updateHanjinCancel"  parameterClass="java.util.Map">
		UPDATE KEP.KEP_PARCEL 
		   SET IF_FLAG = #flag#,
		       IF_DATE = SYSDATE,
		       JOB_NOTE = #resultCode# || ' / ' || #resultMessage#
		 WHERE BUYER||INV_NO = #fid#	   
		   AND PARCEL_NO = #num#			
		   AND IF_FLAG = 'N'	  	
	</update>
	
	<update id="updateHanjinCancelAllFail"  parameterClass="java.util.Map">
		UPDATE KEP.KEP_PARCEL 
		   SET IF_FLAG = 'E',
		       IF_DATE = SYSDATE
		 WHERE IF_FLAG = 'N'		  
	</update>
	
	<select id="selectHanjinPrintList" parameterClass="java.util.Map" resultMap="print">
		SELECT 'KORB2B' AS CLIENT_ID,
               '6479237' AS CSR_NUM,
               SNDRBASEADDR AS ADDRESS,
               SNDRZIP AS SND_ZIP,
               RCVRZIP AS RCV_ZIP,
               WBLNO AS MSG_KEY
          FROM KEP_PARCEL_HJ
         WHERE SVCCATCD = 'S'
           AND WBLNO IS NOT NULL
           AND IF_FLAG = 'Y'
	</select>
	
</sqlMap>    
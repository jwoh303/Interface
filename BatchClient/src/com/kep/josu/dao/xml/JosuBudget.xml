	<insert id="insertFiClose" parameterClass="java.util.HashMap">
	INSERT INTO ACT2010(
		ACT_UNIT
		,ENTRY_DT
		,SEQ
		,VDCODE
		,ACCNT_CD
		,REL_ACCNT_CD
		,REMARK
		,DEAL_AMT
		,TAX_AMT
		,EXCEPT_AMT
		,EXCEPT_TAX
		,RESOURCES_GB
		,SETTLE_GB
		,PROOF_YN
		,PROOF_GB
		,BGT_DEPT
		,DEAL_SLIP_YN
		,TAX_SLIP_YN
		,TAX_CONF_YN
		,SB_CRT_YN
	)VALUES(
		#ACT_UNIT#
		,#ENTRY_DT#
		,#SEQ#
		,#VDCODE#
		,#ACCNT_CD#
		,#REL_ACCNT_CD#
		,#REMARK#
		,#DEAL_AMT#
		,#TAX_AMT#
		,0
		,0
		,#RESOURCES_GB#
		,#SETTLE_GB#
		,#PROOF_YN#
		,#PROOF_GB#
		,#BGT_DEPT#
		,#DEAL_SLIP_YN#
		,#TAX_SLIP_YN#
		,#TAX_CONF_YN#
		,#SB_CRT_YN#
	)
	</insert>
	
	 <select id="selectSeqCnt" parameterClass="java.util.HashMap" resultClass="java.lang.Integer">
		SELECT max(SEQ)+1 AS CNT
	    FROM ACT2010
	</select>


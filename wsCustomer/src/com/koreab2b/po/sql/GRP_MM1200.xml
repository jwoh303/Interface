<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE sqlMap      
    PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
    "http://ibatis.apache.org/dtd/sql-map-2.dtd">

<sqlMap namespace="GRP_MM1200">

	<resultMap class="java.util.HashMap" id="deliveryInfoMap">
		<result property="EBELN" javaType="java.lang.String"/>
		<result property="EBELP" javaType="java.lang.String"/>
		<result property="SEQ" javaType="java.lang.String"/>
		<result property="NAME1" javaType="java.lang.String"/>
		<result property="STCD2" javaType="java.lang.String"/>
		<result property="DELIVERYDATE" javaType="java.lang.String"/>
		<result property="MENGE" javaType="java.lang.String"/>
		<result property="MEINS" javaType="java.lang.String"/>
		<result property="NAME2" javaType="java.lang.String"/>
		<result property="TELNUMBER" javaType="java.lang.String"/>
		<result property="MOBILENUMBER" javaType="java.lang.String"/>
		<result property="SMTPADDR" javaType="java.lang.String"/>
		<result property="STATUS" javaType="java.lang.String"/>
		<result property="CHAR1" javaType="java.lang.String"/>
		<result property="CHAR2" javaType="java.lang.String"/>
		<result property="CHAR3" javaType="java.lang.String"/>
		<result property="CHAR4" javaType="java.lang.String"/>
		<result property="CHAR5" javaType="java.lang.String"/>
		<result property="CHAR6" javaType="java.lang.String"/>
		<result property="CHAR7" javaType="java.lang.String"/>
		<result property="CHAR8" javaType="java.lang.String"/>
		<result property="CHAR9" javaType="java.lang.String"/>
		<result property="CHAR10" javaType="java.lang.String"/>
	</resultMap>

	<select id="selectDeliveryList" resultMap="deliveryInfoMap">
	<![CDATA[	
        SELECT
               EBELN, EBELP, SEQ,
               NAME1, STCD2, DELIVERY_DATE,
               MENGE, MEINS, NAME2,
               TEL_NUMBER, MOBILE_NUMBER, SMTP_ADDR,
               STATUS, CHAR1, CHAR2,
               CHAR3, CHAR4, CHAR5,
               CHAR6, CHAR7, CHAR8,
               CHAR9, CHAR10
          FROM EAI.IF_KOLON_DELIVERY_INFO A
         WHERE 1 = 1
           AND IF_FLAG = 'T'
           AND BUYER != 'KRKOLO0105'
	]]>
	</select>

	<update id="updateReadyData">
	<![CDATA[
		UPDATE EAI.IF_KOLON_DELIVERY_INFO
		   SET IF_FLAG = 'T'
		 WHERE IF_FLAG = 'N'
		   AND ROWNUM <= 200
	]]>
	</update>

	<update id="updateSendData" parameterClass="java.util.HashMap">
		UPDATE EAI.IF_KOLON_DELIVERY_INFO
		   SET IF_FLAG = #IF_FLAG#,
		       IF_DATM = SYSDATE
		 WHERE IF_FLAG = 'T'
	</update>

</sqlMap>
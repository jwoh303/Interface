	<update id="updateIF_KOLON_ITEMS" parameterClass="java.util.HashMap">
		UPDATE IF_KOLON_ITEMS
		   SET IF_FLAG = #NEXT_ST#
		     , IF_DATM = SYSDATE
		<isNotEmpty property="MESSAGE">
		     , IF_MSG  = #MESSAGE#
		</isNotEmpty>
		 WHERE 1 = 1
		   AND IF_FLAG = #PREV_ST#
	</update>
	
	<select id="selectIF_KOLON_ITEMS" parameterClass="java.util.HashMap" resultMap="KolonItems">
        SELECT
               INFNR        AS INFNR,
               CRUD_FLAG    AS CRUDFLAG,
               LIFNR        AS LIFNR,
               MATNR        AS MATNR,
               EKORG        AS EKORG,
               WERKS        AS WERKS,
               ESOKZ        AS ESOKZ,
               ZTERM        AS ZTERM,
               IDNLF        AS IDNLF,
               MFRNR        AS MFRNR,
               APLFZ        AS APLFZ,
               EKGRP        AS EKGRP,
               BSTAE        AS BSTAE,
               MWSKZ        AS MWSKZ,
               EXPRF        AS EXPRF,
               UEBTO        AS UEBTO,
               INCO1        AS INCO1,
               INCO2        AS INCO2,
               DATAB        AS DATAB,
               DATBI        AS DATBI,
               BANFN        AS BANFN,
               BNFPO        AS BNFPO,
               LIFNR_2_NAME AS LIFNR2NAME,
               CHAR1        AS CHAR1,
               CHAR2        AS CHAR2,
               CHAR3        AS CHAR3,
               CHAR4        AS CHAR4,
               CHAR5        AS CHAR5,
               KBETR        AS KBETR,
               KONWA        AS KONWA,
               MEINS        AS MEINS,
               KPEIN        AS KPEIN
          FROM IF_KOLON_ITEMS
         WHERE 1 = 1
           AND IF_FLAG = 'T'
	</select>

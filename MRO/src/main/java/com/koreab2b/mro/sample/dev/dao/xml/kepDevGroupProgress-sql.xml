<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="sample.dev">
	<update  id="insertKepDevGroupProgress" parameterType="java.util.Map" >
		<![CDATA[
			INSERT INTO KEPRQDT                    
            (                                    
                BUYER,                            
                QUOTATION_NO,                    
                QUOTATION_SEQ,                    
                REVISION,                        
                STATUS,                            
                RECV_FLAG,                        
                BUYER_ITEM_NO,                    
                DESCRIPTION,                    
                SPECIFICATION,                    
                UNIT_MEASURE,                    
                MAKER_NAME,                        
                ORIGIN_NAME,                    
                BTOA_DATE,                        
                BTOA_END_DATE,                    
                BTOA_END_TIME,                    
                BTOA_USER_ID,                    
                BTOA_USER_NAME,                    
                BTOA_USER_DEPT,                    
                BTOA_USER_TEL,                    
                BTOA_USER_FAX,                    
                BTOA_USER_MAIL,                    
                BUYER_TARGET_PRICE,                
                ITEM_QTY,                        
                AGENT_NAME,                        
                BTOA_REMARK,                    
                IMAGE_KEY,                        
                KEP_RECV_USER_ID,                
                ORIGIN_CODE,                    
                GW_GA_NO,                        
                KEP_DESCRIPTION,                
                KEP_SPECIFICATION,                
                KEP_UNIT_MEASURE,                
                KEP_MAKER_NAME,                    
                KEP_ORIGIN_NAME,                
                KEP_ORIGIN_CODE,
                KEP_BUYER_ITEM_NO                    
            )                                    
            VALUES                                
            (                                    
                #{st_buyer}                                    
                , #{QUOTATION_NO}                                 
                , TO_CHAR(#{QUOTATION_SEQ},'FM000000')              
                , 1                                
                , 'C'                            
                , DECODE(#{GW_NO},'','NW','NG')                                
                , NVL(#{BUYER_ITEM_NO},'NO_CODE')                                   
                , #{DESCRIPTION}                                    
                , #{SPECIFICATION}                                    
                , #{UNIT_MEASURE}                                  
                , #{MAKER_NAME}                                    
                , (NVL((SELECT TEXT2 FROM ICOMCOD1 WHERE TYPE = 'M001' AND CODE = #{ORIGIN_CODE}),' '))      
                , #{st_btoa_date}/*TO_CHAR(SYSDATE, 'YYYYMMDD')*/    
                , #{BTOA_END_DATE}                                    
                , '190000'                        
                , #{st_btoa_user_id}                                   
                , #{st_btoa_user_name}                                   
                , #{st_btoa_user_dept}                                    
                , #{st_btoa_user_tel}                                    
                , #{st_btoa_user_fax}                                   
                , #{st_btoa_user_mail}                                    
                , #{BUYER_TARGET_PRICE}                                    
                , #{ITEM_QTY}                                    
                , #{AGENT_NAME}                                   
                , #{BTOA_REMARK}                                    
                , #{IMAGE_KEY}                              
                , #{st_kep_recv_user_id}                                
                , #{ORIGIN_CODE}                              
                , #{GW_NO}                             
                , #{DESCRIPTION}                                   
                , #{SPECIFICATION}                                  
                , #{UNIT_MEASURE}                           
                , #{MAKER_NAME}                                 
                , (NVL((SELECT TEXT2 FROM ICOMCOD1 WHERE TYPE = 'M001' AND CODE = #{ORIGIN_CODE}),' '))      
                , #{ORIGIN_CODE}
                , NVL(#{BUYER_ITEM_NO},'NO_CODE')
            ) 
		]]>
	</update>
	
</mapper>

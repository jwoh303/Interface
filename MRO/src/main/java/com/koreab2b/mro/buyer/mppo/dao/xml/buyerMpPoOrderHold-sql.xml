<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="buyer.mppo">
	<select id="getBuyerPxTempSql" parameterType="java.util.Map" resultType="java.util.Map">
		<include refid="common.ibsheet.xml.jsppagestart"/>
		<![CDATA[
		
		/*getBuyerPxTempSql*/		 			 
		  
		  
           SELECT                                                                                                              
                 (ROWNUM  ) No,                                                                                             --0
                 S.REQ_DEPT,                                                                                                    --1
                 S.PR_NO,                                                                                                       --2
                 S.BUYER_ITEM_NO,                                                                                               --3
                 S.CHANGE_DATE,                                                                                                 --4
                 S.DESCRIPTION,                                                                                                 --5
                 S.SPECIFICATION,                                                                                               --6
                 S.UNIT_MEASURE,                                                                                                --7
                 S.TARGET_QTY,                                                                                                  --8
                 S.UNIT_PRICE,                                                                                                  --9
                 S.AMT,                                                                                                         --10
                 S.RD_DATE,                                                                                                     --11
                 S.AGENT_NAME,                                                                                                  --12
                 S.REF_PR_NO,                                                                                                   --13
                 S.GUYLJAE_FLAG ,                                                                                               --14
                 S.PAY_TERMS,                                                                                                   --15
                 S.PR_SEQ,                                                                                                      --16
                 S.BDGT_FLAG,                                                                                                   --17
                 S.FIXED_PRICE_FLAG,                                                                                            --18
                 S.ACCOUNT_TYPE,                                                                                                --19
                 S.REF_NO,                                                                                                      --20
                 S.REF_SEQ,                                                                                                     --21
                 S.PX_STATUS,                                                                                                   --22
                 S.RETURN_REASON,                                                                                               --23
                 S.BUYER,                                                                                                       --24
                 S.BYIT_COMORG_CODE,                                                                                            --25
                 S.CONTRACT_NO,                                                                                                 --26
                 S.CONTRACT_SEQ,                                                                                                --27
                 S.DOC_TYPE,                                                                                                    --28
                 S.AGENT_CODE,                                                                                                  --29
                 S.CHANGE_USER_DEPT,                                                                                            --30
                 S.RECV_QTY,                                                                                                    --31
                 S.RECV_FLAG  ,                                                                                                 --32
                 S.BUDGET_DEPT,                                                                                                 --33
                 S.PLAN_AMT_FLAG                                                                                                --34
				
				 ,S.REMARK,
		         (SELECT CMPY.COM_NAME_LOC FROM ICOMCMPY CMPY WHERE CMPY.COM_CODE = S.BUYER) AS BUYER_NAME_LOC,
		         (SELECT DECODE(COUNT(COMPANY),'0','N','Y') FROM ICOGPASS PASS
					WHERE PASS.COMPANY =S.BUYER
					AND PASS.DOCU_TYPE = 'PX' ) AS PASS_YN
				 , (SELECT DECODE(COUNT(COD2.CODE),0,'Y','N')
						FROM ICOMCOD2 COD2
						WHERE COD2.COMPANY_CODE = #{st_com_code}
						AND COD2.TYPE = 'EXCF'
						AND COD2.CODE = S.BUYER
						AND COD2.FLAG = 'Y'
						AND COD2.TEXT1 =  #{st_user_id} ) AS CONFIRM_YN
           FROM  (                                                                                                             
                   SELECT  ROWNUM NUM,                                                                                         
                           X.REQ_DEPT,                                                                                         
                           X.PR_NO,                                                                                            
                           X.BUYER_ITEM_NO,                                                                                    
                           X.CHANGE_DATE,                                                                                      
                           X.DESCRIPTION,                                                                                      
                           X.SPECIFICATION,                                                                                    
                           X.UNIT_MEASURE,                                                                                     
                           X.TARGET_QTY,                                                                                       
                           X.UNIT_PRICE,                                                                                       
                           X.AMT,                                                                                              
                           X.RD_DATE,                                                                                          
                           X.AGENT_NAME,                                                                                       
                           X.REF_PR_NO,                                                                                        
                           X.GUYLJAE_FLAG ,                                                                                    
                           X.PAY_TERMS,                                                                                        
                           X.PR_SEQ,                                                                                           
                           X.BDGT_FLAG,                                                                                        
                           X.FIXED_PRICE_FLAG,                                                                                 
                           X.ACCOUNT_TYPE,                                                                                     
                           X.REF_NO,                                                                                           
                           X.REF_SEQ,                                                                                          
                           X.PX_STATUS ,                                                                                       
                           X.RETURN_REASON,                                                                                    
                           X.BUYER,                                                                                            
                           X.BYIT_COMORG_CODE,                                                                                 
                           X.CONTRACT_NO,                                                                                      
                           X.CONTRACT_SEQ,                                                                                     
                           X.DOC_TYPE,                                                                                         
                           X.AGENT_CODE,                                                                                       
                           X.CHANGE_USER_DEPT,                                                                                 
                           X.RECV_QTY,                                                                                         
                           X.RECV_FLAG ,                                                                                       
                           X.BUDGET_DEPT,                                                                                      
                           X.PLAN_AMT_FLAG       
                           
                           ,X.REMARK                                                                              

                     FROM                                                                                                      
             (      SELECT                                                                                                     
                           (SELECT TEXT1 FROM ICOMCOD2                                                                         
                                                       WHERE TYPE = 'C001'                                                     
                                                         AND COMPANY_CODE = A.BUYER                                            
                                                         AND CODE = A.CHANGE_USER_DEPT ) AS REQ_DEPT,                          --1
                           A.PR_NO,                                                                                            --2
                           A.BUYER_ITEM_NO BUYER_ITEM_NO,                                                                      --3
                           A.CHANGE_DATE CHANGE_DATE,                                                                          --4
                           A.DESCRIPTION DESCRIPTION,                                                                          --5
                           A.SPECIFICATION SPECIFICATION,                                                                      --6
                           A.UNIT_MEASURE UNIT_MEASURE,                                                                        --7
                           NVL(A.TARGET_QTY,0) TARGET_QTY,                                                                     --8
                           NVL(E.UNIT_PRICE,0) UNIT_PRICE,                                                                     --9
                           NVL(A.RECV_QTY,0) * NVL(E.UNIT_PRICE,0) AMT,                                                        --10
                           A.RD_DATE RD_DATE,                                                                                  --11
                           DECODE((SELECT AGENT_OPEN_FLAG FROM ICOMCMPY WHERE COM_CODE = A.BUYER),                             
                                       'N', '코리아이플랫폼(주)',                                                              
                                            (SELECT DECODE(AGENT_OPEN_FLAG,'N','코리아이플랫폼(주)',COM_NAME_LOC)              
                                               FROM ICOMCMPY                                                                   
                                              WHERE COM_CODE =E.AGENT))  AS AGENT_NAME,                                        --12
                           A.REF_PR_NO REF_PR_NO,                                                                              --13
                           DECODE(B.COM_CODE,NULL,'N','Y') GUYLJAE_FLAG,                                                       --14
                           E.PAY_TERMS PAY_TERMS,                                                                              --15
                           A.PR_SEQ,                                                                                           --16
                           (SELECT Z.FLAG FROM ICOMCOD2 Z                                                                      
                                 WHERE Z.TYPE = 'Z014'                                                                         
                                   AND Z.COMPANY_CODE = A.BUYER                                                                
                                   AND Z.CODE = C.ACCOUNT_TYPE) BDGT_FLAG,                                                     --17
                           C.FIXED_PRICE_FLAG FIXED_PRICE_FLAG,                                                                --18
                           DECODE(A.BUDGET_DEPT,NULL,C.ACCOUNT_TYPE,A.ACCOUNT_TYPE) ACCOUNT_TYPE,                              --19
                           A.REF_NO REF_NO,                                                                                    --20
                           A.REF_SEQ REF_SEQ,                                                                                  --21
                           DECODE(A.RECV_FLAG,'PR','결재반려','PT','발주보류') PX_STATUS,                                      --22
                           A.RETURN_REASON,                                                                                    --23

                           A.BUYER BUYER,                                                                                      --24
                           A.BYIT_COMORG_CODE BYIT_COMORG_CODE,                                                                --25
                           A.CONTRACT_NO CONTRACT_NO,                                                                          --26
                           A.CONTRACT_SEQ CONTRACT_SEQ,                                                                        --27
                           F.DOC_TYPE,                                                                                         --28

                           DECODE((SELECT AGENT_OPEN_FLAG FROM ICOMCMPY WHERE COM_CODE = A.BUYER),                             
                                       'N', 'KRKORE0001',                                                                      
                                            (SELECT DECODE(AGENT_OPEN_FLAG,'N','KRKORE0001',COM_CODE)                          
                                               FROM ICOMCMPY                                                                   
                                              WHERE COM_CODE =E.AGENT))  AS AGENT_CODE,                                        --29
                           A.CHANGE_USER_DEPT,                                                                                 --30
                           DECODE(NVL(A.RECV_QTY,0),0,A.TARGET_QTY,A.RECV_QTY) AS RECV_QTY,                                    --31
                           A.RECV_FLAG,                                                                                        --32
                           A.BUDGET_DEPT,                                                                                      --33
                           A.PLAN_AMT_FLAG                                                                                     --34

							,F.REMARK          

                   FROM  ICOMPRDT A , ICOMTRGW B, ICOMBYIT C, ICOMCQDT E   , ICOMPRHD F                                        
                   WHERE  A.SAVE_FLAG        = 'PX'                                                                          
  ]]> 
		<choose>
			<when test='st_group_mng_flag == "Y"'>
				<choose>
					<when test="st_group_info != null and st_group_info != '' ">
					<![CDATA[
						AND	A.BUYER IN (SELECT COD3.CODE2 FROM ICOMCOD3 COD3 WHERE COD3.TYPE = 'BGCM' AND COD3.CODE1 = #{st_user_id} AND COD3.TEXT1 = #{st_group_info}  AND 	COD3.FLAG = 'Y')
					]]>
					</when>
					<otherwise>
						<choose>
							<when test="st_com_code2 != null and st_com_code2 != '' ">
							<![CDATA[
								AND A.BUYER = #{st_com_code2}    
							]]>
							</when>
							<otherwise>
							<![CDATA[
								AND	A.BUYER IN (SELECT COD3.CODE2 FROM ICOMCOD3 COD3 WHERE COD3.TYPE = 'TGCM' AND COD3.CODE1 = #{st_user_id} AND COD3.FLAG = 'Y')
							]]>
							</otherwise>
						</choose>
					</otherwise>
				</choose>
			</when>
			<when test='st_group_mng_flag == "N"'>
				<![CDATA[
					AND A.BUYER            =  #{st_buyer}       
				]]>
		</when>
		</choose> 
	   <choose>
	    <when test="st_sourcing_status == 'ALL' "> 
	    		   AND  A.RECV_FLAG        IN ( 'PR' , 'PT')                  
	    </when> 
	    <otherwise>
		     <if test="st_sourcing_status != null and st_sourcing_status != ''"> 
		    		   AND  A.RECV_FLAG        =  #{st_sourcing_status}
		    </if>		        
	    </otherwise>
	    </choose>  

		 <if test="st_user_dept != null and st_user_dept != ''"> 
                            AND  A.PURCHASER_DEPT   =  #{st_user_dept}
          </if>		        
		 <if test="st_req_dept_code != null and st_req_dept_code != ''"> 
                          AND  A.CHANGE_USER_DEPT =  #{st_req_dept_code}
          </if>	
		 <if test="st_pr_no != null and st_pr_no != ''"> 
                         AND  A.PR_NO            =  #{st_pr_no}
          </if>		                                                                	     
		 <if test="st_ref_no != null and st_ref_no != ''"> 
                        AND  A.REF_PR_NO        = #{st_ref_no}    
          </if>		                                                                                                                 
 
                                  
<![CDATA[                                                                                   
                    AND  A.BUYER            = F.BUYER                                                                          
                    AND  A.PR_NO            = F.PR_NO                                                                          
                    AND  A.BUYER            = B.COM_CODE(+)                                                                    
                    AND  A.PR_NO            = B.KEY_1(+)                                                                       
                    AND  A.BYIT_COMORG_CODE = C.BUYER                                                                          
                    AND  A.BUYER_ITEM_NO    = C.BUYER_ITEM_NO                                                                  
                    AND  A.BYIT_COMORG_CODE = E.BUYER                                                                          
                    AND  A.BUYER_ITEM_NO    = E.BUYER_ITEM_NO                                                                  
                    AND  A.CONTRACT_NO      = E.CONTRACT_NO                                                                    
                    AND  A.CONTRACT_SEQ     = E.CONTRACT_SEQ                                                                   
                    AND  E.BUYER_ITEM_NO    = C.BUYER_ITEM_NO                                                                  
                    AND  E.BUYER            = C.BUYER                                                                          
                    AND  A.STATUS          <> 'D'                                                                              
                    AND  E.STATUS          <> 'D'                                                                              
                    AND  F.STATUS          <> 'D'                                                                              
                    AND  C.STATUS          <> 'D'                                                                              

                    AND  A.CHANGE_DATE      BETWEEN  #{st_from_date}       AND #{st_to_date}                                            

                   ORDER BY A.PR_NO DESC , A.PR_SEQ                                                                            
                                                                           ) X )S                                              
        
        
        
		     ]]> 
		<include refid="common.ibsheet.xml.jsppageend"/>	
	</select> 
	 
</mapper>

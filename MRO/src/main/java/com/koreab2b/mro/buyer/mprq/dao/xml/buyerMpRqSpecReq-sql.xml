<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="buyer.mp.rq">
 
 
 	<select id="selectRaNo" parameterType="java.util.Map" resultType="Integer">
		<![CDATA[
				SELECT 
					MAX(SUBSTR(RAV_NO,9,3)) 
				FROM TBL_RFQ_ATTRI_VERIFY 
				WHERE BUYER = #{comCode}
				AND RAV_NO LIKE   #{today} || '%'	 
		]]>
	</select> 
 
	
 <!-- 규격의뢰 -->
	<update id="insertBuyerMpRqSpecReq" parameterType="map">
		<![CDATA[
				  INSERT INTO TBL_RFQ_ATTRI_VERIFY (								
				  	BUYER																				
				  	,RAV_NO																			
				  	,RAV_SEQ																			
				  	,STATUS						   
				  	,RFQ_USER_ID						   
				  	,REQ_DATE						   
				  	,REQ_TIME						   
				  	,BUYER_ITEM_NO						   
				  	,ITEM_STATUS						   
				  	,DESCRIPTION						   
				  	,SPECIFICATION						   
				  	,UNIT_MEASURE						   
				  	,MAKER_NAME						   
				  	,KEP_USER_ID						   
				  	,FEEDBACK_FLAG						   
				  	,FEEDBACK_DATE						   
				  	,FEEDBACK_TIME						   
				  	,BUYER_REMARK						   
				  	,KEP_REMARK						   
				  	,IMAGE_KEY							   
				  ) VALUES (						   
				  	#{comCode}	
				  	,TO_CHAR(SYSDATE,'YYYYMMDD')||TO_CHAR(SYSDATE,'HH24MISS')||TO_CHAR(#{rav_no} ,'FM000000')
				  	,1
				  	,'C'
				  	,#{userId}
				  	,TO_CHAR(SYSDATE,'YYYYMMDD') 
				  	,TO_CHAR(SYSDATE,'HH24MISS')
				  	,#{st_item_no} 
				  	,'S'
				  	,#{st_description}  
				  	,#{st_specification}
				  	,#{st_unit}
				  	,#{st_maker} 
				  	,''
				  	,'N'
				  	,'' 
				  	,''
				  	,#{st_remark}
				  	,'' 
				  	,NVL(#{st_image_key},'') 
				  )									   
		]]>
	</update>
	<!-- /*,TO_CHAR(SYSDATE,'YYYYMMDD')||TO_CHAR(#{rav_no} ,'FM000') 성능테스트때문에 임시 수정*/ -->
	
	
</mapper>

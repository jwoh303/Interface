<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="buyer.mppo">
	<select id="getBuyerPrRejectSql" parameterType="java.util.Map" resultType="java.util.Map">
		<include refid="common.ibsheet.xml.jsppagestart"/>
		<![CDATA[
		
		/*getBuyerPrRejectSql*/
		
     SELECT                                                                  
                 (ROWNUM  ) No,                                                -- 0
                 S.REQ_DEPT,                                                       -- 1
                 S.PR_NO,                                                          -- 2
                 S.BUYER_ITEM_NO,                                                  -- 3
                 S.CHANGE_DATE,                                                    -- 4
                 S.DESCRIPTION,                                                    -- 5
                 S.SPECIFICATION,                                                  -- 6
                 S.UNIT_MEASURE,                                                   -- 7
                 S.TARGET_QTY,                                                     -- 8
                 S.UNIT_PRICE,                                                     -- 9
                 S.AMT,                                                            -- 10
                 S.RD_DATE,                                                        -- 11
                 S.AGENT_NAME,                                                     -- 12
                 S.REF_PR_NO,                                                      -- 13
                 S.GUYLJAE_FLAG ,                                                  -- 14
                 S.PAY_TERMS,                                                      -- 15
                 S.PR_SEQ,                                                         -- 16
                 S.BDGT_FLAG,                                                      -- 17
                 S.FIXED_PRICE_FLAG,                                               -- 18
                 S.ACCOUNT_TYPE,                                                   -- 19
                 S.BUYER,                                                          -- 20
                 S.BYIT_COMORG_CODE,                                               -- 21
                 S.CONTRACT_NO,                                                    -- 22
                 S.CONTRACT_SEQ,                                                   -- 23
                 S.RETURN_REASON_IMG,                                              -- 24
                 S.RETURN_REASON,                                                  -- 25
                 S.AGENT_CODE,														-- 26
                 S.CHANGE_USER_DEPT,                                                -- 27
                 S.RECV_FLAG,
				 S.REQ_USER_NM,
				  (SELECT CMPY.COM_NAME_LOC FROM ICOMCMPY CMPY WHERE CMPY.COM_CODE = S.BUYER) AS BUYER_NAME_LOC
           FROM  (                                                                 
                   SELECT  ROWNUM NUM,                                             
                           X.REQ_DEPT,                                             
                           X.PR_NO,                                                
                           X.BUYER_ITEM_NO,                                        
                           X.CHANGE_DATE,                                          
                           X.DESCRIPTION,                                          
                           X.SPECIFICATION,                                        
                           X.UNIT_MEASURE,                                         
                           X.TARGET_QTY,                                           
                           X.UNIT_PRICE,                                           
                           X.AMT,                                                  
                           X.RD_DATE,                                              
                           X.AGENT_NAME,                                           
                           X.REF_PR_NO,                                            
                           X.GUYLJAE_FLAG ,                                        
                           X.PAY_TERMS,                                            
                           X.PR_SEQ,                                               
                           X.BDGT_FLAG,                                            
                           X.FIXED_PRICE_FLAG,                                     
                           X.ACCOUNT_TYPE,                                         
                           X.BUYER,                                                
                           X.BYIT_COMORG_CODE,                                     
                           X.CONTRACT_NO,                                          
                           X.CONTRACT_SEQ,											
                           X.RETURN_REASON_IMG,                                    
                           X.RETURN_REASON,                                        
                           X.AGENT_CODE,											
                           X.CHANGE_USER_DEPT,   
						   X.RECV_FLAG,
						   X.REQ_USER_NM                                  
                     FROM                                                          
             (      SELECT                                                                                                     
                           (SELECT TEXT1 FROM ICOMCOD2                                                                         
                                                       WHERE TYPE = 'C001'                                                     
                                                         AND COMPANY_CODE = A.BUYER                                            
                                                         AND CODE = A.CHANGE_USER_DEPT ) AS REQ_DEPT,                          --1
                           A.PR_NO,                                                                                            --2
                           A.BUYER_ITEM_NO BUYER_ITEM_NO,                                                                      --3
                           A.CHANGE_DATE CHANGE_DATE,                                                                          --4
                           A.DESCRIPTION DESCRIPTION,                                                                          --5
                           A.SPECIFICATION SPECIFICATION,                                                                      --6
                           A.UNIT_MEASURE UNIT_MEASURE,                                                                        --7
                           NVL(A.TARGET_QTY,0) TARGET_QTY,                                                                     --8
                           NVL(E.UNIT_PRICE,0) UNIT_PRICE,                                                                     --9
                           NVL(A.TARGET_QTY,0) * NVL(E.UNIT_PRICE,0) AMT,                                                      --10
                           A.RD_DATE RD_DATE,                                                                                  --11
                           DECODE((SELECT AGENT_OPEN_FLAG FROM ICOMCMPY WHERE COM_CODE = A.BUYER),                             
                                       'N', '코리아이플랫폼(주)',                                                              
                                            (SELECT DECODE(AGENT_OPEN_FLAG,'N','코리아이플랫폼(주)',COM_NAME_LOC)              
                                               FROM ICOMCMPY                                                                   
                                              WHERE COM_CODE =E.AGENT))  AS AGENT_NAME,                                        --12
                           A.REF_PR_NO REF_PR_NO,                                                                              --13
                           DECODE(B.COM_CODE,NULL,'N','Y') GUYLJAE_FLAG,                                                       --14
                           E.PAY_TERMS PAY_TERMS,                                                                              --15
                           A.PR_SEQ,                                                                                           --16
                           (SELECT Z.FLAG FROM ICOMCOD2 Z                                                                      
                                 WHERE Z.TYPE = 'Z014'                                                                         
                                   AND Z.COMPANY_CODE = A.BUYER                                                                
                                   AND Z.CODE = C.ACCOUNT_TYPE) BDGT_FLAG,                                                     --17
                           C.FIXED_PRICE_FLAG FIXED_PRICE_FLAG,                                                                --18
                           C.ACCOUNT_TYPE ACCOUNT_TYPE,                                                                        --19

                           A.BUYER BUYER,                                                                                      --20
                           A.BYIT_COMORG_CODE BYIT_COMORG_CODE,                                                                --21
                           A.CONTRACT_NO CONTRACT_NO,                                                                          --22
                           A.CONTRACT_SEQ CONTRACT_SEQ,                                                                        --23
                           DECODE(NVL(TRIM(A.RETURN_REASON),''),'','/resources/images/icon2.gif','/resources/images/icon.gif') RETURN_REASON_IMG,  --24                            
                           DECODE(NVL(TRIM(A.RETURN_REASON),''),'','ALL',TRIM(A.RETURN_REASON)) RETURN_REASON, --25

                           DECODE((SELECT AGENT_OPEN_FLAG FROM ICOMCMPY WHERE COM_CODE = A.BUYER),                             
                                       'N', 'KRKORE0001',                                                              
                                            (SELECT DECODE(AGENT_OPEN_FLAG,'N','KRKORE0001',COM_CODE)              
                                               FROM ICOMCMPY                                                                   
                                              WHERE COM_CODE =E.AGENT))  AS AGENT_CODE,                                            --26
                           A.CHANGE_USER_DEPT CHANGE_USER_DEPT                                                                     --27
                           
                           ,A.RECV_FLAG
						   ,(SELECT USR.USER_NAME_LOC FROM ICOMLUSR USR WHERE USR.USER_ID = A.REQ_USER_ID) REQ_USER_NM
                   FROM  ICOMPRDT A , ICOMTRGW B, ICOMBYIT C, ICOMCQDT E                                                       
                   WHERE   A.RECV_FLAG        = 'RR'                                                                             
 		]]>  
		<choose>
			<when test='st_group_mng_flag == "Y"'>
				<choose>
					<when test="st_group_info != null and st_group_info != '' ">
					<![CDATA[
						AND	A.BUYER IN (SELECT COD3.CODE2 FROM ICOMCOD3 COD3 WHERE COD3.TYPE = 'BGCM' AND COD3.CODE1 = #{st_user_id} AND COD3.TEXT1 = #{st_group_info}  AND 	COD3.FLAG = 'Y')
					]]>
					</when>
					<otherwise>
						<choose>
							<when test="st_com_code2 != null and st_com_code2 != '' ">
							<![CDATA[
								AND A.BUYER = #{st_com_code2}    
							]]>
							</when>
							<otherwise>
							<![CDATA[
								AND	A.BUYER IN (SELECT COD3.CODE2 FROM ICOMCOD3 COD3 WHERE COD3.TYPE = 'TGCM' AND COD3.CODE1 = #{st_user_id} AND COD3.FLAG = 'Y')
							]]>
							</otherwise>
						</choose>
					</otherwise>
				</choose>
			</when>
			<when test='st_group_mng_flag == "N"'>
				<![CDATA[
					AND A.BUYER            =  #{st_buyer}       
				]]>
		</when>
		</choose> 
		 <if test="st_UserDept != null and st_UserDept != ''">
			<![CDATA[
	 			AND  A.PURCHASER_DEPT   = #{st_UserDept}                 
	 		]]>	 
		</if>
		 <if test="st_req_dept_code != null and st_req_dept_code != ''">
			<![CDATA[
	 			AND  A.CHANGE_USER_DEPT =#{st_req_dept_code}                               
	 		]]>	 
		</if>
		 <if test="st_pr_no != null and st_pr_no != ''">
			<![CDATA[
	 			AND A.PR_NO            = #{st_pr_no}                 
	 		]]>	 
		</if>
		 <if test="st_ref_no != null and st_ref_no != ''">
			<![CDATA[
	 			AND A.REF_PR_NO        =#{st_ref_no}                            
	 		]]>	 
		</if>
		 <if test="st_po_user_id != null and st_po_user_id != ''">
			<![CDATA[
	 			AND A.REQ_USER_ID        =#{st_po_user_id}                            
	 		]]>	 
		</if>						                                                    
          		<![CDATA[         
                                                                                   
                    AND  A.ADD_DATE BETWEEN #{st_from_date}    AND #{st_to_date}                                                                 
                    AND  A.BUYER            = B.COM_CODE(+)                                                                    
                    AND  A.PR_NO            = B.KEY_1(+)                                                                       
                    AND  A.BYIT_COMORG_CODE = C.BUYER                                                                          
                    AND  A.BUYER_ITEM_NO    = C.BUYER_ITEM_NO                                                                  
                    AND  A.BYIT_COMORG_CODE = E.BUYER                                                                          
                    AND  A.BUYER_ITEM_NO    = E.BUYER_ITEM_NO                                                                  
                    AND  A.CONTRACT_NO      = E.CONTRACT_NO                                                                    
                    AND  A.CONTRACT_SEQ     = E.CONTRACT_SEQ                                                                   
                    AND  E.BUYER_ITEM_NO    = C.BUYER_ITEM_NO                                                                  
                    AND  E.BUYER            = C.BUYER                                                                          
                    AND  A.STATUS          != 'D'                                                                              
                    AND  E.STATUS          <> 'D'                                                                              
                   ORDER BY A.PR_NO DESC , A.PR_SEQ                                                                            
                                                                           ) X )S                                              
 		]]>  
 
		
		<include refid="common.ibsheet.xml.jsppageend"/>	
	</select> 
	
 
</mapper>

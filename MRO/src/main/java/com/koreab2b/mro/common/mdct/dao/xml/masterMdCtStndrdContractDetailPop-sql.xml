<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="common.mdct">
	
	<resultMap  id="ConstractMap" type="java.util.HashMap">     
		<result	javaType="java.lang.String"	column="FORM_NAME"		property="FORM_NAME" />
		<result	javaType="java.lang.String"	column="BIZ_TYPE"				property="BIZ_TYPE" />     
		<result	javaType="java.lang.String"	column="COMPANY_TYPE"	property="COMPANY_TYPE" />     
		<result	javaType="java.lang.String"	column="DESCRIPTION"		property="DESCRIPTION" />
		<result	javaType="java.lang.String"	column="FORM_TYPE"			property="FORM_TYPE" />
		<result	javaType="java.lang.String"	column="WRITER_ID"			property="WRITER_ID" />
		<result	javaType="java.lang.String"	column="WRITER_NAME"		property="WRITER_NAME" />
		<result	javaType="java.lang.String"	column="WRITE_DATE"			property="WRITE_DATE" />
		<result	javaType="java.lang.String"	column="FORM_CONTENT"	property="FORM_CONTENT"	jdbcType="CLOB"	typeHandler="org.apache.ibatis.type.ClobTypeHandler" />  
	</resultMap >  

	<select id="selectMasterMdCtStndrdContractDetailPopList" parameterType="java.util.Map" resultMap="ConstractMap">
		<![CDATA[
			/*selectMasterMdCtStndrdContractDetailPopList*/
			SELECT
				FORM_NAME
				,(SELECT TEXT1 FROM ICOMCOD1 WHERE TYPE = 'C006' AND CODE = BIZ_TYPE AND ROWNUM = 1) AS BIZ_TYPE
				,(SELECT TEXT1 FROM ICOMCOD1 WHERE TYPE = 'C007' AND CODE = COMPANY_TYPE AND ROWNUM = 1) AS COMPANY_TYPE
				,DESCRIPTION
				,(SELECT TEXT1 FROM ICOMCOD1 WHERE TYPE = 'C005' AND CODE = FORM_TYPE AND ROWNUM = 1) AS FORM_TYPE
				,FORM_CONTENT
				,WRITER_NAME
				,DECODE(LENGTH(WRITE_DATE), 8, SUBSTR(WRITE_DATE, 1, 4)||'/'||SUBSTR(WRITE_DATE, 5, 2)||'/'||SUBSTR(WRITE_DATE, 7, 2), WRITE_DATE) AS WRITE_DATE
				,WRITER_ID
			FROM ICOMECCF
			WHERE FORM_NO = #{st_form_no}
		]]>	
	</select>
	
	<update id="deleteMasterMdCtStndrdContractDetailPop" parameterType="java.util.Map">
		<![CDATA[
			DELETE FROM ICOMECCF 	WHERE FORM_NO	= #{st_form_no}
		]]>
	</update>
								
</mapper>

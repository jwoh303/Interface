<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="common.wmst">
	<resultMap  id="WmsNoticeMap" type="java.util.HashMap">     
		<result	javaType="java.lang.String" column="BID"						property="BID" />
		<result	javaType="java.lang.String" column="BTYPE"					property="BTYPE" />
		<result	javaType="java.lang.String" column="COMPANY"				property="COMPANY" />
		<result	javaType="java.lang.String" column="COM_NAME"			property="COM_NAME" />
		<result	javaType="java.lang.String" column="ACL_DIS"					property="ACL_DIS" />
		<result	javaType="java.lang.String" column="SUBJECT"					property="SUBJECT" />
		<result	javaType="java.lang.String" column="REG_USER_ID"			property="REG_USER_ID" />
		<result	javaType="java.lang.String" column="REG_USER_NAME"		property="REG_USER_NAME" />
		<result	javaType="java.lang.String" column="REG_DATE"				property="REG_DATE" />
		<result	javaType="java.lang.String" column="FROM_DATE"			property="FROM_DATE" />
		<result	javaType="java.lang.String" column="TO_DATE"				property="TO_DATE" />
		<result	javaType="java.lang.String" column="LCOUNT"					property="LCOUNT" />
		<result	javaType="java.lang.String" column="IMAGE_KEY"				property="IMAGE_KEY" />
		<result	javaType="java.lang.String" column="OPEN_FLAG"				property="OPEN_FLAG" />
		<result	javaType="java.lang.String" column="CONTEXT"				property="CONTEXT"   jdbcType="CLOB" typeHandler="org.apache.ibatis.type.ClobTypeHandler" />
	</resultMap >
	
	<!-- 조회 -->
	<select id="selectMasterWmstNoticeDetailPop" parameterType="java.util.Map" resultMap="WmsNoticeMap">
		/*selectMasterWmstNoticeDetailPop*/
		<![CDATA[
			SELECT
			    BID,
			    BTYPE,
			    COMPANY,
			    DECODE(COMPANY, 'KRKORE0001', '전체', (SELECT COM_NAME_LOC FROM ICOMCMPY WHERE COM_CODE = COMPANY)) AS COM_NAME,
			    DECODE(ACL,'INC','자사', 'BUY','구매사', 'SEL', '판매사', 'KEP','KEP','MEB','회원전체','CST','특정회사','UST','특정사용자','ALL','전체') ACL_DIS,
			    SUBJECT,
			    CONTEXT,
			    REG_USER_ID,
			    REG_USER_NAME,
			    REG_DATE,
			    TO_DATE,
			    FROM_DATE,
			    LCOUNT,
			    IMAGE_KEY,
			    OPEN_FLAG
			FROM ICOMBOARD
			WHERE STATUS <>'D'
			AND FROM_DATE <= TO_CHAR(SYSDATE, 'YYYYMMDD')
			AND TO_DATE >= TO_CHAR(SYSDATE, 'YYYYMMDD')
			AND BTYPE = 'WM'
			AND OPEN_FLAG = 'Y'
			AND BID = #{st_bid}
			ORDER BY REG_DATE DESC , VID DESC
 		]]>  
	</select>
	
	<select id="getMasterWmstNoticeDetailPopRegUserCheck" parameterType="java.util.Map" resultType="String">
		<![CDATA[
			SELECT COUNT(REG_USER_ID) CNT FROM ICOMBOARD 	WHERE BID = #{st_bid} AND BTYPE 	= #{st_btype} AND REG_USER_ID = #{st_user_id}
		]]>
	</select>
	
	<update id="deleteMasterWmstNoticeDetailPop" parameterType="java.util.Map">
		<![CDATA[
			DELETE FROM ICOMBOARD
			WHERE BID				= #{st_bid}
			AND BTYPE				= #{st_btype}
		]]>
	</update>
	
</mapper>

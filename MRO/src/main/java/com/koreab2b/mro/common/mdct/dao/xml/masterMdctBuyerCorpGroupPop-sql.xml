<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="common.mdct">

	<select id="selectMasterMdctBuyerCorpGroupPopList" parameterType="java.util.Map" resultType="java.util.Map">
		<![CDATA[
		/* selectMasterMdctBuyerCorpGroupPopList*/
		SELECT										        
			GROUP_CODE,
			GROUP_NAME,
			CORP_CODE,
			CORP_NAME
		FROM BNTBUYERGROUP 							 
		WHERE GROUP_FLAG = 'B'
		]]>
		<if test="st_group_code != null and st_group_code != ''">
		<![CDATA[
		AND GROUP_CODE = #{st_group_code}
		]]>
		</if>
		<if test="st_corp_name != null and st_corp_name != ''">
		<![CDATA[
		AND CORP_NAME LIKE '%'||#{st_corp_name}||'%' 
		]]>
		</if>
	</select>
</mapper>

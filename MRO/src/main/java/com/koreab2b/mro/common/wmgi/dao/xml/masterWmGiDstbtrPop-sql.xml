<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="common.wmgi">

	<update  id="updateMasterWmGiDstbtrWMSSTCK3" parameterType="java.util.Map" >
		<![CDATA[
			UPDATE WMSSTCK SET  
				AVAIL_QTY = NVL(AVAIL_QTY,0)-(#{IVK_QTY}),
				ALLOC_QTY = NVL(ALLOC_QTY,0)+(#{IVK_QTY}), 
				CHANGE_DATE = TO_CHAR(SYSDATE,'YYYYMMDD'),
				CHANGE_USER = #{st_user_id}  
			WHERE WAREHOUSE_CODE =  #{st_warehouse_code}      
				 AND STDCATLG_ID    = #{STDCATLG_ID}   
			  AND AGENT    = DECODE(#{PROCESS_TYPE},'1','KRKORE0001',(SELECT WAREHOUSE_CODE FROM ICOMPODT WHERE BUYER = #{BUYER}  AND PO_NO =  #{PO_NO}  AND PO_SEQ =#{PO_SEQ} )) 		
					]]>
	</update>



	<update  id="updateMasterWmGiDstbtrWMSSTCK2" parameterType="java.util.Map" >
		<![CDATA[
		
		UPDATE WMSSTCK SET                                                                                                                                                                               
					  AVAIL_QTY = NVL(AVAIL_QTY,0)-(#{IVK_QTY}) ,                                                                                                                                                      
					  ALLOC_QTY = NVL(ALLOC_QTY,0)+(#{IVK_QTY}) ,                                                                                                                                                      
					  STC_SELLER_PRICE = DECODE(NVL(AVAIL_QTY- (#{IVK_QTY}) ,0),0,0,STC_SELLER_PRICE),                                                                                                                  
	CHANGE_DATE = TO_CHAR(SYSDATE,'YYYYMMDD'),                                                                                                                                                     
	CHANGE_USER =#{st_user_id}                                                                                                                                                       
WHERE WAREHOUSE_CODE =  #{st_warehouse_code}                                                                                                                                                                      
	 AND STDCATLG_ID    = #{STDCATLG_ID}                                                                                                                                                                       
  AND AGENT    = DECODE(#{PROCESS_TYPE},'1','KRKORE0001',(SELECT WAREHOUSE_CODE FROM ICOMPODT WHERE BUYER = #{BUYER}     AND PO_NO =  #{PO_NO}  AND PO_SEQ = #{PO_SEQ}  ))                                                                   
		
		
					]]>
	</update>



	<update  id="updateMasterWmGiDstbtrICOMIVDT" parameterType="java.util.Map" >
		<![CDATA[
				UPDATE ICOMIVDT                                  
   				      SET WMS_IVK_QTY   = NVL(WMS_IVK_QTY,0) + #{IVK_QTY} 
                  WHERE BUYER   = #{BUYER}                                  
                     AND INV_NO   = #{GR_NO}                              
                     AND INV_SEQ  = #{INV_SEQ}                              
   AND STATUS != 'D'                             
                
			]]>
	</update>
	
	<update  id="updateMasterWmGiDstbtrICOMPODT" parameterType="java.util.Map" >
		<![CDATA[
   			UPDATE ICOMPODT                                 
     			  SET IV_QTY   = NVL(IV_QTY,0) + #{IVK_QTY}             
              WHERE BUYER   =#{BUYER}                              
                  AND PO_NO   = #{PO_NO}                              
                  AND PO_SEQ  = #{PO_SEQ}                              
                  AND STATUS != 'D'                            
			]]>
	</update>

	<update  id="insertMasterWmGiDstbtrWMSIVDT" parameterType="java.util.Map" >
		<![CDATA[
		/*insertMasterWmGiDstbtrWMSIVDT*/
           INSERT INTO WMSIVDT (                                                                      
                                            WAREHOUSE_CODE,                                                                         
                                            SELLER,                                                                                 
                                            INV_NO,                                                                                 
                                            INV_SEQ,                                                                                
                                            BUYER,                                                                                  
                                            STATUS,                                                                                 
                                            SEND_DATE,                                                                              
                                            SEND_TIME,                                                                              
                                            ADD_DATE,                                                                               
                                            ADD_TIME,                                                                               
                                            CHANGE_DATE,                                                                            
                                            CHANGE_TIME,                                                                            
                                            CONFIRM_DATE,                                                                           
                                            CONFIRM_TIME,                                                                           
                                            BUYER_ITEM_NO,                                                                          
                                            SELLER_ITEM_NO,                                                                         
                                            STDCATLG_ID,                                                                            
                                            DESCRIPTION,                                                                            
                                            SPECIFICATION,                                                                          
                                            UNIT_MEASURE,                                                                           
                                            PROCESS_TYPE,                                                                           
                                            PO_QTY,                                                                                 
                                            GR_QTY,                                                                                 
                                            INV_QTY,                                                                                
                                            UNIT_PRICE,                                                                             
                                            LIST_PRICE,                                                                             
                                            UNIT_AMT,                                                                               
                                            LIST_AMT,                                                                               
                                            ORIGIN_CODE,                                                                            
                                            MAKER_NAME,                                                                             
                                            AGENT,                                                                                  
                                            PO_NO,                                                                                  
                                            PO_SEQ,                                                                                 
                                            S_INV_NO,                                                                               
                                            S_INV_SEQ,                                                                              
                                            REF_PR_NO,                                                                              
                                            PR_NO,                                                                                  
                                            PR_SEQ,                                                                                 
                                            LEGACY_PO_NO,                                                                           
                                            LEGACY_PO_SEQ,                                                                          
                                            DELY_TO_LOCATION,                                                                       
                                            PO_DATE,                                                                                
                                            GR_DATE,                                                                                
                                            INV_DATE,                                                                               
                                            DELIVERY_QTY,                                                                           
                                            DELIVERY_DATE,                                                                          
                                            ADD_USER_ID,                                                                            
                                            CHANGE_USER_ID,                                                                         
                                            DELIVERY_USER_ID,                                                                       
                                            LEGACY_IV_SERIAL,                                                                       
                                            DELIVERY_COMPANY,                                                                       
                                            DELIVERY_NO,                                                                            
                                     		CMS_CATLG_ID,            
                                     		                                           SCHEDULED_DATE,
        			  CAR_ID,
        			  CAR_NO,
        			  CAR_PERSON_NAME,
        			  CAR_PERSON_TEL,
        			  BOX_QTY ,        			                                                                
                                            DELIVERY_PERSON,
                                            TAG_NO
                                       
				                             )  (   
        SELECT                                                                      
               #{st_warehouse_code} AS WAREHOUSE_CODE,                                                                                   
               IVDT.SELLER AS SELLER,                                                                      
               #{INVK_NO} AS INV_NO,                                                                                         
                                             (SELECT TO_CHAR(NVL(TO_NUMBER(MAX(WD.INV_SEQ)),0)+1,'FM000000') FROM WMSIVDT WD
												WHERE   WD.WAREHOUSE_CODE = #{st_warehouse_code}
												AND WD.INV_NO =  #{INVK_NO}
												                                             )AS INV_SEQ,                                                                   
               IVDT.BUYER AS BUYER,                                                                      
               'C' AS STATUS,                                                                      
               '' AS SEND_DATE,                                                                      
               '' AS SEND_TIME,                                                                      
               TO_CHAR(SYSDATE,'YYYYMMDD') AS ADD_DATE,                                                                      
               TO_CHAR(SYSDATE,'HH24MISS') AS ADD_TIME,                                                                      
               TO_CHAR(SYSDATE,'YYYYMMDD') AS CHANGE_DATE,                                                                      
               TO_CHAR(SYSDATE,'HH24MISS') AS CHANGE_TIME,                                                                      
               TO_CHAR(SYSDATE,'YYYYMMDD') AS CONFIRM_DATE,                                                                      
               TO_CHAR(SYSDATE,'HH24MISS') AS CONFIRM_TIME,                                                                      
               IVDT.BUYER_ITEM_NO AS BUYER_ITEM_NO,                                                                      
               IVDT.SELLER_ITEM_NO AS SELLER_ITEM_NO,                                                                      
               DECODE(POHD.DOC_TYPE,'X',SUBSTR(PODT.BUYER_ITEM_NO,1,7),                                                                      
                                        (SELECT STDCATLG_ID FROM ICOMCQDT                                                                      
                                          WHERE BUYER = PODT.BYIT_COMORG_CODE                                                                      
                                            AND BUYER_ITEM_NO = PODT.BUYER_ITEM_NO                                                                      
                                            AND CONTRACT_NO = PODT.CONTRACT_NO                                                                      
                                            AND CONTRACT_SEQ = PODT.CONTRACT_SEQ)) AS STDCATLG_ID,                                                                      
               PODT.DESCRIPTION AS DESCRIPTION,                                                                      
               PODT.SPECIFICATION AS SPECIFICATION,                                                                      
               PODT.UNIT_MEASURE AS UNIT_MEASURE,                                                                      
               PODT.PROCESS_TYPE AS PROCESS_TYPE,                                                                      
               PODT.ITEM_QTY AS PO_QTY,                                                                      
               IVDT.WMS_GR_QTY AS GR_QTY,                                                                      
               #{IVK_QTY} AS INV_QTY,                                                                                             
               PODT.UNIT_PRICE AS UNIT_PRICE,                                                                      
               DECODE(PODT.PROCESS_TYPE,'1',(SELECT NVL(STC_SELLER_PRICE,0) FROM WMSSTCK WHERE WAREHOUSE_CODE=#{st_warehouse_code}
                                                                                                                AND STDCATLG_ID = #{STDCATLG_ID} ),NVL(PODT.AGENT_PRICE,0)) AS LIST_PRICE,                                                                       
               ROUND(${IVK_QTY} * NVL(PODT.UNIT_PRICE,0)) AS UNIT_AMT,                                                                      
               ROUND(${IVK_QTY} * DECODE(PODT.PROCESS_TYPE,'1',(SELECT NVL(STC_SELLER_PRICE,0) FROM WMSSTCK WHERE WAREHOUSE_CODE=#{st_warehouse_code} 
                                                                                                                                                          AND STDCATLG_ID = #{STDCATLG_ID} ),NVL(PODT.AGENT_PRICE,0))) AS LIST_AMT,                                                                     
               PODT.ORIGIN_CODE AS ORIGIN_CODE,                                                                      
               PODT.MAKER_NAME AS MAKER_NAME,                                                                      
               DECODE(PODT.PROCESS_TYPE,'1','KRKORE0001','2',POHD.AGENT,'3',PODT.WAREHOUSE_CODE) AS AGENT,                                                                      
               PODT.PO_NO AS PO_NO,                                                                      
               PODT.PO_SEQ AS PO_SEQ,                                                                      
               IVDT.INV_NO AS S_INV_NO,                                                                      
               IVDT.INV_SEQ AS S_INV_SEQ,                                                                      
               PODT.REF_PR_NO AS REF_PR_NO,                                                                      
               PODT.PR_NO AS PR_NO,                                                                      
               PODT.PR_SEQ AS PR_SEQ,                                                                      
               PODT.LEGACY_PO_NO AS LEGACY_PO_NO,                                                                      
               PODT.LEGACY_PO_SEQ AS LEGACY_PO_SEQ,                                                                      
               PODT.DELY_TO_LOCATION AS DELY_TO_LOCATION,                                                                      
               POHD.PO_CREATE_DATE AS PO_DATE,                                                                      
               IVDT.WMS_GR_DATE AS GR_DATE,                                                                      
               #{IVK_DATE} AS INV_DATE,                                                                                                
               0 AS DELIVERY_QTY,                                                                      
               '' AS DELIVERY_DATE,                                                                      
               #{st_user_id} AS ADD_USER_ID,                                                                                           
                #{st_user_id} AS CHANGE_USER_ID,                                                                                      
               '' AS DELIVERY_USER_ID,                                                                      
               #{LEGACY_IV_SERIAL},                                                                                                         
               '' AS DELIVERY_COMPANY,                                                                      
               '' AS DELIVERY_NO,   				                             
				PODT.CMS_CATLG_ID AS DELIVERY_NO,   
				                #{SCHEDULED_DATE},
        			  #{CAR_ID},
        			  #{CAR_NO},
        			  #{CAR_PERSON_NAME},
        			  #{CAR_PERSON_TEL},
        			  #{BOX_QTY},        			  
				'' DELIVERY_PERSON,
			IVDT.TAG_NO AS TAG_NO 

         FROM ICOMPODT PODT, ICOMPOHD POHD, ICOMIVDT IVDT, ICOMIVHD IVHD                                                                      
        WHERE PODT.BUYER = #{BUYER}                                                                         
          AND PODT.PO_NO = #{PO_NO}                                                                        
          AND PODT.PO_SEQ = #{PO_SEQ}                                                                     
          AND IVDT.INV_NO = #{GR_NO}                                                                   
          AND IVDT.INV_SEQ = #{INV_SEQ}                                                                  
          AND PODT.BUYER = POHD.BUYER                                                                      
          AND PODT.PO_NO = POHD.PO_NO                                                                      
          AND PODT.BUYER = IVDT.BUYER                                                                      
          AND PODT.PO_NO = IVDT.PO_NO                                                                      
          AND PODT.PO_SEQ = IVDT.PO_SEQ                                                                      
          AND IVDT.SELLER = IVHD.SELLER                                                                      
          AND IVDT.BUYER = IVHD.BUYER                                                                      
          AND IVDT.INV_NO = IVHD.INV_NO                                                                      
          AND PODT.STATUS <> 'D'                                                                      
          AND IVDT.STATUS <> 'D'                                                                      
          AND IVHD.STATUS <> 'D'                                                                      
   )     				                            
			]]>
	</update>

	<select id="selectMasterWmGiOrderWmsIvkQty" parameterType="java.util.Map" resultType="java.math.BigDecimal">
	SELECT SUM(WMS_IVK_QTY) WMS_IVK_QTY FROM ICOMIVDT
WHERE BUYER = #{BUYER} 
AND  PO_NO = #{PO_NO}
AND  INV_NO = #{GR_NO} 
AND  INV_SEQ = #{INV_SEQ} 
AND  STATUS != 'D'
GROUP BY BUYER, PO_NO, INV_NO, INV_SEQ
	</select>


	<select id="selectMasterWmGiDstbtrPopList" parameterType="java.util.Map" resultType="java.util.Map">

		<![CDATA[
		/*selectMasterWmGiDstbtrPopList*/
SELECT  		                                                    
              A.STATUS_TEXT,                                                
              A.PO_NO,                                                      
              A.STDCATLG_ID,                                                
              A.PO_QTY,                                                     
              nvl(A.IVK_QTY,0) AS IVK_QTY,
               nvl(A.IVK_QTY,0) AS IVK_QTY_ORG,     
              A.IVK_DATE,                                                   
              A.UNIT_PRICE,                                                 
              A.AGENT_TEXT,                                                 
              A.PO_REMARK,                                                  
              A.DOC_TEXT,                                                   
              A.GR_NO,                                                      
              A.BUYER_ITEM_NO,                                              
              nvl(A.WMS_GR_QTY,0) AS WMS_GR_QTY,                                          
              A.WMS_IVK_QTY AS WMS_IVK_QTY_OLD,                                                
              A.RD_DATE,                                                    
              A.UNIT_AMT,                                                   
              A.ADD_USER_NAME,                                              
              A.ADD_USER_TEL,                                               
              A.DESCRIPTION,                                                
              A.SPECIFICATION,                                              
              A.UNIT_MEASURE,                                               
              A.DELY_TO_LOCATION,                                           
              A.AGENT,                                                      
              A.DOC_TYPE,                                                   
              A.BUYER,                                                      
              A.LEGACY_PO_NO,                                               
              A.LEGACY_PO_SEQ,                                              
              A.PO_SEQ,                                                     
              A.INV_SEQ,                                                    
              A.BYIT_COMORG_CODE,                                           
              A.CONTRACT_NO,                                                
              A.CONTRACT_SEQ,                                               
              A.HD_REMARK,                                                  
              A.SORT_STATUS,                                 
        	 A.PROCESS_TYPE,		                                                  
        	A.PROCESS_TEXT,		   
        	 CASE WHEN A.BOX_QTY IS NULL OR A.BOX_QTY = 0 THEN 1
             ELSE A.BOX_QTY END  BOX_QTY,        
        	   SCHEDULED_DATE,
        			  CAR_ID,
        			  CAR_NO,
        			  CAR_PERSON_NAME,
        			  CAR_PERSON_TEL,
        		
DELAY_REMARK,                                               
        	A.IMG_NO,
        	A.PROCESS_TEXT  ||'('|| A.DOC_TEXT ||') '   AS GUBUN                                    
              FROM (                                                        
                     SELECT                                                        
                            '발주' AS STATUS_TEXT,                                                        
                            PODT.PO_NO AS PO_NO,                                                        
							PODT.CMS_CATLG_ID AS STDCATLG_ID,	                                                      
                            PODT.ITEM_QTY AS PO_QTY,                                                        
                            NVL((NVL(PODT.ITEM_QTY,0) - (SELECT SUM(NVL(IVDT.WMS_GR_QTY,0) - NVL(IVDT.WMS_IVK_QTY,0)) FROM ICOMIVDT IVDT                                                        
                                                          WHERE IVDT.BUYER = PODT.BUYER                                                        
                                                            AND IVDT.PO_NO = PODT.PO_NO                                                        
                                                            AND IVDT.STATUS <> 'D'                                                        
                                                            AND IVDT.PO_SEQ = PODT.PO_SEQ)),0) AS IVK_QTY,                                                        
                            TO_CHAR(SYSDATE,'YYYYMMDD') AS IVK_DATE,                                                        
                            PODT.UNIT_PRICE AS UNIT_PRICE,                                                        
                            (SELECT COM_NAME_LOC FROM ICOMCMPY WHERE COM_CODE = POHD.AGENT) AS AGENT_TEXT,                                                        
                            PODT.PO_REMARK AS PO_REMARK,                                                        
                            DECODE(POHD.DOC_TYPE,'S','선입고','X','Kepmro','일반') AS DOC_TEXT,                                                        
                            '' AS GR_NO,                                                        
                            PODT.BUYER_ITEM_NO AS BUYER_ITEM_NO,                                                        
                            0 AS WMS_GR_QTY,                                                        
                            0 AS WMS_IVK_QTY,                                                        
                            PODT.RD_DATE AS RD_DATE,                                                        
                            ROUND(NVL(DECODE(NVL((NVL(PODT.ITEM_QTY,0) - (SELECT SUM(NVL(IVDT.WMS_GR_QTY,0) - NVL(IVDT.WMS_IVK_QTY,0)) FROM ICOMIVDT IVDT                                                        
                                                                           WHERE IVDT.BUYER = PODT.BUYER                                                        
                                                                             AND IVDT.PO_NO = PODT.PO_NO                                                        
                                                                             AND IVDT.STATUS <> 'D'                                                        
                                                                             AND IVDT.PO_SEQ = PODT.PO_SEQ)),0),0,PODT.ITEM_QTY,                                                        
                                         NVL((NVL(PODT.ITEM_QTY,0) - (SELECT SUM(NVL(IVDT.WMS_GR_QTY,0) - NVL(IVDT.WMS_IVK_QTY,0)) FROM ICOMIVDT IVDT                                                        
                                                                       WHERE IVDT.BUYER = PODT.BUYER                                                        
                                                                         AND IVDT.PO_NO = PODT.PO_NO                                                        
                                                                         AND IVDT.STATUS <> 'D'                                                        
                                                                         AND IVDT.PO_SEQ = PODT.PO_SEQ)),0)) * PODT.UNIT_PRICE,0),1) AS UNIT_AMT,                                                        
                            PRDT.ADD_USER_NAME AS ADD_USER_NAME,                                                        
                            PRDT.ADD_USER_TEL AS ADD_USER_TEL,                                                        
                            PODT.DESCRIPTION AS DESCRIPTION,                                                        
                            PODT.SPECIFICATION AS SPECIFICATION,                                                        
                            PODT.UNIT_MEASURE AS UNIT_MEASURE,                                                        
                            POHD.DELY_TO_LOCATION AS DELY_TO_LOCATION,                                                        
                            POHD.AGENT AS AGENT,                                                        
                            POHD.DOC_TYPE AS DOC_TYPE,                                                        
                            PODT.BUYER AS BUYER,                                                        
                            PODT.LEGACY_PO_NO AS LEGACY_PO_NO,                                                        
                            PODT.LEGACY_PO_SEQ AS LEGACY_PO_SEQ,                                                        
                            PODT.PO_SEQ AS PO_SEQ,                                                        
                            '' AS INV_SEQ,                                                        
                            PODT.BYIT_COMORG_CODE AS BYIT_COMORG_CODE,                                                        
                            PODT.CONTRACT_NO AS CONTRACT_NO,                                                        
                            PODT.CONTRACT_SEQ AS CONTRACT_SEQ,                                                       
                            POHD.PO_REMARK AS HD_REMARK,                                                        
                            '2' AS SORT_STATUS,                                                        
			                PODT.PROCESS_TYPE AS PROCESS_TYPE,                                                        
			                DECODE(PODT.PROCESS_TYPE,'1','재고','2','TR','3','VMI') AS PROCESS_TEXT,    
			                
			                '' AS SCHEDULED_DATE,
                '' AS CAR_ID,
                '' AS CAR_NO,
                '' AS CAR_PERSON_NAME,
                '' AS CAR_PERSON_TEL,
                PODT.DELAY_REMARK,
			    0 AS BOX_QTY ,             
			                                                                    
            				DECODE((SELECT MAX(DOC_TYPE) FROM ICOMPOHD                                                                  
                                WHERE BUYER = PODT.BUYER                                                                                
                                  AND PO_NO = PODT.PO_NO),                                                                              
                              'X',(SELECT NVL(TRIM(IMG_NO),'0') FROM ITEMMAST                                                           
                                    WHERE STDCATLG_ID = SUBSTR(PODT.BUYER_ITEM_NO,1,7)),'') AS IMG_NO 
                         
                      FROM ICOMPOHD POHD, ICOMPODT PODT, ICOMPRDT PRDT                                                        
                      WHERE PODT.BUYER = #{st_buyer}                                                       
                        AND NVL(SUBSTRB(PODT.PO_REMARK,1,INSTRB(PODT.PO_REMARK,'(')-1),'없음') = #{st_bugup}                                                     
						AND PODT.ADD_DATE BETWEEN TO_CHAR(SYSDATE-${st_target_term},'YYYYMMDD') AND TO_CHAR(SYSDATE,'YYYYMMDD')                                                       
                        AND POHD.BUYER = PODT.BUYER                                                        
                        AND POHD.PO_NO = PODT.PO_NO                                                        
                        AND POHD.STATUS <> 'D'                                                        
                        AND PODT.BUYER = PRDT.BUYER                                                        
                        AND PODT.PR_NO = PRDT.PR_NO                                                        
                        AND PODT.PR_SEQ = PRDT.PR_SEQ                                                        
                        AND PODT.STATUS <> 'D'                                                        
                        AND PRDT.STATUS <> 'D'                                                        
                        AND PODT.COMPLETE_MARK = 'N'                                                        
                        AND PODT.ITEM_QTY > PODT.IV_QTY                                                        
						AND PODT.PROCESS_TYPE <> '0'	                        
						
                UNION ALL                                                        

                     SELECT                                                        
                            DECODE(PODT.PROCESS_TYPE,'2',DECODE(IVDT.WMS_GR_QTY,0,'입고예정',IVDT.WMS_IVK_QTY,'출고','출고예정'),DECODE(PODT.ITEM_QTY,PODT.IV_QTY,'출고','출고예정')) AS STATUS_TEXT,                                                        
                            PODT.PO_NO AS PO_NO,                                                        
							PODT.CMS_CATLG_ID AS STDCATLG_ID,	                                                      

                            PODT.ITEM_QTY AS PO_QTY,                                                        
                            DECODE(PODT.PROCESS_TYPE,'2',(NVL(IVDT.WMS_GR_QTY,0) - NVL(IVDT.WMS_IVK_QTY,0)),(NVL(PODT.ITEM_QTY,0)-NVL(PODT.IV_QTY,0))) AS IVK_QTY,                                                        
                            TO_CHAR(SYSDATE,'YYYYMMDD') AS IVK_DATE,                                                        
                            PODT.UNIT_PRICE AS UNIT_PRICE,                                                        
                            (SELECT COM_NAME_LOC FROM ICOMCMPY WHERE COM_CODE = POHD.AGENT) AS AGENT_TEXT,                                                        
                            PODT.PO_REMARK AS PO_REMARK,                                                        
                            DECODE(POHD.DOC_TYPE,'S','선입고','X','Kepmro','일반') AS DOC_TEXT,                                                        
                            IVDT.INV_NO AS GR_NO,                                                        
                            PODT.BUYER_ITEM_NO AS BUYER_ITEM_NO,                                                        

                     DECODE(PODT.PROCESS_TYPE,'2',IVDT.WMS_GR_QTY,(SELECT AVAIL_QTY FROM WMSSTCK WHERE WAREHOUSE_CODE =#{st_warehouse_code}      
                     AND STDCATLG_ID = PODT.CMS_CATLG_ID AND AGENT = DECODE(PODT.PROCESS_TYPE,'1','KRKORE0001','3',PODT.WAREHOUSE_CODE))) AS  WMS_GR_QTY,                                                         

                            IVDT.WMS_IVK_QTY AS WMS_IVK_QTY,                                                        
                            PODT.RD_DATE AS RD_DATE,                                                        
                            ROUND((DECODE(NVL(IVDT.WMS_GR_QTY,0) - NVL(IVDT.WMS_IVK_QTY,0),0,IVDT.WMS_IVK_QTY,                                                        
                                    NVL(IVDT.WMS_GR_QTY,0) - NVL(IVDT.WMS_IVK_QTY,0)) * PODT.UNIT_PRICE),1) AS UNIT_AMT,                                                        
                            PRDT.ADD_USER_NAME AS ADD_USER_NAME,                                                        
                            PRDT.ADD_USER_TEL AS ADD_USER_TEL,                                                        
                            PODT.DESCRIPTION AS DESCRIPTION,                                                        
                            PODT.SPECIFICATION AS SPECIFICATION,                                                        
                            PODT.UNIT_MEASURE AS UNIT_MEASURE,                                                        
                            POHD.DELY_TO_LOCATION AS DELY_TO_LOCATION,                                                        
                            POHD.AGENT AS AGENT,                                                        
                            POHD.DOC_TYPE AS DOC_TYPE,                                                        
                            PODT.BUYER AS BUYER,                                                        
                            PODT.LEGACY_PO_NO AS LEGACY_PO_NO,                                                        
                            PODT.LEGACY_PO_SEQ AS LEGACY_PO_SEQ,                                                        
                            PODT.PO_SEQ AS PO_SEQ,                                                        
                            IVDT.INV_SEQ AS INV_SEQ,                                                        
                            PODT.BYIT_COMORG_CODE AS BYIT_COMORG_CODE,                                                        
                            PODT.CONTRACT_NO AS CONTRACT_NO,                                                        
                            PODT.CONTRACT_SEQ AS CONTRACT_SEQ,                                                        
                            POHD.PO_REMARK AS HD_REMARK,                                                        
                            DECODE(IVDT.WMS_GR_QTY,IVDT.WMS_IVK_QTY,'3','1') AS SORT_STATUS,                                                        
			                PODT.PROCESS_TYPE AS PROCESS_TYPE,                                                        
			                DECODE(PODT.PROCESS_TYPE,'1','재고','2','TR','3','VMI') AS PROCESS_TEXT,    
			                
			                 CASE WHEN IVDT.SCHEDULED_DATE IS NULL OR IVDT.SCHEDULED_DATE = '' 
              THEN TO_CHAR((CASE WHEN (sysdate+7)-next_day(sysdate,1)+1 = 6 THEN  sysdate+3
                             WHEN (sysdate+7)-next_day(sysdate,1)+1 = 7 THEN  sysdate+2
                             ELSE SYSDATE+1 
                             END ), 'YYYYMMDD')
              ELSE IVDT.SCHEDULED_DATE END SCHEDULED_DATE,           
                IVDT.CAR_ID,
                IVDT.CAR_NO,
                IVDT.CAR_PERSON_NAME,
                IVDT.CAR_PERSON_TEL,
                PODT.DELAY_REMARK,
			      CASE WHEN IVDT.BOX_QTY IS NULL OR IVDT.BOX_QTY = 0 THEN 0
         	    ELSE IVDT.BOX_QTY END  BOX_QTY,           
			                                                                    
            				DECODE((SELECT MAX(DOC_TYPE) FROM ICOMPOHD                                                                  
                                WHERE BUYER = PODT.BUYER                                                                                
                                  AND PO_NO = PODT.PO_NO),                                                                              
                              'X',(SELECT NVL(TRIM(IMG_NO),'0') FROM ITEMMAST                                                           
                                    WHERE STDCATLG_ID = SUBSTR(PODT.BUYER_ITEM_NO,1,7)),'') AS IMG_NO  
                     	
 FROM ICOMPOHD POHD, ICOMPODT PODT, ICOMPRDT PRDT, ICOMIVDT IVDT                                                        
                      WHERE PODT.BUYER = #{st_buyer}                                                             
                        AND TRIM(NVL(SUBSTRB(PODT.PO_REMARK,1,INSTRB(PODT.PO_REMARK,'(')-1),'없음')) =#{st_bugup}                                                      
						AND PODT.ADD_DATE BETWEEN TO_CHAR(SYSDATE-${st_target_term},'YYYYMMDD') AND TO_CHAR(SYSDATE,'YYYYMMDD')                                                       
                        AND POHD.BUYER = PODT.BUYER                                                        
                        AND POHD.PO_NO = PODT.PO_NO                                                        
                        AND POHD.STATUS <> 'D'                                                        
                        AND PODT.BUYER = PRDT.BUYER                                                        
                        AND PODT.PR_NO = PRDT.PR_NO                                                        
                        AND PODT.PR_SEQ = PRDT.PR_SEQ                                                        
                        AND PODT.STATUS <> 'D'                                                        
                        AND PRDT.STATUS <> 'D'                                                        
                        AND PODT.BUYER = IVDT.BUYER                                                        
                        AND PODT.PO_NO = IVDT.PO_NO                                                        
                        AND PODT.PO_SEQ = IVDT.PO_SEQ                                                        
						AND PODT.PROCESS_TYPE <> '0'	                                                      
						AND IVDT.WMS_GR_QTY <> IVDT.WMS_IVK_QTY                                                       
                        AND IVDT.STATUS <> 'D' ) A           
                        ORDER BY A.SORT_STATUS,A.WMS_IVK_QTY ,A.PO_REMARK, A.BUYER, A.LEGACY_PO_NO,A.LEGACY_PO_SEQ                        
		]]>

	</select>
	
	<update  id="updateMasterWmGiDstbtrICOMPORS" parameterType="java.util.Map" >
		<![CDATA[
				/* updateMasterWmGiDstbtrICOMPORS */
   			UPDATE ICOMPORS
     			  SET BUYER_DS_DATE = #{SCHEDULED_DATE}
     			     ,CHANGE_DATE = TO_CHAR(SYSDATE, 'YYYYMMDD')
					 ,CHANGE_TIME = TO_CHAR(SYSDATE, 'HH24MISS')
              	WHERE BUYER   = #{BUYER}                              
                  AND PO_NO   = #{PO_NO}
                  AND PO_SEQ  = #{PO_SEQ}
                  AND STATUS != 'D'
			]]>
	</update>
								
</mapper>

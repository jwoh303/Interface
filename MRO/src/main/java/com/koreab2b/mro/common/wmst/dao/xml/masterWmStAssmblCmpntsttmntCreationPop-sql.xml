<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="common.wmst">

	<select id="existMasterWmStAssmblCmpntsttmntCreationPop" parameterType="java.util.Map" resultType="java.util.Map">
		 <![CDATA[
		 	 /*existMasterWmStAssmblCmpntsttmntCreationPop*/
		 	 select bom_id from KEPBOFM where bom_id= #{st_bom_id} and status <> 'D' 
		 ]]>
	</select>

	<update id="saveMasterWmStAssmblCmpntsttmntCreationPopBot" parameterType="java.util.Map">
	 /*saveMasterWmStAssmblCmpntsttmntCreationPopBot*/
	 <![CDATA[
			INSERT INTO KEPBOFM(                                                                                  
											BOM_ID
										   ,SUB_ID
										   ,STATUS
										   ,QTY
										   ,ADD_DATE
										   ,ADD_USER_ID
										   ,LAST_WORK_DATE
										   ,LAST_WORK_USER_ID
										   ,CHANGE_DATE 
										   ,CHANGE_USER_ID 
										   ) 
										   VALUES(                                                                           
			                               #{st_bom_id}		
			                               ,#{BUYER_ITEM_NO}   		
			                               ,'C'                           
			                               ,#{st_assembly_qty}  		
			                               ,to_char(sysdate,'yyyymmdd') 		
			                               ,#{st_user_id}                    
			                               ,'' 
			                               ,'' 
			                               ,to_char(sysdate,'yyyymmdd') 
			                               ,to_char(sysdate,'yyyymmdd') 
			                               )     	 
	 ]]>
	</update>


	<select id="selectMasterWmStAssmblCmpntsttmntCreationPopList" parameterType="java.util.Map" resultType="java.util.Map">
		<include refid="common.ibsheet.xml.pagestart"/>	
		<![CDATA[
		/*selectMasterWmStAssmblCmpntsttmntCreationPopList*/
	    SELECT                                                                      
				IT.BUYER_ITEM_NO,                                            
				IT.DESCRIPTION_LOC,                                         
				IT.SPECIFICATION,                                              
				IT.UNIT_MEASURE,                                              
				ST.STC_SELLER_PRICE,                                      
				IT.MAKER_NAME,                                                
				IT.ORIGIN_CODE ,                                                
				ST.AVAIL_QTY,
				                (SELECT TEXT2
                    FROM ICOMCOD1
                   WHERE TYPE = 'M001' AND CODE = IT.ORIGIN_CODE) ORIGIN_NAME                                                         
			FROM ICOMBYIT IT, WMSSTCK ST                                  
			WHERE IT.BUYER = ST.WAREHOUSE_CODE                           
			  AND IT.BUYER_ITEM_NO = ST.STDCATLG_ID                         
			  AND ST.PROCESS_TYPE = '1'											
			  AND IT.STATUS <> 'D'                                                 
			  AND ST.STATUS <> 'D'                                                
			  AND IT.BUYER = #{st_warehouse_code}				 
		]]>
		<if test="st_desc != null and st_desc != ''">
			<![CDATA[
				AND IT.DESCRIPTION_LOC LIKE '%'||#{st_desc}||'%'
			]]>	
		</if>
		<if test="st_spec != null and st_spec != ''">
			<![CDATA[
					AND IT.SPECIFICATION LIKE '%'||#{st_spec}||'%'
			]]>	
		</if>
		<if test="st_location_id != null and st_location_id != ''">
			<![CDATA[
					AND ST.LOCATION_ID LIKE '%'||#{st_location_id}||'%'
			]]>	
		</if>
		<if test="st_item_no != null and st_item_no != ''">
			<![CDATA[
					AND IT.BUYER_ITEM_NO LIKE  '%'||#{st_item_no}||'%'
			]]>	
		</if>		
		<if test='st_qty =="Y"'>
			<![CDATA[
					AND ST.AVAIL_QTY = 0  
			]]>	
		</if>
		<if test='st_qty =="N"'>
			<![CDATA[
					AND ST.AVAIL_QTY > 0  
			]]>	
		</if>		
			<![CDATA[
			ORDER BY IT.DESCRIPTION_LOC,IT.BUYER_ITEM_NO
				]]>	
		<include refid="common.ibsheet.xml.pageend"/>											
	</select>
	
	
	
	<select id="selectMasterWmStAssmblCmpntsttmntCreationPopList2" parameterType="java.util.Map" resultType="java.util.Map">

		<![CDATA[
		/*selectMasterWmStAssmblCmpntsttmntCreationPopList2*/
                 SELECT                                                           
                 	IT.BUYER_ITEM_NO,                                  
                 	IT.DESCRIPTION_LOC,                               
                 	IT.SPECIFICATION,                                    
                 	IT.UNIT_MEASURE,                                     
                 	ST.STC_SELLER_PRICE,                            
                 	IT.MAKER_NAME,                                       
                 	IT.ORIGIN_CODE,
                 (SELECT TEXT2
                    FROM ICOMCOD1
                   WHERE TYPE = 'M001' AND CODE = IT.ORIGIN_CODE) ORIGIN_NAME                                             
                 FROM ICOMBYIT IT, WMSSTCK ST                 
                 WHERE IT.BUYER = ST.WAREHOUSE_CODE        
                   AND IT.BUYER_ITEM_NO = ST.STDCATLG_ID    
                   AND IT.BUYER = #{st_warehouse_code}		          
                   AND ST.PROCESS_TYPE = '1'                          
                   AND IT.BUYER_ITEM_NO IN 						 						 
		]]>
	    <foreach collection="itemParam" item="st_sel_item_no" index="i" open="(" separator=","  close=")" >	
				#{st_sel_item_no}
	 	</foreach> 

	</select>	
								
</mapper>

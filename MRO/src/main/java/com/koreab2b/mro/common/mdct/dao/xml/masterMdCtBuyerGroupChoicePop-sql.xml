<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="common.mdct">

	<select id="selectmasterMdCtBuyerGroupChoicePopList" parameterType="java.util.Map" resultType="java.util.Map">
		<![CDATA[
		/* selectmasterMdCtBuyerGroupChoicePopList */
		SELECT										        
			GROUP_CODE,
			GROUP_NAME
		FROM BNTBUYERGROUP 							 
		WHERE GROUP_FLAG = 'A'
		]]>
		<if test="st_group_name != null and st_group_name != ''">
		<![CDATA[
		AND GROUP_NAME LIKE '%'||#{st_group_name}||'%' 
		]]>
		</if>
	</select>
</mapper>

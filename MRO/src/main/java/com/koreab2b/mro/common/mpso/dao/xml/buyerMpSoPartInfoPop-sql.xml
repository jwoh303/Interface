<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="common.mpso">


	<select id="selectBuyerMpSoPartInfoPopList" parameterType="java.util.Map" resultType="java.util.Map">
		<![CDATA[
		/*selectBuyerMpSoPartInfoPopList*/
         SELECT  
                CODE,                 --[0]
                TEXT1,                --[1]
                TEXT2,                --[2]
                TEXT3,                --[3]
                TEXT4                 --[4]

           FROM ICOMCOD2  
          WHERE TYPE = #{st_type}
            AND COMPANY_CODE = #{st_buyer}
   ]]> 
		<if test="st_code != null and st_code != ''">
			<![CDATA[
            AND TEXT1 LIKE  '%'||#{st_code}||'%'
            ]]> 
            </if>
 		<if test="st_name != null and st_name != ''">
			<![CDATA[
            AND TEXT4  LIKE  '%'||#{st_name}||'%'
		]]>  
		</if>
	</select>
								
</mapper>

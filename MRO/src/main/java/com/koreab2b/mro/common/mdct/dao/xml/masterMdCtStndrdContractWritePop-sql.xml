<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="common.mdct">
	<resultMap  id="StndConstractMap" type="java.util.HashMap">     
		<result	javaType="java.lang.String"	column="FORM_NAME"		property="FORM_NAME" />
		<result	javaType="java.lang.String"	column="BIZ_TYPE"				property="BIZ_TYPE" />     
		<result	javaType="java.lang.String"	column="COMPANY_TYPE"	property="COMPANY_TYPE" />     
		<result	javaType="java.lang.String"	column="DESCRIPTION"		property="DESCRIPTION" />
		<result	javaType="java.lang.String"	column="FORM_TYPE"			property="FORM_TYPE" />
		<result	javaType="java.lang.String"	column="USE_YN"				property="USE_YN" />
		<result	javaType="java.lang.String"	column="WRITER_ID"			property="WRITER_ID" />
		<result	javaType="java.lang.String"	column="WRITER_NAME"		property="WRITER_NAME" />
		<result	javaType="java.lang.String"	column="FORM_CONTENT"	property="FORM_CONTENT"	jdbcType="CLOB"	typeHandler="org.apache.ibatis.type.ClobTypeHandler" />  
	</resultMap >

	<select id="selectMasterMdCtStndrdContractWritePopList" parameterType="java.util.Map" resultMap="StndConstractMap">
		<![CDATA[
			/*selectMasterMdCtStndrdContractWritePopList*/
			SELECT
				FORM_NAME
				,BIZ_TYPE
				,COMPANY_TYPE
				,DESCRIPTION
				,FORM_TYPE
				,USE_YN
				,FORM_CONTENT
				,WRITER_NAME
				,WRITER_ID
			FROM ICOMECCF
			WHERE FORM_NO = #{st_form_no}
		]]>	
	</select>
	
	<select id="selectMasterMdCtStndrdContractWritePopFormNo" parameterType="java.util.Map" resultType="String">
			SELECT 'CF'||SUBSTR(TO_CHAR(SYSDATE, 'YYYY'), 3, 2)||NVL(LPAD(MAX(TO_NUMBER(SUBSTR(FORM_NO, 5, 7)))+1, 7, 0), '0000001') FROM ICOMECCF WHERE FORM_NO LIKE 'CF'||SUBSTR(TO_CHAR(SYSDATE, 'YYYY'), 3, 2) || '%'
	</select>
	
	<update id="insertMasterMdCtStndrdContractWritePop" parameterType="java.util.Map">
		<![CDATA[
			INSERT INTO ICOMECCF (
				FORM_NO
				,FORM_NAME
				,DESCRIPTION
				,FORM_CONTENT
				,USE_YN
				,FORM_TYPE
				,COMPANY_TYPE
				,BIZ_TYPE
				,WRITE_DATE
				,WRITER_ID
				,WRITER_NAME
				,ADD_DATE
				,ADD_TIME
				,ADD_USER_ID
			) VALUES (
				#{st_form_no}
				,#{st_form_name}
				,#{st_description}
				,#{st_form_content}
				,#{st_use_yn}
				,#{st_form_type}
				,#{st_company_type}
				,#{st_biz_type}
				,TO_CHAR(SYSDATE,'YYYYMMDD')
				,#{st_user_id}
				,#{st_user_name}
				,TO_CHAR(SYSDATE,'YYYYMMDD')
				,TO_CHAR(SYSDATE,'HH24MISS')
				,#{st_user_id}
			)
		]]>
	</update>
	
	<update id="updateMasterMdCtStndrdContractWritePop" parameterType="java.util.Map">
		<![CDATA[
			UPDATE ICOMECCF
			SET
					FORM_NAME			= #{st_form_name},
					DESCRIPTION			= #{st_description},
					FORM_CONTENT		= #{st_form_content},
					USE_YN					= #{st_use_yn},
					FORM_TYPE				= #{st_form_type},
					COMPANY_TYPE			= #{st_company_type},
					BIZ_TYPE					= #{st_biz_type},
					CHANGE_DATE			= TO_CHAR(SYSDATE,'YYYYMMDD'),
					CHANGE_TIME			= TO_CHAR(SYSDATE,'HH24MISS'),
					CHANGE_USER_ID		= #{st_user_id}
			WHERE FORM_NO				= #{st_form_no}
		]]>
	</update>	
								
</mapper>

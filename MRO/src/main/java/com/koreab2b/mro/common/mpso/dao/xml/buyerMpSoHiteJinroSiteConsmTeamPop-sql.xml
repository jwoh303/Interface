<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="common.mpso">


	<select id="selectBuyerMpSoHiteJinroSiteConsmTeamPopList" parameterType="java.util.Map" resultType="java.util.Map">
		<![CDATA[
		/*selectBuyerMpSoHiteJinroSiteConsmTeamPopList*/



         SELECT  
                CODE,                  --[0]
                TEXT1                  --[1]

           FROM ICOMCOD2  
          WHERE TYPE = 'M014'  
           		AND COMPANY_CODE = #{st_buyer}
            
               ]]> 
		<if test="st_code != null and st_code != ''">
			<![CDATA[
            	AND CODE LIKE  '%'||#{st_code}||'%'
            ]]> 
            </if>
 		<if test="st_name != null and st_name != ''">
			<![CDATA[
            	AND TEXT1  LIKE  '%'||#{st_name}||'%'
		]]>  
		</if>
            
         <if test="st_buyer == 'KRJINR0005' ">
			<![CDATA[
			     AND TEXT3 = #{st_userDept}  
			     ORDER BY   CODE 
		]]>  
		</if>   
             
		
	</select>
								
</mapper>

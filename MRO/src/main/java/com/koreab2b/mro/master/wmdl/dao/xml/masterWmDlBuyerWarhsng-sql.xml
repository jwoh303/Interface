<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="master.wmdl">
	<!-- 조회 -->
	<select id="selectMasterWmDlBuyerWarhsngList" parameterType="java.util.Map" resultType="java.util.Map">
		<include refid="common.ibsheet.xml.pagestart"/>	
			<![CDATA[
		    	SELECT /*selectMasterWmDlBuyerWarhsngList*/                            
                      ROWNUM NUM,                                        
                         X.BUYER_NAME,                                        
                         X.PO_NO,                                        
                         X.INV_NO,                                        
                         X.STDCATLG_ID,                                        
                         X.PO_CREATE_DATE,                                        
                         X.INV_DATE,                                        
                         X.GR_DATE,                                        
                         X.PO_QTY,                                        
                         X.INV_QTY,                                        
                         X.LIST_PRICE,                                        
                         X.LIST_AMT,                                        
                         X.STATUS_TEXT,                                        
                         X.LEGACY_PO_NO,                                        
                         X.REF_PR_NO,                                        
                         X.BUYER_ITEM_NO,                                        
                         X.RD_DATE,                                        
                         X.DELIVERY_DATE,                                        
                         X.DOC_TEXT,                                        
                         X.GR_QTY,                                        
                         X.DELIVERY_QTY,                                        
                         X.UNIT_PRICE,                                        
                         X.UNIT_AMT,                                        
                         X.DESCRIPTION,                                        
                         X.SPECIFICATION,                                        
                         X.AGENT,                                        
                         X.ADD_USER_NAME,                                        
                         X.ADD_USER_TEL,                                        
                         X.DELY_TO_LOCATION,                                        
                         X.PO_REMARK,                                        
                         X.PO_HD_REMARK,                                        
                         X.BUYER,                                        
                         X.PO_SEQ,                                        
                         X.BYIT_COMORG_CODE,                                        
                         X.CONTRACT_NO,                                        
                         X.CONTRACT_SEQ,                                        
                         X.IK_SEQ,                                        
                         X.DOC_TYPE,                                                 
                         X.MASTER_ITEM,                                              
                         X.IMG_NO             		
                   FROM (                                        
                         SELECT  /*+USE_NL(WIDT PODT) */                                      
                                (SELECT COM_NAME_LOC FROM ICOMCMPY WHERE COM_CODE = POHD.BUYER) AS BUYER_NAME,                                        
                                PODT.PO_NO AS PO_NO,                                        
                                WIDT.INV_NO AS INV_NO,                                        
                 DECODE(POHD.DOC_TYPE,'X',SUBSTR(PODT.BUYER_ITEM_NO,1,7),                                        
                                          (SELECT STDCATLG_ID FROM ICOMCQDT                                        
                                            WHERE BUYER = PODT.BYIT_COMORG_CODE                                        
                                              AND BUYER_ITEM_NO = PODT.BUYER_ITEM_NO                                        
                                              AND CONTRACT_NO = PODT.CONTRACT_NO                                        
                                              AND CONTRACT_SEQ = PODT.CONTRACT_SEQ)) AS STDCATLG_ID,                                        

                                POHD.PO_CREATE_DATE AS PO_CREATE_DATE,                                        
                                WIDT.INV_DATE AS INV_DATE,                                        
                                (SELECT MAX(GR_DATE) FROM ICOMGRDT                                        
                                  WHERE BUYER = PODT.BUYER                                        
                                    AND PO_NO = PODT.PO_NO                                        
                                    AND PO_SEQ = PODT.PO_SEQ                                        
                                    AND STATUS <> 'D') AS GR_DATE,                                        
                                NVL(PODT.ITEM_QTY,0) AS PO_QTY,                                        
                                NVL(WIDT.INV_QTY,0) AS INV_QTY,                                        
                                NVL(PODT.AGENT_PRICE,0) AS LIST_PRICE,                                        
                                NVL(WIDT.DELIVERY_QTY,0) * NVL(PODT.AGENT_PRICE,0) AS LIST_AMT,                                        
                                DECODE(NVL(PODT.GR_QTY,0),0,'미입고',DECODE(NVL(PODT.ITEM_QTY,0),NVL(PODT.GR_QTY,0),'입고완료','분할입고')) AS STATUS_TEXT,                                        
                                PODT.LEGACY_PO_NO AS LEGACY_PO_NO,                                        
                                PODT.REF_PR_NO AS REF_PR_NO,                                        
                                PODT.BUYER_ITEM_NO AS BUYER_ITEM_NO,                                        
                                PODT.RD_DATE AS RD_DATE,                                        
                                WIDT.DELIVERY_DATE AS DELIVERY_DATE,                                        
                                DECODE(POHD.DOC_TYPE,'S','선입고','X','Kepmro','일반') AS DOC_TEXT,                                        
                                NVL(PODT.GR_QTY,0) AS GR_QTY,                                        
                                NVL(WIDT.DELIVERY_QTY,0) AS DELIVERY_QTY,                                        
                                NVL(PODT.UNIT_PRICE,0) AS UNIT_PRICE,                                        
                                NVL(WIDT.DELIVERY_QTY,0) * NVL(PODT.UNIT_PRICE,0) AS UNIT_AMT,                                        
                                PODT.DESCRIPTION AS DESCRIPTION,                                        
                                PODT.SPECIFICATION AS SPECIFICATION,                                        
                                POHD.AGENT AS AGENT,                                        
                                PRDT.ADD_USER_NAME AS ADD_USER_NAME,                                        
                                PRDT.ADD_USER_TEL AS ADD_USER_TEL,                                        
                                POHD.DELY_TO_LOCATION AS DELY_TO_LOCATION,                                        
                                PODT.PO_REMARK AS PO_REMARK,                                        
                                POHD.PO_REMARK AS PO_HD_REMARK,                                        
                                POHD.BUYER AS BUYER,                                        
                                PODT.PO_SEQ AS PO_SEQ,                                        
                                PODT.BYIT_COMORG_CODE AS BYIT_COMORG_CODE,                                        
                                PODT.CONTRACT_NO AS CONTRACT_NO,                                        
                                PODT.CONTRACT_SEQ AS CONTRACT_SEQ,                                        
                                WIDT.INV_SEQ AS IK_SEQ,                                       
                                POHD.DOC_TYPE AS DOC_TYPE,                                                                               
                                SUBSTR(PODT.BUYER_ITEM_NO,1,7) AS MASTER_ITEM,                                                           
                                DECODE(POHD.DOC_TYPE,'X',(SELECT NVL(TRIM(IMG_NO),'0') FROM ITEMMAST                                         
                                                           WHERE STDCATLG_ID = SUBSTR(PODT.BUYER_ITEM_NO,1,7)),'') AS IMG_NO                                        
                           FROM WMSIVDT WIDT, ICOMPODT PODT, ICOMPOHD POHD, ICOMPRDT PRDT                                        
                          WHERE WIDT.WAREHOUSE_CODE = #{st_warehouse_code }                                                     						
				]]>
													<if test="st_buyer_code != null and st_buyer_code != ''">  
              										  <choose >
              										 		<when test='st_buyer_code == "KRXPR0"'>   
                     											 AND (WIDT.BUYER LIKE  'KRXPR0%' OR WIDT.BUYER = 'KRXPV00001') 
              												</when>
              												<otherwise>
              													 AND WIDT.BUYER in
              													 <foreach collection="buyerParam" item="st_buyer_code" index="i" open="(" separator=","  close=")" >	
	    			 												#{st_buyer_code}
	  													 		</foreach>   
              												</otherwise>
              										  </choose>      
              										 </if>		
              				<![CDATA[
                            AND WIDT.STATUS <> 'D'                                        
                            AND WIDT.BUYER = PODT.BUYER                                        
                            AND WIDT.PO_NO = PODT.PO_NO                                        
                            AND WIDT.PO_SEQ = PODT.PO_SEQ                                        
                            AND PODT.STATUS <> 'D'                                        
                            AND WIDT.BUYER = POHD.BUYER                                        
                            AND WIDT.PO_NO = POHD.PO_NO                                        
                            AND POHD.STATUS <> 'D'                                        
                            AND PODT.BUYER = POHD.BUYER                                        
                            AND PODT.PO_NO = POHD.PO_NO                                        
                            AND WIDT.BUYER = PRDT.BUYER                                        
                            AND WIDT.PR_NO = PRDT.PR_NO                                        
                            AND WIDT.PR_SEQ = PRDT.PR_SEQ                                        
                            AND PRDT.STATUS <> 'D'                				
              				]]>	
           <if test="st_date_type != null and st_date_type != ''">    
           	         <choose>
              				<when test='st_date_type == "PO"'>   
              					AND POHD.PO_CREATE_DATE     BETWEEN #{st_from_date} AND #{st_to_date}
              		 		</when>
              		 		<otherwise>
              		 			 AND PODT.RD_DATE      BETWEEN #{st_from_date} AND #{st_to_date}
              		 		</otherwise>
              		</choose>            				
           </if>								 		
		        <if test="st_po_no != null and st_po_no != ''">
		    			AND (PODT.PO_NO LIKE #{st_po_no}||'%' OR PODT.LEGACY_PO_NO LIKE #{st_po_no}||'%')
		        </if>
		        <if test="st_ik_no != null and st_ik_no != ''">
		    				AND WIDT.INV_NO LIKE #{st_ik_no}||'%'
		        </if>
		        			<![CDATA[
		        			  )X      
		        ]]>
		        <if test='st_status_text != "" '>
		    				WHERE X.STATUS_TEXT = #{st_status_text}
		        </if>
		       <if test='st_order_by == "1"'>
		       	 ORDER BY X.RD_DATE, X.BUYER_NAME,X.PO_NO,X.PO_SEQ      
		       </if>
		       <if test='st_order_by == "2"'>
		       	 ORDER BY X.BUYER_NAME,X.PO_NO,X.PO_SEQ      
		       </if> 
		       <if test='st_order_by == "3"'>
		       	ORDER BY  X.BUYER_NAME,X.PO_NO,X.PO_SEQ    
		       </if>
		       <if test='st_order_by == "4"'>
		       	 ORDER BY  X.INV_NO,X.BUYER_NAME,X.PO_NO,X.PO_SEQ   
		       </if> 	
		       <if test='st_order_by == "5"'>
		       	ORDER BY  X.GR_DATE,X.BUYER_NAME,X.PO_NO,X.PO_SEQ           
		       </if> 			       	       
		<include refid="common.ibsheet.xml.pageend"/>
	</select>


</mapper>   
   

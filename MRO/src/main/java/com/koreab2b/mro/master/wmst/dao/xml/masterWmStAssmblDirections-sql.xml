<?xml version="1.0" encoding="utf-8" ?> 
<!DOCTYPE mapper PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN" "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">
<mapper namespace="master.wmst">
	<!-- 조회 -->
	<select id="selectMasterWmStAssmblDirectionsList" parameterType="java.util.Map" resultType="java.util.Map">
		<include refid="common.ibsheet.xml.pagestart"/>	
			<![CDATA[
		    	SELECT /*selectMasterWmStAssmblDirectionsList*/                            
				AS_NO,                                                                                                                                                                                                                                            
				BOM_ID,                                                                                                                                                                                                                                          
				MAX(IT.DESCRIPTION_LOC) DESCRIPTION_LOC,                                                                                                                                                                                
				MAX(IT.UNIT_MEASURE) UNIT_MEASURE,                                                                                                                                                                                         
				MAX(ST.TOT_QTY) TOT_QTY,                                                                                                                                                                                                          
				MAX(ST.ALLOC_QTY) ALLOC_QTY,                                                                                                                                                                                                   
				MAX(USR.USER_NAME_LOC) USER_NAME_LOC,                                                                                                                                                                                
				MAX(ASS.ADD_DATE) ADD_DATE,                                                                                                                                                                                                     
				MAX(DECODE(ASSEMB_FLAG,'N',DECODE(ASS.WORK_TYPE,'ASS','조립지시','DEA','분해지시'),'Y',DECODE(ASS.WORK_TYPE,'ASS','조립완료','DEA','분해완료'))) STATUS,
				MAX(DECODE(ASS.WORK_TYPE,'ASS','조립','DEA','분해')) 작업구분,                                                                                                                                                     
				MAX(IT.SPECIFICATION) SPECIFICATION,                                                                                                                                                                                            
				MAX(IT.MAKER_NAME) MAKER_NAME,                                                                                                                                                                                               
				MAX(ASS.BOM_QTY) BOM_QTY,                                                                                                                                                                                                         
				MAX(ST.AVAIL_QTY) AVAIL_QTY,                                                                                                                                                                                                        
				MAX(ASUSR.USER_NAME_LOC) ASSEMB_USER_NAME,                                                                                                                                                                       
				MAX(ASS.ASSEMB_DATE) ASSEMB_DATE                                                                                                                                                                                           
			FROM WMSASSEMB ASS, ICOMBYIT IT , WMSSTCK ST , ICOMLUSR USR , ICOMLUSR ASUSR                                                                                                                    
			WHERE ASS.BOM_ID = IT.BUYER_ITEM_NO                                                                                                                                                                                               
			  AND ASS.WAREHOUSE_CODE = IT.BUYER                                                                                                                                                                                              
			  AND ASS.WAREHOUSE_CODE = ST.WAREHOUSE_CODE                                                                                                                                                                          
			  AND ASS.BOM_ID = ST.STDCATLG_ID                                                                                                                                                                                                    
			  AND ASS.ADD_USER_ID = USR.USER_ID(+)                                                                                                                                                                                                  
			  AND ASS.ASSEMB_USER_ID = ASUSR.USER_ID(+)                                                                                                                                                                                       
			  AND ASS.ADD_DATE BETWEEN #{st_from_date} AND #{st_to_date}	 
			  AND ASS.WAREHOUSE_CODE = #{st_warehouse_code}			 
			  AND ASS.STATUS <> 'D'						 
			  AND IT.STATUS <> 'D'	
			  		]]>						 
			<if test="st_item_no != null and st_item_no != ''">
				AND ASS.BOM_ID = #{st_item_no}
			</if>
			<if test="st_as_no != null and st_as_no != ''">
				AND ASS.AS_NO LIKE #{st_as_no}||'%'
			</if>	
			<if test="st_desc != null and st_desc != ''">
				AND IT.DESCRIPTION_LOC LIKE  #{st_desc}||'%'
			</if>	
			<if test="st_assemb_flag != null and st_assemb_flag != ''">
				AND ASS.ASSEMB_FLAG = #{st_assemb_flag}
			</if>	
			<if test="st_work_type != null and st_work_type != ''">
				AND ASS.WORK_TYPE =  #{st_work_type}
			</if>					 
			<![CDATA[
			GROUP BY ASS.AS_NO, ASS.BOM_ID                                                                                                                                                                                                       
			ORDER BY ASS.AS_NO,BOM_ID	 								
			]]>
		<include refid="common.ibsheet.xml.pageend"/>
	</select>

</mapper>   
   

<?xml version="1.0" encoding="utf-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" version="2.5">
	
  <!-- ControlCenter Filter Start -->
        <filter>
                <filter-name>GTWorksFilter</filter-name>
                <filter-class>gtworks.service.session.GTWorksHttpFilter</filter-class>
        </filter>

        <filter-mapping>
                <filter-name>GTWorksFilter</filter-name>
                <url-pattern>*.do</url-pattern>
        </filter-mapping>
   <!-- ControlCenter Filter End -->
	<filter>
		<filter-name>encodingFilter</filter-name>
<!-- 		<filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class> -->
			<filter-class>com.koreab2b.mro.application.filter.CharacterEncodingFilter</filter-class>
		<init-param>
			<param-name>encoding</param-name>
			<param-value>utf-8</param-value>
		</init-param>
		<init-param>
			<param-name>forceEncoding</param-name>
			<param-value>true</param-value>
		</init-param>
	</filter>
	<filter-mapping>
		<filter-name>encodingFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<!-- 정적자원(JS/CSS) URL 에 파일 수정시각(?v=) 자동 부착 (cache-busting) -->
	<filter>
		<filter-name>resourceVersionFilter</filter-name>
		<filter-class>com.koreab2b.mro.application.filter.ResourceVersionFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>resourceVersionFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<!-- 매뉴얼/문서 정적자원 무인증 다운로드 차단 (DefaultServlet 이 서빙하여 Security/LoginCheckHandler 우회됨) -->
	<filter>
		<filter-name>resourceAuthFilter</filter-name>
		<filter-class>com.koreab2b.mro.application.filter.ResourceAuthFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>resourceAuthFilter</filter-name>
		<url-pattern>/resources/excel/work/*</url-pattern>
	</filter-mapping>

	<!-- Spring Security -->
	<filter>
		<filter-name>springSecurityFilterChain</filter-name>
		<filter-class>org.springframework.web.filter.DelegatingFilterProxy</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>springSecurityFilterChain</filter-name>
		<url-pattern>*.do</url-pattern>
	</filter-mapping>

	<context-param>
		<param-name>contextConfigLocation</param-name>
		<param-value>
			/WEB-INF/config/app/app-context.xml
		 	, /WEB-INF/config/sec/security-context.xml
			, /WEB-INF/config/orm/mybatis-context.xml
			, /WEB-INF/config/cache/cache-context.xml
		</param-value>
	</context-param>
	
	        <!-- ControlCenter Listener Start -->
        <listener>
                <listener-class>gtworks.fundamental.GTWorksStartUp</listener-class>
        </listener>
        <listener>
                <listener-class>gtworks.service.session.GTWorksListener</listener-class>
        </listener>
        <!-- ControlCenter Listener End -->
        
	<listener>
		<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
	</listener>
 	<listener>
		<listener-class>org.springframework.security.web.session.HttpSessionEventPublisher</listener-class>
	</listener>

 <!-- ControlCenter Servlet Start -->
        <servlet>
                <servlet-name>GTWorksServlet</servlet-name>
                <servlet-class>gtworks.service.session.GTWorksServlet</servlet-class>
                <init-param>
                        <param-name>enabledForExtensions</param-name>
                        <param-value>true</param-value>
                </init-param>
                <load-on-startup>1</load-on-startup>
        </servlet>

        <servlet-mapping>
                <servlet-name>GTWorksServlet</servlet-name>
                <url-pattern>/GTWorksServlet</url-pattern>
        </servlet-mapping>
        <!-- ControlCenter Servlet End -->


	<servlet>
		<servlet-name>springMVC</servlet-name>
		<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
		<init-param>
			<param-name>contextConfigLocation</param-name>
			<param-value>
				/WEB-INF/config/web/mvc-context.xml
			</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>springMVC</servlet-name>
		<url-pattern>*.do</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>jsp</servlet-name>
		<servlet-class>org.apache.jasper.servlet.JspServlet</servlet-class>
	<!--
		<init-param>
			<param-name>fork</param-name>
			<param-value>false</param-value>
		</init-param>
		<init-param>
			<param-name>xpoweredBy</param-name>
			<param-value>false</param-value>
		</init-param>
	-->	
		<init-param>
			<param-name>mappedfile</param-name>
			<param-value>false</param-value>
		</init-param>
	</servlet>	

	<!-- jdbc DataSource -->
 	<resource-ref>
		<description>MRO DataSource</description>
		<res-ref-name>oraclePool</res-ref-name>
		<res-type>javax.sql.DataSource</res-type>
		<res-auth>Container</res-auth>
	</resource-ref>

	<error-page>
		<error-code>401</error-code>
		<location>/error/error.do</location>
	</error-page>
	<error-page>
		<error-code>403</error-code>
		<location>/error/notFound.do</location>
	</error-page>
	<error-page>
		<error-code>404</error-code>
		<location>/error/notFound.do</location>
	</error-page>
	<error-page>
		<error-code>500</error-code>
		<location>/error/error.do</location>
	</error-page>

	<jsp-config>
		<taglib>
			<taglib-uri>
				/WEB-INF/tld/commonUtil.tld
			</taglib-uri>
			<taglib-location>
				/WEB-INF/tld/commonUtil.tld
			</taglib-location>
		</taglib>
	</jsp-config>
</web-app>

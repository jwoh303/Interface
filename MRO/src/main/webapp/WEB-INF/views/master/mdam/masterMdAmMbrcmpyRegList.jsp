<script type="text/javascript">
var popupSel = "";
// 기능함수
function doAction(str) {
	switch (str) {
		case "buyer":	 // 고객회원사 등록하기
			if (	CheckAgreement(str)) {
				$('#contentForm').attr("action", "<%=httpsurl%>/mdam/showMasterMdAmBuyerMbrcmpyReg.do").submit();
			}
			break;
		case "seller":	// 협력회원사 등록하기
			if (	CheckAgreement(str)) {
				$('#contentForm').attr("action", "<%=httpsurl%>/mdam/showMasterMdAmSellerMbrcmpyReg.do").submit();
			}
			break;
		case "user": // 사용자 등록하기
			if (	CheckAgreement(str)) {
				$('#contentForm').attr("action", "<%=httpsurl%>/mdam/showMasterMdAmUserReg.do").submit();
			}
			break;
		case "disagree":
			alert("미동의 시 진행이 불가능합니다.");
			break;
	}
}
 

// 팝업함수호출
function doPop(str) {
	popupSel = str;
	
	switch (str) {
		case "company": // 고객사 M
			openSearchPopup("/common/comCodePop.do","?flag=00", "600,500,no");
			break;
	}
}

//콜백함수(파일명은 모두 동일)
function setPopupReturn(code, text) {
	
	//팝업 조회후 해당 항목에 값을 셋팅
	if (popupSel == "company") {	// 다중 고객사
		$("#com_code").val(code);
		$("#com_name").val(text);
	}
	grbRow="";	//초기화
}

function CheckAgreement(selecedType) {
	
	if (($("#kepagree").is(":checked") == true) && ($("#infoDeflAgree").is(":checked") == true) && 
			($("#infoOptiAgree").is(":checked") == true || $("#infoOptiDisagree").is(":checked") == true)){
		if (selecedType == "user") {

			if (isEmpty($("#com_code").val())) {
				alert("회원사 등록유무를 확인하여 주십시요.");
				return false;
			}
		}
	} else {
		alert("각 이용약관 동의여부를 확인하여 주십시요.");
		return false;
	}
	return true;
}
</script>

<%@ page language="java" contentType="text/html; charset=utf-8" pageEncoding="utf-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page import="com.koreab2b.mro.manager.login.domain.SessionInfo"%>
<%@ page import="com.koreab2b.mro.util.CommonUtil"%>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<title>코리아 e 플랫폼</title>
<link rel="stylesheet" href="/resources/styles/base.css" type="text/css" />
<% 
	//response.setHeader("Cache-Control","no-store");
	//response.setDateHeader ("Expires", 0);
	//response.setHeader("Pragma","no-cache");

	SessionInfo _sessionInfo = (SessionInfo) request.getSession().getAttribute("sessionInfo");
	String _closeImgSrc = "";
	if(_sessionInfo != null){
		String comType = (String)_sessionInfo.getBusinessCond();
		if(!"".equals(comType) &&  "M".equals(comType)){ 
	%>
		<% _closeImgSrc = "m_btn_popclose.gif";   %> 
		<link rel="stylesheet" href="/resources/styles/master_layout.css" type="text/css" /> 
		<link rel="stylesheet" type="text/css" media="screen"	href="/resources/libs/jquery/css/redmond/jquery-ui.min.css"/>   
	<% }else if("S".equals(comType)){   %>
		<c:if test="${param.moveToMaster ne 'Y' }">
			<% _closeImgSrc = "s_btn_popclose.gif";   %>
			<link rel="stylesheet" href="/resources/styles/seller_layout.css" type="text/css" />
			<link rel="stylesheet" type="text/css" media="screen"	href="/resources/libs/jquery/css/sunny/jquery-ui.min.css"/>   
		</c:if>
		<c:if test="${param.moveToMaster eq 'Y' }">
			<% _closeImgSrc = "m_btn_popclose.gif";   %>
			<link rel="stylesheet" href="/resources/styles/master_layout.css" type="text/css" /> 
			<link rel="stylesheet" type="text/css" media="screen"	href="/resources/libs/jquery/css/redmond/jquery-ui.min.css"/>   
		</c:if>
	<% }else if("E".equals(comType)){   %>
		<% _closeImgSrc = "m_btn_popclose.gif";   %>
		<link rel="stylesheet" href="/resources/styles/master_layout.css" type="text/css" /> 
		<link rel="stylesheet" type="text/css" media="screen"	href="/resources/libs/jquery/css/redmond/jquery-ui.min.css"/>	
	<% } else { %>
		<% _closeImgSrc = "b_btn_popclose.gif";   %>
		<link rel="stylesheet" href="/resources/styles/buyer_layout.css" type="text/css" />
		<link rel="stylesheet" type="text/css" media="screen"	href="/resources/libs/jquery/css/smoothness/jquery-ui.min.css"/>   
	<% } 
	} else {
		String popCssType = CommonUtil.nvl((String) request.getParameter("pop_css_type"),"B");
		
		if(!"".equals(popCssType) &&  "B".equals(popCssType)){ 
%>
			<% _closeImgSrc = "b_btn_popclose.gif";   %>
			<link rel="stylesheet" href="/resources/styles/buyer_layout.css" type="text/css" />
			<link rel="stylesheet" type="text/css" media="screen"	href="/resources/libs/jquery/css/smoothness/jquery-ui.min.css"/>   
<%
		}else if(!"".equals(popCssType) &&  "S".equals(popCssType)){ 
%>
			<% _closeImgSrc = "s_btn_popclose.gif";   %>
			<link rel="stylesheet" href="/resources/styles/seller_layout.css" type="text/css" />
			<link rel="stylesheet" type="text/css" media="screen"	href="/resources/libs/jquery/css/sunny/jquery-ui.min.css"/>
<%
		}else if(!"".equals(popCssType) &&  "M".equals(popCssType)){
%>
			<% _closeImgSrc = "m_btn_popclose.gif";   %>
			<link rel="stylesheet" href="/resources/styles/master_layout.css" type="text/css" /> 
			<link rel="stylesheet" type="text/css" media="screen"	href="/resources/libs/jquery/css/redmond/jquery-ui.min.css"/>
<%
		}
	}

%>
<div id="confirmAreaDiv"   style="display:none;">
   <div  style="position:absolute; left:50%; margin-left:-300px; top:250px; width: 400px; height:100px; text-align:center; background-color: #fff;  z-index:999;  border: 0px; padding:50px 0;">
   	<div style="font-size:14px;" id="confirmMsgDiv"></div>
 		<!-- 버튼영역 -->
		<div style="text-align:center; margin-top:40px"> 
				<span class="btn_04">
					<a href="javascript:confirmAreaDivSearch();">확인</a>
				</span>	
				<span class="btn_04">
					<a href="javascript:cancleAreaDivSearch();">취소</a>
				</span>
			</div>					
         </div>
    	<div style="position:absolute; top:0; width:100%; height:100%; display:table-cell; background-color:#03F; z-index:99; background-color:#000; opacity: 0.4;   "></div>
</div>
<script type="text/javascript">
var g_confirm_type = "";// confirm 후처리 타입.
//Confirm창 취소처리
function cancleAreaDivSearch(){ 
	$("#confirmAreaDiv").hide(); 
}
</script>
<script src="/resources/libs/jquery/js/jquery.min.js" type="text/javascript"></script>
<script src="/resources/libs/jquery/js/jquery-ui.min.js" type="text/javascript"></script>
<!-- 세션 정보를 JavaScript 전역 변수로 전달 -->
<script type="text/javascript">
    // 전역 세션 정보 객체
    window.SESSION_INFO = {
        uiVersion: "<%= request.getSession().getAttribute("uiVersion") != null ? request.getSession().getAttribute("uiVersion") : "" %>"
    };
    console.log("[JSP] <%= request.getServletPath() %>");
</script>
<script src="/resources/js/kep_common.js"></script> 

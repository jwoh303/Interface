    };
    console.log("[JSP] <%= request.getServletPath() %>");
    
    //뒤로가기 등 하게 되면 강제 새로고침
    window.addEventListener('pageshow', function(event) {
    	  if (event.persisted) {
    	    location.reload();
    	  }
    	});
</script>


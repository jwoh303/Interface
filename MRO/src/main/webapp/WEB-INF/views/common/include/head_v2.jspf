var layerPopupOpenFlag1 = true;
var layerPopupOpenFlag2 = true;
var layerPopupOpenFlag3 = true;
var layerPopText;

function closePop(){
	const frame = document.getElementById("LayerPopFrame");
	  frame.src="about:blank";
	  frame.remove();
	  layerPopupOpenFlag1 = true;
	openLayerPopup.style.display = "none";
	LayerPopOverlay.style.display = "none";
}
function closePop2(){
	const frame = document.getElementById("LayerPopFrame2");
	  frame.src="about:blank";
	  frame.remove();
	  layerPopupOpenFlag2 = true;
	openLayerPopup2.style.display = "none";
	LayerPopOverlay2.style.display = "none";
}

function closePop3(){
	const frame = document.getElementById("LayerPopFrame3");
	  frame.src="about:blank";
	  frame.remove();
	
	//input들 다 날리기
	  const inputs = divLayerPopForm.querySelectorAll("input");
	  inputs.forEach(function(input){input.remove();});
	  
	  layerPopupOpenFlag3 = true;
	openLayerPopup5.style.display = "none";
	LayerPopOverlay5.style.display = "none";
}
function closePopText1(){
	openLayerPopup3.style.display = "none";
    LayerPopOverlay3.style.display = "none";
}
function closePopText2(){
	openLayerPopup4.style.display = "none";
    LayerPopOverlay4.style.display = "none";
    layerPopText = false;
}

function closePopText3(){
	openLayerPopup6.style.display = "none";
    LayerPopOverlay6.style.display = "none";
}
function openLayerPop(src,width,height){

	if(!layerPopupOpenFlag1) return;

	if (window.KepPopupBroker) src = KepPopupBroker.appendToken(src, KepPopupBroker.issue());

	layerPopupOpenFlag1 = false;
	const frame = document.createElement("iframe");
	frame.id="LayerPopFrame";
	frame.src = src;
    frame.style.width=width;
    frame.style.height=height;
    frame.style.border="0px solid #ccc";
    divLayerPopContent.appendChild(frame);
    frame.onload = function(){
	    openLayerPopup.style.display = "block";
    	LayerPopOverlay.style.display = "block";
    }
}
function openLayerPop2(src,width,height){
	if(!layerPopupOpenFlag2) return;

	if (window.KepPopupBroker) src = KepPopupBroker.appendToken(src, KepPopupBroker.issue());

	layerPopupOpenFlag2 = false;
	const frame = document.createElement("iframe");
	frame.id="LayerPopFrame2";
	frame.src = src;
    frame.style.width=width;
    frame.style.height=height;
    frame.style.border="0px solid #ccc";
    divLayerPopContent2.appendChild(frame);
    frame.onload = function(){
	    openLayerPopup2.style.display = "block";
    	LayerPopOverlay2.style.display = "block";
    }
}
function openLayerPop3(url,param,params,width,height){

	if(!layerPopupOpenFlag3) return;

	layerPopupOpenFlag3 = false;
	const frame = document.createElement("iframe");
	frame.id="LayerPopFrame3";
	frame.name="LayerPopFrame3";
    frame.style.width=width;
    frame.style.height=height;
    frame.style.border="0px solid #ccc";
    divLayerPopContent3.appendChild(frame);
    
    divLayerPopForm.action = window.KepPopupBroker
		? KepPopupBroker.appendToken(url, KepPopupBroker.issue())
		: url;
	divLayerPopForm.target = "LayerPopFrame3";
	if(param != ""){ //json형식으로 만든 데이터
		var input = document.createElement("input");
		input.type = "hidden";
		input.name = "layerPopInfo";
		input.id="layerPopInfo";
		input.value = param;
		divLayerPopForm.appendChild(input);
// 		$("#layerPopInfo").val(param);
	}
	if(params != ""){
		for(var key in params){
			var input = document.createElement("input");
			input.type = "hidden";
			input.name = key;
			input.value = params[key];
			divLayerPopForm.appendChild(input);
		}
	}
	
    frame.onload = function(){
	    openLayerPopup5.style.display = "block";
    	LayerPopOverlay5.style.display = "block";
    	frame.contentWindow.init(); //팝업에 최초 실행함수명 init함수가 있어야됨
    	
    }
    
    divLayerPopForm.submit();
}
function openLayerPopText(text,but1Text,but2Text,but1Func,but2Func,but1Width,but2Width){
	const but1 = document.getElementById("LayerPopupBut1");
	const but2 = document.getElementById("LayerPopupBut2");
	var DivLayerPopupText = document.getElementById("DivLayerPopupText1");
	DivLayerPopupText.innerHTML = text;
// 	$("#DivLayerPopupText1").html(text);
	var tmp = document.createElement("span");
	tmp.style.visibility = "hidden";
	tmp.style.whiteSpace = "nowrap";
	tmp.innerText = text;
	
	document.body.appendChild(tmp);
	var widthTmp = tmp.offsetWidth + 50;
	document.body.removeChild(tmp);
	
	DivLayerPopupText.style.width=widthTmp
	but1.textContent=but1Text;
	but2.textContent=but2Text;
	but1.setAttribute("onclick",but1Func);
	but2.setAttribute("onclick",but2Func);
	but1.style.width=but1Width;
	but2.style.width=but2Width;
    openLayerPopup3.style.display = "block";
    LayerPopOverlay3.style.display = "block";
}
function openLayerPopText2(text,but1Text,but1Func,but1Width){
	const but1 = document.getElementById("LayerPopupBut3");
	var DivLayerPopupText = document.getElementById("DivLayerPopupText2");
	DivLayerPopupText.innerHTML = text;
// 	$("#DivLayerPopupText2").html(text);

	var tmp = document.createElement("span");
	tmp.style.visibility = "hidden";
	tmp.style.whiteSpace = "nowrap";
	tmp.innerText = text;

	document.body.appendChild(tmp);
	var widthTmp = tmp.offsetWidth + 50;
	document.body.removeChild(tmp);

	DivLayerPopupText.style.width=widthTmp+"px";
	but1.textContent=but1Text;
	but1.setAttribute("onclick",but1Func);
	but1.style.width=but1Width;
    openLayerPopup4.style.display = "block";
    LayerPopOverlay4.style.display = "block";
    layerPopText = true;
}

function openLayerPopText3(text,content,but1Text,but2Text,but3Text,but1Func,but2Func,but3Func,but1Width,but2Width,but3Width){
	const but1 = document.getElementById("LayerPopupBut4");
	const but2 = document.getElementById("LayerPopupBut5");
	const but3 = document.getElementById("LayerPopupBut6");
	var DivLayerPopupText = document.getElementById("DivLayerPopupText6");
	DivLayerPopupText.innerHTML = text;
	var DivLayerPopupContent = document.getElementById("DivLayerPopupContent6");
	DivLayerPopupContent.innerHTML = content;
	
	var tmp = document.createElement("span");
	tmp.style.visibility = "hidden";
	tmp.style.whiteSpace = "nowrap";
	tmp.innerText = text;

	document.body.appendChild(tmp);
	var widthTmp = tmp.offsetWidth + 50;
	document.body.removeChild(tmp);

	DivLayerPopupText.style.width=widthTmp+"px";
	but1.textContent=but1Text;
	but2.textContent=but2Text;
	but3.textContent=but3Text;
	but1.setAttribute("onclick",but1Func);
	but2.setAttribute("onclick",but2Func);
	but3.setAttribute("onclick",but3Func);
	but1.style.width=but1Width;
	but2.style.width=but2Width;
	but3.style.width=but3Width;	
    openLayerPopup6.style.display = "block";
    LayerPopOverlay6.style.display = "block";
    layerPopText = true;
}
// ==============================================
// 디스플레이 배율(OS 배율 × 브라우저 줌) 대응 - IBSheet 좌표 보정
// 문서 전체를 1/dpr 로 축소해 배율을 상쇄, 배율/크기 변경 시마다 재적용
// ==============================================
(function() {
    function getTopWin() {
        try {
            if (window.top && window.top.document) return window.top;
        } catch (e) { /* cross-origin iframe */ }
        return window;
    }

    // dpr은 zoom 적용 전 최초 1회만 측정해 캐시 (iframe이 top의 CSS zoom에 스케일되면
    // dpr 측정값이 흔들려 오실레이션이 생기므로 재측정하지 않는다)
    function getBaseDpr(topWin) {
        if (!topWin._baseDpr) topWin._baseDpr = window.devicePixelRatio || 1;
        return topWin._baseDpr;
    }

    function applyHighDpiZoom() {
        var topWin = getTopWin();
        var dpr = getBaseDpr(topWin);
        // 축소(zoom<=1)만 적용하고 확대는 절대 걸지 않는다.
        // dpr<1 (브라우저 축소 등) 이면 1/dpr 이 1보다 커지는데, zoom>1 상태에서
        // IBSheet Render() 를 호출하면 그리드 세로 레이아웃이 폭주한다
        // (zoom 1.25 에서 scrollHeight 500 -> 24449 확인, zoom-1 에 비례해 증가).
        // dpr<1 은 상쇄할 고배율이 없는 경우라 보정 자체가 불필요하다.
        var zoom = (dpr <= 1.02) ? '' : (Math.round(1000 / dpr) / 1000);
        try {
            topWin.document.documentElement.style.zoom = zoom;
        } catch (e) {
            document.documentElement.style.zoom = zoom;
        }
        refreshAllIBSheets();
    }

    applyHighDpiZoom();
    window.addEventListener('load', function() {
        setTimeout(applyHighDpiZoom, 300);
    });

    if (!getTopWin()._highDpiHandlerBound) {
        var t;
        var schedule = function() { clearTimeout(t); t = setTimeout(applyHighDpiZoom, 200); };
        window.addEventListener('resize', schedule);
        getTopWin()._highDpiHandlerBound = true;
    }
})();

// 모든 IBSheet 객체 갱신 함수
function refreshAllIBSheets() {
    console.log('[HighDPI] IBSheet 갱신 시작');
    var refreshedCount = 0;

    for (var key in window) {
        try {
            var obj = window[key];
            // IBSheet 객체 확인 (FitColWidth 메서드 존재 여부로 판단)
            if (obj && typeof obj === 'object' && typeof obj.FitColWidth === 'function') {
                console.log('[HighDPI] IBSheet 발견:', key);

                // 숨겨진(0x0) 시트는 건너뛴다.
                // display:none 상태에서 Render() 를 호출하면 IBSheet 가 내부 page 섹션을
                // 교체하지 않고 누적해, 탭 전환 시 헤더/푸터가 여러 벌 겹쳐 보인다.
                // (탭 화면에서 호출당 table +6 / DBPage div +4 씩 증가하는 것을 확인)
                var mainTag = obj.MainTag;
                if (!mainTag || !mainTag.offsetWidth || !mainTag.offsetHeight) {
                    console.log('[HighDPI] 숨김 상태 - 갱신 생략:', key);
                    continue;
                }

                // 렌더링 갱신 시도
                if (typeof obj.Render === 'function') {
                    obj.Render();
                } else if (typeof obj.ReDraw === 'function') {
                    obj.ReDraw();
                }

                refreshedCount++;
            }
        } catch(e) {
            // 접근 불가한 속성 무시
        }
    }

    console.log('[HighDPI] IBSheet 갱신 완료:', refreshedCount, '개');
}

document.addEventListener("keydown",function(e){
	if(!layerPopText) return; //layerPopText2() 열려있는지 체크
	
	if(e.key === " " || e.key === "Enter"){
		e.preventDefault();
		const but1 = document.getElementById("LayerPopupBut3");
		but1.click();
// 		closePopText2();
	}
})

</script>

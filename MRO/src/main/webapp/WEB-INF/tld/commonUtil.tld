<?xml version="1.0" encoding="euc-kr"?>
<taglib version="2.1" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd">
	<tlib-version>1.0</tlib-version>
	<short-name>cu</short-name>
	<uri>/WEB-INF/tld</uri>
	<function>
		<name>formatStrinigDate</name>
		<function-class>com.koreab2b.mro.util.CommonUtil</function-class>
		<function-signature>
			java.lang.String formatStrinigDate(java.lang.Object)
		</function-signature>
	</function>
	<function>
		<name>formatNumber</name>
		<function-class>com.koreab2b.mro.util.CommonUtil</function-class>
		<function-signature>
			java.lang.String formatNumber(Object pNumber, java.lang.Boolean group_b, java.lang.Integer pre, java.lang.Integer post, java.lang.Boolean percent)
		</function-signature>
	</function>
	<function>
		<name>getPageView</name>
		<function-class>com.koreab2b.mro.util.CommonUtil</function-class>
		<function-signature>
			java.lang.String getPageView(java.lang.String, java.lang.Integer, java.lang.String, java.lang.String)
		</function-signature>
	</function>
</taglib>
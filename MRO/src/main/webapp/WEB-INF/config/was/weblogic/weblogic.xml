<?xml version='1.0' encoding='utf-8'?>
<weblogic-web-app xmlns="http://www.bea.com/ns/weblogic/90" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <weblogic-version>10.3.6</weblogic-version>

    <context-root>/</context-root>

    <jsp-descriptor>
        <page-check-seconds>10</page-check-seconds>
        <verbose>true</verbose>
        <keepgenerated>false</keepgenerated>
        <package-prefix>mro</package-prefix>
        <precompile>true</precompile>
        <precompile-continue>true</precompile-continue>
        <encoding>utf-8</encoding>
        <working-dir>/webContents/work/mro_jsp_servlet</working-dir>
        <backward-compatible>true</backward-compatible>
        <print-nulls>false</print-nulls>
    </jsp-descriptor>

    <session-descriptor>
        <id-length>52</id-length>
        <cookie-comment>WebLogic Server Session Tracking Cookie</cookie-comment>
        <cookie-max-age-secs>-1</cookie-max-age-secs>
        <cookie-name>JSESSIONID</cookie-name>
        <invalidation-interval-secs>60</invalidation-interval-secs>
        <persistent-store-type>replicated_if_clustered</persistent-store-type>
        <cookies-enabled>true</cookies-enabled>
        <tracking-enabled>true</tracking-enabled>
        <timeout-secs>3600</timeout-secs>
    </session-descriptor>

    <container-descriptor>
        <servlet-reload-check-secs>-1</servlet-reload-check-secs>
        <session-monitoring-enabled>false</session-monitoring-enabled>
        <prefer-web-inf-classes>false</prefer-web-inf-classes>
        <resource-reload-check-secs>-1</resource-reload-check-secs>
    </container-descriptor>

    <charset-params>
     <input-charset>
        <resource-path>/*</resource-path>
        <java-charset-name>utf-8</java-charset-name>
     </input-charset>
    </charset-params>
</weblogic-web-app>

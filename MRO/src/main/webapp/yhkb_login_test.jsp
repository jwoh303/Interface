<script type="text/javascript">

//기능함수
function doAction(str) {
	
	switch (str) {
	case "user":	 // 사용자 등록
		var buyer = $("#select_buyer").val();
		if(buyer == 'X') {
			alert("등록할 사업장을 선택하여 주십시요.");
			return false;
		}
 		$("#st_buyer").val(buyer);
		if($("#kepagree").is(":checked") == true && $("#infoDeflAgree").is(":checked") == true) {
			
		}else {
				alert("각 이용약관 동의여부를 확인하여 주십시요.");
				return false;
		}
		if (!confirm('등록하시겠습니까?')) {
			return;
		}
		kepAjaxFormCallAsync("/mpso/createLoginForYHKB.do","submitform","save");		
		break;
		
	}
}



function kepAjaxFormCallAsync(pUrl,pForm,pMethod) {    
	loader_obj("Y");
	$.ajax({
		      type: "POST",
		      dataType:"json",
		      url: pUrl,
		      headers: { 'X-Requested-With': 'XMLHttpRequest' },
		      data: $("#"+pForm+"").serialize(),
		      timeout: 600000, //milisecond기준 10분(600000ms) TIMEOUT
		      async: false,
		      success:function( response ) {  	
		    	 loader_obj("N");
		    	 if(typeof response.Message != 'undefined'){
		    		 kepAjaxError(pMethod , response); // 화면에 필수적으로 있어여한다. (Exception 발생)
		    		 return;
		    	} 
		    	 kepAjaxSuccess(pMethod , response); // 화면에 필수적으로 있어여한다.
			   },
			   error:function( response, textStatus) {
				   	loader_obj("N");
				   	if(textStatus == 'timeout'){
				   		response.Message = "응답시간이 초과되었습니다. 잠시 후 다시 이용해주세요.";
				   	} 				   	
				 	//403코드 리턴(로그인 세션 없음)시는  sub_login페이지로 redirect
								  
				kepAjaxError(pMethod , response); // 화면에 필수적으로 있어여한다.
			   }
		});  
}
//ajax 공통 호출후 성공시 처리 함수
function kepAjaxSuccess(pMethod , response) {	
	if(response.resultCode =="OK") {
		location.href=response.URL;		
	}	
}


//ajax 공통 호출후 실패시 처리 함수
function kepAjaxError(pMethod, response) {
	alert("제출 실패하였습니다.\n관리자에게 문의바랍니다.");
}

</script>

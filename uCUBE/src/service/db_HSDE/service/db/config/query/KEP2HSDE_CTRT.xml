<SQL>
        <SQL_DOC INTERFACE_ID="KEP2HSDE_CTRT">
                <P_SQL SEQ="1" TYPE="INSERT" POST_SQL="FALSE">
                <![CDATA[

                        DECLARE
                                V_COUNT                         NUMBER;
                                
                        BEGIN
                        
                            BEGIN     
                                V_COUNT                         := 0;
                                SELECT COUNT(*) INTO V_COUNT
                                FROM UCUBE.T02_KEP_UNITCOST
                                WHERE 1=1
                                AND INTERFACE_ID  = $INTERFACE_ID$;
                                
                            EXCEPTION
                                    WHEN OTHERS THEN
                                         V_COUNT := 0;
                            END;                  

                            IF V_COUNT=0 THEN
                                
                                BEGIN
                                INSERT INTO UCUBE.T02_KEP_UNITCOST (
                                             INTERFACE_ID
                                            ,ITEMCODE
                                            ,KEPCODE
                                            ,UNITPRICE
                                            ,SUPPLIERID
                                            ,MAKER
                                            ,CONTRACTYEAR
                                            ,ITEMNAME
                                            ,UNITTYPE
                                            ,SPEC
                                            ,REMARK
                                            ,DELIVERYDATE
                                            ,CATE1
                                            ,CATE2
                                            ,CATE3
                                            ,CATE4
                                            ,MADEIN
                                            ,PROCESS_CODE
                                            ,ERROR_MESSAGE
                                            ,INTERFACE_DATE
                                            ,IF_FLAG
                                            ,STATUS )
                                VALUES(
                                             $INTERFACE_ID$
                                            ,$ITEMCODE$
                                            ,$KEPCODE$
                                            ,$UNITPRICE$
                                            ,$SUPPLIERID$
                                            ,$MAKER$
                                            ,$CONTRACTYEAR$
                                            ,$ITEMNAME$
                                            ,$UNITTYPE$
                                            ,$SPEC$
                                            ,$REMARK$
                                            ,$DELIVERYDATE$
                                            ,$CATE1$
                                            ,$CATE2$
                                            ,$CATE3$
                                            ,$CATE4$
                                            ,$MADEIN$
                                            ,$PROCESS_CODE$
                                            ,$ERROR_MESSAGE$
                                            ,SYSDATE
                                            ,'N'
                                            ,$STATUS$ );
                            EXCEPTION
                                    WHEN OTHERS THEN
                                         V_COUNT := 0;
                            END;

                                END IF;
                        END;

                ]]>
                <C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
                        <![CDATA[]]>
                </C_SQL>
                <C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">
                        <![CDATA[]]>
                </C_SQL>
                </P_SQL>
        </SQL_DOC>

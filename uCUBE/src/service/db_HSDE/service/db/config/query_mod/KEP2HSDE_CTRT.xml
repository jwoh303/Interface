<SQL>
	<SQL_DOC INTERFACE_ID="KEP2HSDE_CTRT">
		<P_SQL SEQ="1" TYPE="INSERT" POST_SQL="FALSE">
		<![CDATA[

			DECLARE

				V_COUNT				NUMBER;

			BEGIN

				V_COUNT				:= 0;

				SELECT COUNT(*) INTO V_COUNT
				FROM UCUBE.T02_KEP_PUM
				WHERE 1=1
				AND INTERFACE_ID  = '$INTERFACE_ID$';
				
				IF V_COUNT=0 THEN

					INSERT INTO UCUBE.XOIF_PUR_REQ(
                           INTERFACE_ID
                          ,PUMCODE
                          ,PUMLINE
                          ,REQCODE
                          ,REQLINE
                          ,ITEMCODE
                          ,KEPCODE
                          ,ITEMNAME
                          ,NORM
                          ,MAT
                          ,UNITTYPE
                          ,PUMQTY
                          ,PRICE
                          ,UNITPRICE
                          ,MAKER
                          ,REQEMPID
                          ,REQORG
                          ,REQWAREHOUSE
                          ,EMAIL
                          ,PROCESS_CODE
                          ,ERROR_MESSAGE
                          ,INTERFACE_DATE
                          ,DETAILSPEC
                          ,REMARK
                          ,IF_FLAG
                          ,REQEMPNAME
					)VALUES(
                           $INTERFACE_ID$
                          ,$PUMCODE$
                          ,$PUMLINE$
                          ,$REQCODE$
                          ,$REQLINE$
                          ,$ITEMCODE$
                          ,$KEPCODE$
                          ,$ITEMNAME$
                          ,$NORM$
                          ,$MAT$
                          ,$UNITTYPE$
                          ,$PUMQTY$
                          ,$PRICE$
                          ,$UNITPRICE$
                          ,$MAKER$
                          ,$REQEMPID$
                          ,$REQORG$
                          ,$REQWAREHOUSE$
                          ,$EMAIL$
                          ,$PROCESS_CODE$
                          ,$ERROR_MESSAGE$
                          ,sysdate
                          ,$DETAILSPEC$
                          ,$REMARK$
                          ,'N'
                          ,$REQEMPNAME$
					);
  				END IF;       
			END;

		]]>
		<C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
			<![CDATA[]]>
		</C_SQL>
		<C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">
			<![CDATA[]]>
		</C_SQL>
		</P_SQL>

<?xml version="1.0" encoding="EUC-KR"?>
<SQL>
	<SQL_DOC INTERFACE_ID="KEP2DMTR_RT">
		<P_SQL SEQ="1" TYPE="INSERT" POST_SQL="FALSE">
		<![CDATA[
                  DECLARE V_CNT NUMBER;
                  
                  BEGIN
                    SELECT COUNT(*) 
                      INTO V_CNT
                      FROM STX_MRO_QTA_HEADER@STXMFG
                     WHERE 1 = 1
                       AND COMPANY_CODE  = $COMPANY_CODE$
                       AND DIVISION_CODE = $DIVISION_CODE$
                       AND IF_HEADER_ID  = $IF_HEADER_ID$
                     ;

                    IF V_CNT = 0 THEN
                      INSERT INTO STX_MRO_QTA_HEADER@STXMFG
                        COMPANY_CODE,
                        DIVISION_CODE,
                        IF_HEADER_ID,
                        RFQ_NO,
                        QTA_NO,
                        QTA_DATE,
                        QTA_ADD_USER_NAME,
                        QTA_REMARK,
                        PAY_TERMS,
                        DELY_TERMS,
                        CUR,
                        QTA_AMT,
                        IF_DATE,
                        IF_FLAG,
                        IF_STATUS,
                        IF_RECV_DATE,
                        QTA_IF_DATETIME,
                        QTA_IF_FLAG,
                        QTA_NO_BUYER,
                        QTA_IF_RECV_DATE,
                        IF_SYSTEM_ID,
                        RFQ_PO_HEADER_ID,
                        RFQ_TYPE_LOOKUP_CODE,
                        QTA_PO_HEADER_ID,
                        QTA_TYPE_LOOKUP_CODE
                      ) VALUES (
                        $COMPANY_CODE$,
                        $DIVISION_CODE$,
                        $IF_HEADER_ID$,
                        $RFQ_NO$,
                        $QTA_NO$,
                        $QTA_DATE$,
                        $QTA_ADD_USER_NAME$,
                        $QTA_REMARK$,
                        $PAY_TERMS$,
                        $DELY_TERMS$,
                        $CUR$,
                        $QTA_AMT$,
                        SYSDATE,
                        'N',
                        $STATUS$,
                        $IF_RECV_DATE$,
                        $QTA_IF_DATETIME$,
                        $QTA_IF_FLAG$,
                        $QTA_NO_BUYER$,
                        $QTA_IF_RECV_DATE$,
                        $IF_SYSTEM_ID$,
                        $RFQ_PO_HEADER_ID$,
                        $RFQ_TYPE_LOOKUP_CODE$,
                        $QTA_PO_HEADER_ID$,
                        $QTA_TYPE_LOOKUP_CODE$
                      );
                    ELSE
                      UPDATE STX_MRO_QTA_HEADER@STXMFG SET
                             IF_FLAG = 'N'
                       WHERE 1 = 1
                         AND COMPANY_CODE  = $COMPANY_CODE$
                         AND DIVISION_CODE = $DIVISION_CODE$
                         AND IF_HEADER_ID  = $IF_HEADER_ID$
                       ;
                    END IF;

                    INSERT INTO STX_MRO_QTA_LINE@STXMFG (
                      COMPANY_CODE,
                      DIVISION_CODE,
                      IF_HEADER_ID,
                      IF_DETAIL_ID,
                      RFQ_NO,
                      QTA_NO,
                      RFQ_SEQ,
                      ITEM_NO,
                      DESCRIPTION_LOC,
                      UNIT_MEASURE,
                      QTA_QTY,
                      QTA_PRICE,
                      QTA_AMT,
                      QTA_REMARK_DETAIL,
                      QTA_DELIVERY_DATE,
                      IF_DATE,
                      IF_FLAG,
                      IF_STATUS,
                      IF_RECV_DATE,
                      IF_SYSTEM_ID,
                      RFQ_PO_HEADER_ID,
                      RFQ_TYPE_LOOKUP_CODE,
                      RFQ_PO_LINE_ID,
                      RFQ_PO_LINE_LOCATION_ID,
                      RFQ_SHIPMENT_NUM,
                      RFQ_ITEM_ID,
                      QTA_PO_HEADER_ID,
                      QTA_TYPE_LOOKUP_CODE,
                      QTA_SEQ,
                      QTA_PO_LINE_ID,
                      QTA_PO_LINE_LOCATION_ID,
                      QTA_SHIPMENT_NUM,
                      QTA_ITEM_ID,
                      RFQ_PROJECT_ID
                    ) VALUES (
                      $COMPANY_CODE$,
                      $DIVISION_CODE$,
                      $IF_HEADER_ID$,
                      $IF_DETAIL_ID$,
                      $RFQ_NO$,
                      $QTA_NO$,
                      $RFQ_SEQ$,
                      $ITEM_NO$,
                      $DESCRIPTION_LOC$,
                      $UNIT_MEASURE$,
                      $QTA_QTY$,
                      $QTA_PRICE$,
                      $.QTA_AMT$,
                      $QTA_REMARK_DETAIL$,
                      $QTA_DELIVERY_DATE$,
                      SYSDATE,
                      'N',
                      $STATUS$,
                      $IF_RECV_DATE$,
                      $IF_SYSTEM_ID$,
                      $RFQ_PO_HEADER_ID$,
                      $RFQ_TYPE_LOOKUP_CODE$,
                      $RFQ_PO_LINE_ID$,
                      $RFQ_PO_LINE_LOCATION_ID$,
                      $RFQ_SHIPMENT_NUM$,
                      $RFQ_ITEM_ID$,
                      $QTA_PO_HEADER_ID$,
                      $QTA_TYPE_LOOKUP_CODE$,
                      $QTA_SEQ$,
                      $QTA_PO_LINE_ID$,
                      $QTA_PO_LINE_LOCATION_ID$,
                      $QTA_SHIPMENT_NUM$,
                      $QTA_ITEM_ID$,
                      $RFQ_PROJECT_ID$
                    );

                  END;
                  a
		]]>
		<C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
			<![CDATA[]]>
		</C_SQL>
		<C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">
			<![CDATA[]]>
		</C_SQL>
		</P_SQL>
	</SQL_DOC>
	<RETRY_CODE>
	<CODE>3113</CODE>
	<CODE>3114</CODE>
	<CODE>2154</CODE>
	<CODE>2541</CODE>
	<CODE>4068</CODE>
	</RETRY_CODE>
</SQL>

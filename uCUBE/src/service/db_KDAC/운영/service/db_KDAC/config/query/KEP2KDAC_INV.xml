<?xml version="1.0" encoding="EUC-KR"?>
<SQL>
	<SQL_DOC INTERFACE_ID="KEP2KDAC_INV">
		<P_SQL SEQ="1" TYPE="INSERT" POST_SQL="FALSE">
		<![CDATA[

			BEGIN
				IF NOT EXISTS(  
								SELECT SLNO
								   FROM MRO507
							 	 WHERE SLNO  = $SLNO$
								     AND SRNO  = $SRNO$
								     AND SRNO1 = $SRNO1$
							 )
					BEGIN
                      INSERT INTO MRO507(
                             COMLTD
                            ,VSRNO
                            ,SLNO
                            ,SRNO
                            ,SRNO1
                            ,XPLANT
                            ,DIV
                            ,ITNO
                            ,ITNM
                            ,SPEC
                            ,MAKER
                            ,XUNIT
                            ,CLS
                            ,XTYPE
                            ,GUBUN
                            ,RQNO
                            ,EMPNO
                            ,DEPT
                            ,STDT
                            ,PRTDT
                            ,PQTY
                            ,XCOST
                            ,PURNO
                            ,PDUDT
                            ,AQTY
                            ,STCD
                            ,IFFLAG
                            ,CDFLAG 
                           )VALUES(
                              $COMLTD$
                            , $VSRNO$
                            , $SLNO$
                            , $SRNO$
                            , $SRNO1$
                            , $XPLANT$
                            , $DIV$
                            , $ITNO$
                            , $ITNM$
                            , $SPEC$
                            , ISNULL( $MAKER$ ,' ')
                            , ISNULL( $XUNIT$ ,' ')
                            , ISNULL( $CLS$ ,' ')
                            , ISNULL( $XTYPE$ , ' ')
                            , ISNULL( $GUBUN$ ,' ')
                            , ISNULL( $RQNO$ ,' ')
                            , ISNULL( $EMPNO$ ,' ')
                            , ISNULL( $DEPT$ ,' ')
                            , ISNULL( $STDT$ ,' ')
                            , ISNULL( $PRTDT$ ,' ')
                            , $PQTY$
							, $XCOST$ 
                            , $PURNO$
                            , $PDUDT$
							, $AQTY$ 
                            , ISNULL( $STCD$ ,' ')
                            , $IFFLAG$
                            , $CDFLAG$ )
					END
  
				ELSE
					BEGIN
								UPDATE MRO507
						              SET STDT =  $STDT$
						  	                ,CDFLAG = $CDFLAG$
							                ,IFFLAG   = $IFFLAG$
							   	 WHERE SLNO  =  $SLNO$
								     AND SRNO  =  $SRNO$
								     AND SRNO1 = $SRNO1$
					END
			END

		]]>
		<C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
			<![CDATA[]]>
		</C_SQL>
		<C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">
			<![CDATA[]]>
		</C_SQL>
		</P_SQL>
	</SQL_DOC>

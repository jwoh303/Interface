<?xml version="1.0" encoding="EUC-KR"?>
<!-- Sample Configuration File for Receiving Transaction Data  -->
<ADAPTER>
  	<LINKS>
   		<LINK NAME="RECV">
      			<SOURCEINFO>
        			<TYPE>SOURCE</TYPE>
			        <SOURCE_NAME>JBOSSMQ</SOURCE_NAME>
			        <SOURCE_CLASS_NAME>com.posdata.eai.adapter.jms.JMSSource</SOURCE_CLASS_NAME>
			        <QUEUE_PREFIX>queue/</QUEUE_PREFIX>
			        <!-- set system id : queue 이름  -->
			        <!--<QUEUE_NAME>METROERP</QUEUE_NAME>-->
			        <QUEUE_NAME>KEP</QUEUE_NAME>
			        <RUN_TYPE>MANUAL_LAUNCH</RUN_TYPE>
			        <DESTINATION_TYPE>UAP</DESTINATION_TYPE>
			        <!-- set entob jms system ip:port 가동계 -->
			        <JMSPROVIDER_URL>localhost:1099</JMSPROVIDER_URL>
			        <INITIAL_CONTEXT_FACTORY>org.jnp.interfaces.NamingContextFactory</INITIAL_CONTEXT_FACTORY>
			        <QUEUE_CONNECTION_FACTORY>UIL2ConnectionFactory</QUEUE_CONNECTION_FACTORY>
			        <USERNAME>guest</USERNAME>
			        <PASSWORD>guest</PASSWORD>
			        <ONMESSAGE_WAIT_TIME>10000</ONMESSAGE_WAIT_TIME>
      			</SOURCEINFO>
    		</LINK>
  	</LINKS>
  	<COMMON>
    		<EAI_BASE_DIRECTORY>${UCUBE_HOME}/service/file/</EAI_BASE_DIRECTORY>
    		<!-- set system id -->
    		<SRC_PC>SYSTEMID</SRC_PC>
    		<RECONNECT_INTERVAL>10000</RECONNECT_INTERVAL>
	    	<EVENT_QUEUE>EVENT.QUEUE</EVENT_QUEUE>
	    	<ENCODING_VALUE>EUC-KR</ENCODING_VALUE>
	    	<ENABLE_MONITOR>TRUE</ENABLE_MONITOR>
	    	<BACK_GROUND_CONN>TRUE</BACK_GROUND_CONN>
	    	<ENABLE_LIVECHECK>FALSE</ENABLE_LIVECHECK>
		    <LIVECHECK_SERVER_PORT>3435</LIVECHECK_SERVER_PORT>
  	</COMMON>
  	<MONITOR>
	    	<TYPE>DESTINATION</TYPE>
	    	<DESTINATION_NAME>MON</DESTINATION_NAME>
	    	<!-- set entob jms system ip:port 가동계 -->
	        <JMSPROVIDER_URL>localhost:1099</JMSPROVIDER_URL>
	    	<INITIAL_CONTEXT_FACTORY>org.jnp.interfaces.NamingContextFactory</INITIAL_CONTEXT_FACTORY>
	    	<TOPIC_CONNECTION_FACTORY>UIL2ConnectionFactory</TOPIC_CONNECTION_FACTORY>
	    	<TOPIC_NAME>ADAPTER.MONITOR</TOPIC_NAME>
	    	<TOPIC_PREFIX>topic/</TOPIC_PREFIX>
	    	<USERNAME>guest</USERNAME>
	    	<PASSWORD>guest</PASSWORD>
	    	<SEND_STATUS_INTERVAL>60000</SEND_STATUS_INTERVAL>
	</MONITOR>
</ADAPTER>

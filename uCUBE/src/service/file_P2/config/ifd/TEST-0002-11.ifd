######Common to all adapterse.######

#FILE, TC or DB.
INTERFACE_SOURCE_TYPE=FILE

#FILE,TC or DB
INTERFACE_TARGET_TYPE=FILE

#TRUE or FALSE
PERSISTENT=TRUE

#######FOR USE OF FILE ADAPTERS ONLY######
#this flag is used by file receive adapter to store file.
DESTINATION_DIRECTORY=${UCUBE_HOME}\service\file\filein

#Default Destination File Name
#FileName 에 TIMESTAMP 가 추가 필요할 경우 
# 예 : NTOBPO<DATE(yyyyMMddHHmmssSS)>.flat
# default : MMddHHmmssSSSS 
DESTINATION_FILE_NAME=NTOBPO<DATE(MMddHHmmssSSSS)>.flat

#This flag is only for file send TRUE/FALSE
USE_SOURCE_FILE_NAME=TRUE

#BINARY or TEXT
FILE_TYPE=BINARY

#if file type is text, set this value.
FILE_CHUNK_LINE=100

#if file type is binary, set this value.
#no. of bytes to be sent in one time.  Set this value based on the system load and system memory configuration
FILE_CHUNK_SIZE=500000

#File action.  Values APPEND, OVERWRITE, NEWFILE (Default Value)
FILE_ACTION=NEWFILE

#NO_ACTION,MOVE,DELETE or COPY
POST_PROCESSING_ACTION=MOVE
POST_PROCESSING_DIRECTORY=${UCUBE_HOME}\service\file\fileout\backup
POST_PROCESSING_OVERWRITE=FALSE
POST_PROCESSING_FILE_COUNT=50

#Count of sending queue, 1, 2, 3... N
QUEUE_COUNT=1

#Name of queue
QUEUE1=B

#Set LINK NAME of Configuration File.
ADAPTER_NAME=SEND

#Set DESTINATION_NAME of Configuration File.
DESTINATION_NAME=JBOSSMQ

#----- > Do not remove this line <---------------



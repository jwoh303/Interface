<?xml version="1.0" encoding="EUC-KR"?>
<SQL>
	<!-- *********************************************************************** -->
	<SQL_DOC INTERFACE_ID="BUYER2KEP_RFQ">
		<V_SQL NAME='$G_RS' ISLOOP="TRUE" COMMIT_BY_RESULT="FALSE"> 
                   SELECT QUOTATION_NO
                        , BUYER_ITEM_NO
                   FROM  V_MN50TB MN50, KEPTRXL TRXL
                   WHERE MN50.APPLY_DATE >= TO_CHAR(SYSDATE-10,'YYYYMMDD')
                   AND   MN50.QUOTATION_NO = TRXL.KEY_1(+)
                   AND   MN50.BUYER_ITEM_NO = TRXL.KEY_2(+)
                   AND   TRXL.DOC_NAME(+) = 'RE'
                   AND   TRXL.DOC_NAME IS NULL
                   GROUP BY QUOTATION_NO, BUYER_ITEM_NO

		</V_SQL> 
		<P_SQL SEQ="1" TYPE="SELECT" POST_SQL="TRUE">
		<![CDATA[
		SELECT 'SMT1' AS BUYER
		     , 'KA'   AS SITE
                     , 'XX'   AS PLANT
                     , QUOTATION_NO
                     , '001'            AS QUOTATION_SEQ
                     , '1'              AS REVISION_NO
                     , 'C'              AS STATUS
                     , ADD_DATE
                     , BUYER_ITEM_NO      AS BUYER_ITEM_NO
                     , DESCRIPTION
                     , SPECIFICATION
                     , UNIT_MEASURE
                     , MAKER_NAME
                     , 0                AS UNIT_PRICE
                     , REQ_USER_ID
                     , REQ_USER_NAME
                     , REQ_USER_DEPT_NAME
                     , REQ_user_telno   as REQ_USER_TEL_NO
                     , REQ_USER_MAIL
                     , TO_CHAR(sysdate+5,'YYYYMMDD') AS CLOSE_DATE
                     , TO_CHAR(sysdate+5,'HH24MISS') AS CLOSE_TIME
                     , ITEM_QTY
                     , REMARK
                FROM  V_MN50TB MN50
                WHERE QUOTATION_NO = $G_RS.QUOTATION_NO$
                AND   BUYER_ITEM_NO= $G_RS.BUYER_ITEM_NO$

		]]>
			<C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
			<![CDATA[
                          INSERT INTO KEPTRXL
                               ( DOC_NAME
                               , TARGET
                               , KEY_1
                               , KEY_2
                               , KEY_3
                               , KEY_4
                               , KEY_5
                               , KEY_6
                               , IF_FLAG )
                          VALUES (
                                 'RE'
                               , '10'
                               , $G_RS.QUOTATION_NO$
                               , $G_RS.BUYER_ITEM_NO$
                               , ' '
                               , ' '
                               , ' '
                               , TO_CHAR(SYSDATE,'YYYYMMDD HH24MISS')
                               , 'Y'  )

			]]>
			</C_SQL>
			<C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">

			<![CDATA[]]>
			</C_SQL>
		</P_SQL>
	</SQL_DOC>
	<RETRY_CODE>
		<CODE>03113</CODE>
		<CODE>03114</CODE>
		<CODE>02154</CODE>
		<CODE>02541</CODE>
		<CODE>04068</CODE>
	</RETRY_CODE>
</SQL>
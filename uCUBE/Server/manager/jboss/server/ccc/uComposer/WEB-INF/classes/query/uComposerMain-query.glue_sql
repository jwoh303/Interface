<?xml version='1.0' encoding='EUC-KR'?>
<queryMap desc="uComposer Project Query File">

	<query id="uComposerTreeList.select" desc="Tree List Select" fetchSize="10">
		<![CDATA[
			SELECT 
				sym.system_seq, sym.system_id, sgm.service_group_seq, sgm.service_group_id, 
				sm.service_seq, sm.service_id, iim.interface_seq, iim.interface_id,
				(select service_group_type_seq||'|'||service_group_type_category||'|'||description from ucube_service_group_type sgt where sgt.service_group_type_seq=sgm.service_group_type_seq) as service_category
			FROM
				ucube_system_master sym 
				LEFT JOIN ucube_service_group_master sgm ON sgm.system_seq = sym.system_seq AND sgm.usable IS NOT FALSE
				LEFT JOIN ucube_service_master sm ON sm.service_group_seq = sgm.service_group_seq AND sm.usable IS NOT FALSE
				LEFT JOIN ucube_interface_service ise 
					ON sm.service_seq=ise.service_seq 
					AND ise.version=(SELECT MAX(version) FROM ucube_interface_service WHERE interface_seq=ise.interface_seq)
				LEFT JOIN ucube_interface_master iim ON iim.interface_seq=ise.interface_seq AND iim.usable IS NOT FALSE
			WHERE
				sym.usable IS NOT FALSE
			ORDER BY 
				sym.system_seq, sgm.service_group_seq, sm.service_seq, ise.interface_seq
		]]>
	</query>

	<query id="uComposerTreeListRoot.select" desc="Tree List Root Select" fetchSize="10">
		<![CDATA[
			SELECT 
				system_seq, system_id,
				(SELECT service_group_seq FROM ucube_service_group_master WHERE system_seq=sm.system_seq AND usable IS NOT FALSE LIMIT 1) AS sub_exist
			FROM
				ucube_system_master sm 
			WHERE
				usable IS NOT FALSE	
			ORDER BY 
				system_seq
		]]>
	</query>
	
</queryMap>

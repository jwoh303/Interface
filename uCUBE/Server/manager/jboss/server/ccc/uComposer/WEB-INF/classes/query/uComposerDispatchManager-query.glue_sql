<?xml version='1.0' encoding='EUC-KR'?>
<queryMap desc="uComposer Project Query File">

	<query id="dispatchManagerSystem.insert" desc="DispatchManager System Insert" fetchSize="10">
		<![CDATA[
 			INSERT INTO ucube_dispatch_manager(system_seq, service_group_seq, status_flag, ucube_user_seq, last_updated_timestamp)
	        (
		        SELECT 
		        	sgm.system_seq, sgm.service_group_seq, 'C', ?, NOW()
				FROM 
					ucube_service_group_master sgm, ucube_service_master sma, ucube_interface_service ise
				WHERE system_seq = ?
					AND sgm.service_group_seq=sma.service_group_seq 
					AND sma.service_seq=ise.service_seq
				GROUP BY sgm.system_seq, sgm.service_group_seq
	        )
		]]>
	</query>

	<query id="dispatchManagerSystem.delete" desc="dispatchManager System delete" fetchSize="10">
		<![CDATA[
			DELETE FROM ucube_dispatch_manager
			WHERE system_seq = ? AND status_flag = 'C'
		]]>
	</query>
	
	<query id="dispatchManagerServiceGroup.insert" desc="DispatchManager System Insert" fetchSize="10">
		<![CDATA[
 			INSERT INTO ucube_dispatch_manager(system_seq, service_group_seq, status_flag, ucube_user_seq, last_updated_timestamp)
	        (
		        SELECT 
		        	sgm.system_seq, sgm.service_group_seq, 'C', ?, NOW()
				FROM 
					ucube_service_group_master sgm, ucube_service_master sma, ucube_interface_service ise
				WHERE sgm.service_group_seq = ?
					AND sgm.service_group_seq=sma.service_group_seq 
					AND sma.service_seq=ise.service_seq
				GROUP BY sgm.system_seq, sgm.service_group_seq
	        )
		]]>
	</query>

	<query id="dispatchManagerServiceGroup.delete" desc="dispatchManager System delete" fetchSize="10">
		<![CDATA[
			DELETE FROM ucube_dispatch_manager
			WHERE service_group_seq = ? AND status_flag = 'C'
		]]>
	</query>

	<query id="dispatchManagerService.insert" desc="DispatchManager System Insert" fetchSize="10">
		<![CDATA[
 			INSERT INTO ucube_dispatch_manager(system_seq, service_group_seq, status_flag, ucube_user_seq, last_updated_timestamp)
	        (
		        SELECT 
		        	sgm.system_seq, sgm.service_group_seq, 'C', ?, NOW()
				FROM 
					ucube_service_group_master sgm, ucube_service_master sma, ucube_interface_service ise
				WHERE sma.service_seq = ?
					AND sgm.service_group_seq=sma.service_group_seq 
					AND sma.service_seq=ise.service_seq
				GROUP BY sgm.system_seq, sgm.service_group_seq
	        )
		]]>
	</query>

	<query id="dispatchManagerService.delete" desc="dispatchManager System delete" fetchSize="10">
		<![CDATA[
			DELETE FROM ucube_dispatch_manager
			WHERE service_group_seq=(SELECT service_group_seq FROM ucube_service_master WHERE service_seq = ?) AND status_flag = 'C'
		]]>
	</query>
	
	<query id="dispatchManagerInterface.insert" desc="DispatchManager InterfaceService Insert" fetchSize="10">
		<![CDATA[
 			INSERT INTO ucube_dispatch_manager(system_seq, service_group_seq, status_flag, ucube_user_seq, last_updated_timestamp)
	        (
		        SELECT 
		        	sgm.system_seq, sgm.service_group_seq, 'C', ?, NOW()
				FROM 
					ucube_service_group_master sgm, ucube_service_master sma, ucube_interface_service ise
				WHERE ise.interface_seq = ?
					AND sgm.service_group_seq=sma.service_group_seq 
					AND sma.service_seq=ise.service_seq
				GROUP BY sgm.system_seq, sgm.service_group_seq
	        )
		]]>
	</query>

	<query id="dispatchManagerInterface.delete" desc="dispatchManager InterfaceService delete" fetchSize="10">
		<![CDATA[
			DELETE FROM ucube_dispatch_manager
			WHERE service_group_seq in (SELECT service_group_seq FROM ucube_service_master WHERE service_seq in (SELECT service_seq FROM ucube_interface_service WHERE interface_seq = ?)) AND status_flag = 'C'
		]]>
	</query>
		
</queryMap>

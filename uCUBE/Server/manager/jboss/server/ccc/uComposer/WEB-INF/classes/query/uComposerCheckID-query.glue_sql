<?xml version='1.0' encoding='UTF-8'?>
<queryMap desc="uComposer Project Query File">

	<query id="uComposerCheckSystemID.select" desc="Check SystemID Select" fetchSize="10">
		<![CDATA[
			SELECT system_seq
  			FROM ucube_system_master
			WHERE system_id = ?
		]]>
	</query>

	<query id="uComposerCheckServiceGroupID.select" desc="Check ServiceGroupID Select" fetchSize="10">
		<![CDATA[
			SELECT service_group_seq
  			FROM ucube_service_group_master
			WHERE system_seq = ? AND service_group_id = ?
		]]>
	</query>
	
	<query id="uComposerCheckServiceID.select" desc="Check ServiceID Select" fetchSize="10">
		<![CDATA[
			SELECT service_seq
  			FROM ucube_service_master
			WHERE service_group_seq = ? AND service_id = ?
		]]>
	</query>
	
	<query id="uComposerCheckInterfaceID.select" desc="Check InterfaceID Select" fetchSize="10">
		<![CDATA[
			SELECT interface_seq
  			FROM ucube_interface_master
			WHERE interface_id = ?
		]]>
	</query>

</queryMap>

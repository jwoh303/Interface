        <![CDATA[
        
            ]]>
    </query>
    
    <query id="delService.delete" desc="Distribute History List Select" fetchSize="10">
        <![CDATA[
        DELETE FROM TB_S60_STAT020 WHERE SERVICE_NAME = ( SELECT SERVICE_NAME FROM TB_S60_STAT020 WHERE STATUS_SEQ_ID = ? )
            ]]>
    </query>
    
    <query id="stopServiceStatusMonitorVO.select" desc="Distribute History List Select" fetchSize="10">
    <![CDATA[   
        SELECT DISTINCT EAI_SYSTEM_ID,
                    SERVICE_NAME,
                    SERVICE_LINK_NAME,
                    (
                       CASE
                         WHEN STAT.BL_STATUS = 'ERROR'
        AND    STAT.LAST_UPDATE_TIMESTAMP > ( SYSDATE - 3/(24*60) ) THEN (SELECT CONCAT(EAI_INTERFACE_ID, '<p>') || CONCAT(DESCRIPTION, '<p>') || NVL(TEXT_DATA,'')
                FROM   TB_S60_UERR010
                WHERE  EAI_SYSTEM_ID = STAT.EAI_SYSTEM_ID
                AND    LOCAL_QUEUE_NAME = STAT.SERVICE_LINK_NAME
                AND    EAI_SEND_TIMESTAMP = (SELECT MAX(EAI_SEND_TIMESTAMP)
                        FROM   TB_S60_UERR010
                        WHERE  EAI_SYSTEM_ID = STAT.EAI_SYSTEM_ID
                        AND    LOCAL_QUEUE_NAME = STAT.SERVICE_LINK_NAME) )
                         ELSE ''
                       END) AS Q_DESCRIPTION,
                    BL_STATUS,
                    TO_CHAR(LAST_UPDATE_TIMESTAMP, 'YYYY/MM/DD HH24:MI:SS') LAST_UPDATE_TIMESTAMP,
                    STATUS_SEQ_ID,
                    DESCRIPTION
                   FROM TB_S60_STAT020 STAT
          WHERE LAST_UPDATE_TIMESTAMP IS NOT NULL
          AND EAI_SYSTEM_ID LIKE CONCAT('%',CONCAT(?,'%'))
          AND SERVICE_NAME LIKE CONCAT('%',CONCAT(?,'%'))
          AND SERVICE_LINK_NAME LIKE CONCAT(?, '%')
          AND (SYSDATE - LAST_UPDATE_TIMESTAMP > INTERVAL '0 00:01:40.0000' DAY TO SECOND OR BL_STATUS = 'ERROR')
          ORDER BY EAI_SYSTEM_ID, SERVICE_NAME, BL_STATUS 
  ]]>
    </query>
    
    <query id="allServiceStatusMonitorVO.select" desc="Distribute History List Select" fetchSize="10">
        <![CDATA[
            SELECT DISTINCT EAI_SYSTEM_ID,
              SERVICE_NAME,
              SERVICE_LINK_NAME,
              (
                       CASE
                         WHEN STAT.BL_STATUS = 'ERROR'
        AND    STAT.LAST_UPDATE_TIMESTAMP > ( SYSDATE - 3/(24*60) ) THEN (SELECT CONCAT(EAI_INTERFACE_ID, '<p>') || CONCAT(DESCRIPTION, '<p>') || NVL(TEXT_DATA,'')
                FROM   TB_S60_UERR010
                WHERE  EAI_SYSTEM_ID = STAT.EAI_SYSTEM_ID
                AND    LOCAL_QUEUE_NAME = STAT.SERVICE_LINK_NAME
                AND    EAI_SEND_TIMESTAMP = (SELECT MAX(EAI_SEND_TIMESTAMP)
                        FROM   TB_S60_UERR010
                        WHERE  EAI_SYSTEM_ID = STAT.EAI_SYSTEM_ID
                        AND    LOCAL_QUEUE_NAME = STAT.SERVICE_LINK_NAME) )
                         ELSE ''
                       END) AS Q_DESCRIPTION,
              BL_STATUS,
              TO_CHAR(LAST_UPDATE_TIMESTAMP, 'YYYY/MM/DD HH24:MI:SS') LAST_UPDATE_TIMESTAMP,
              STATUS_SEQ_ID,
              DESCRIPTION, 
              TO_CHAR(CREATION_TIMESTAMP, 'YYYY/MM/DD HH24:MI:SS') CREATION_TIMESTAMP
            FROM TB_S60_STAT020 STAT
            WHERE EAI_SYSTEM_ID LIKE CONCAT('%',CONCAT(?,'%'))
              AND SERVICE_NAME LIKE CONCAT('%',CONCAT(?,'%'))
              AND SERVICE_LINK_NAME LIKE CONCAT('%',CONCAT(?,'%'))
              AND LAST_UPDATE_TIMESTAMP IS NOT NULL 
              ORDER BY EAI_SYSTEM_ID, BL_STATUS, LAST_UPDATE_TIMESTAMP
            ]]>
    </query>
    
    <query id="serviceStatusMonitorVO.select" desc="Distribute History List Select" fetchSize="10">
        <![CDATA[
        SELECT DISTINCT EAI_SYSTEM_ID,
  SERVICE_NAME,
  SERVICE_LINK_NAME,
  (
    SELECT QUEUE_DESCRIPTION
    FROM TB_S60_QNAM010
    WHERE SERVICE_LINK_NAME = LOCAL_QUEUE_NAME ) Q_DESCRIPTION,
  BL_STATUS,
  TO_CHAR(LAST_UPDATE_TIMESTAMP, 'YYYY/MM/DD HH24:MI:SS') LAST_UPDATE_TIMESTAMP,
  STATUS_SEQ_ID,
  DESCRIPTION
FROM (
    SELECT IFMG.INTERFACE_SECTION,
      SMLS.EAI_SYSTEM_ID,
      SMLS.SERVICE_NAME,
      SMLS.SERVICE_LINK_NAME,
      SMLS.BL_STATUS,
      SMLS.LAST_UPDATE_TIMESTAMP,
      SMLS.STATUS_SEQ_ID,
      SMLS.DESCRIPTION
    FROM TB_S60_STAT020 SMLS,
      TB_S60_IFMG020 IFMG
    WHERE SMLS.EAI_SYSTEM_ID = IFMG.SEND_EAI_SYSTEM_ID
      AND SMLS.SERVICE_NAME = IFMG.SEND_APP_NAME
      AND SMLS.SERVICE_LINK_NAME = IFMG.SEND_LINK_NAME
    UNION ALL
    SELECT IFMG.INTERFACE_SECTION,
      SMLS.EAI_SYSTEM_ID,
      SMLS.SERVICE_NAME,
      SMLS.SERVICE_LINK_NAME,
      SMLS.BL_STATUS,
      SMLS.LAST_UPDATE_TIMESTAMP,
      SMLS.STATUS_SEQ_ID,
      SMLS.DESCRIPTION
    FROM TB_S60_STAT020 SMLS,
      TB_S60_IFMG020 IFMG
    WHERE SMLS.EAI_SYSTEM_ID = IFMG.RECV_EAI_SYSTEM_ID
      AND SMLS.SERVICE_NAME = IFMG.RECV_APP_NAME
      AND SMLS.SERVICE_LINK_NAME = IFMG.RECV_LINK_NAME )
WHERE INTERFACE_SECTION LIKE CONCAT('%',CONCAT(?,'%'))
  AND EAI_SYSTEM_ID LIKE CONCAT('%',CONCAT(?,'%'))
  AND SERVICE_NAME LIKE CONCAT('%',CONCAT(?,'%'))
  AND SERVICE_LINK_NAME LIKE CONCAT('%',CONCAT(?,'%'))
  AND LAST_UPDATE_TIMESTAMP IS NOT NULL 
  ORDER BY BL_STATUS, SERVICE_NAME, LAST_UPDATE_TIMESTAMP
            ]]>
    </query>
    

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE taglib PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.1//EN" "http://java.sun.com/j2ee/dtds/web-jsptaglibrary_1_1.dtd">
<taglib>
	<tlibversion>1.2</tlibversion>
	<jspversion>1.1</jspversion>
	<shortname>ucube</shortname>
	<uri>WEB-INF/tlds/ucube.tld</uri>
	<tag>
		<name>showMessages</name>
		<tagclass>com.posdata.eai.manager.util.ShowMessages</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>property</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>showTable</name>
		<tagclass>com.posdata.eai.manager.util.ShowTable</tagclass>
		<info>show table tag</info>
		<attribute> 
		  	<name>vo</name>
			<required>true</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute> 
		  	<name>title</name>
			<required>true</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute> 
		  	<name>attr</name>
			<required>true</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute> 
		  	<name>align</name>
			<required>true</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute> 
		  	<name>width</name>
			<required>true</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>tableWidth</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>tableHeight</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>trHeight</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>tableId</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>fixedCols</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>trClickFunction</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>cellType</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>	
		<attribute>
		  	<name>cellAddStr</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>cellOnClick</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>cellOnFocus</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>cellOnBlur</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>cellOnKeyDown</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>cellOnKeyUp</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>isFillBlank</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>	  
		<attribute>
		  	<name>singleSelectMode</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>
		<attribute>
		  	<name>bubbleHelp</name>
			<required>false</required>
			<rtexprvalue>false</rtexprvalue> 
		</attribute>	  
	</tag>

</taglib>




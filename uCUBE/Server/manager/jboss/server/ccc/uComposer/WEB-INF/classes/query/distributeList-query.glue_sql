<?xml version='1.0' encoding='EUC-KR'?>
<queryMap desc="uComposer Project Query File">

	<query id="distributeList.resetDistribute1" desc="TEST Query     Reset Distribute Status">
		<![CDATA[
			UPDATE
				UCUBE_DISPATCH_MANAGER
			SET
				STATUS_FLAG = 'C'
			WHERE
				STATUS_FLAG = ?
		]]>
	</query>


	<query id="distributeList.resetDistribute2" desc="TEST Query     Reset Distribute Status">
		<![CDATA[
			UPDATE
				UCUBE_VERSION_MANAGER
			SET
				STATUS_FLAG = 'C',
				DISPATCHED_TIMESTAMP = NULL,
				RECEIVED_TIMESTAMP = NULL
			WHERE
				STATUS_FLAG = ?
		]]>
	</query>
 
   <query id="distributeList.select" desc="Distribute List Select" fetchSize="10">
		<![CDATA[
	            
	            SELECT  SYSTEM_SEQ  ,SYSTEM_ID,SERVICE_GROUP_SEQ,SERVICE_GROUP_ID,SERVICE_GROUP_TYPE_ID,
		                SERVICE_SEQ,  SERVICE_ID, INTERFACE_SEQ, INTERFACE_ID, STATUS_FLAG, REDISPATCHED_SEQ ,
		                REDISPATCHED_TIME, DISPATCHED_TIME, RECEIVED_TIME
		    	 FROM  
		    	 (     SELECT 
		    	             AA.SYSTEM_SEQ,   AA.SYSTEM_ID,   AA.SERVICE_GROUP_SEQ,    AA.SERVICE_GROUP_ID,   AA.SERVICE_GROUP_TYPE_ID, 
		    	             D.SERVICE_SEQ,   D.SERVICE_ID,   E.INTERFACE_SEQ,         E.INTERFACE_ID,        G.STATUS_FLAG,  
		    	             G.REDISPATCHED_SEQ, 
		    	             (  CASE WHEN G.REDISPATCHED_SEQ IS NOT NULL THEN 
		    	 		           (  SELECT TO_CHAR(DISPATCHED_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS') 
		    	 	                  FROM UCUBE_VERSION_MANAGER 
		    	 	                  WHERE UCUBE_VERSION_MANAGER_SEQ = G.REDISPATCHED_SEQ 
		    	 	                )
		    	               ELSE ''
		    	 	              END 
		    	 	            ) AS REDISPATCHED_TIME, 
		    	 	      TO_CHAR(G.DISPATCHED_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS') AS DISPATCHED_TIME,
		    	 	      TO_CHAR(G.RECEIVED_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS') AS RECEIVED_TIME 	
				FROM 
				(     SELECT AB.SYSTEM_SEQ,           B.SYSTEM_ID,        AB.SERVICE_GROUP_SEQ, C.SERVICE_GROUP_ID, 
		    	 	      H.SERVICE_GROUP_TYPE_ID,        A.DISPATCH_VERSION, A.UCUBE_USER_SEQ,     TO_CHAR(A.LAST_UPDATED_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS') AS LAST_UPDATED_TIME 
				      FROM 
				       	(
				 	          	SELECT SYSTEM_SEQ, SERVICE_GROUP_SEQ, MAX(UCUBE_DISPATCH_MANAGER_SEQ) AS UCUBE_DISPATCH_MANAGER_SEQ 
				 	   	      	FROM UCUBE_DISPATCH_MANAGER 
				 	          	WHERE   STATUS_FLAG <> 'F' AND 
				 	                	STATUS_FLAG <> 'I' 
				 	          	GROUP BY SYSTEM_SEQ, SERVICE_GROUP_SEQ 
				       	) AB, 
						UCUBE_DISPATCH_MANAGER A, 
						UCUBE_SYSTEM_MASTER B,
						UCUBE_SERVICE_GROUP_MASTER C,
						UCUBE_SERVICE_GROUP_TYPE H 
		                     WHERE 
					AB.SYSTEM_SEQ = A.SYSTEM_SEQ AND 
					AB.SERVICE_GROUP_SEQ = A.SERVICE_GROUP_SEQ AND 
					AB.UCUBE_DISPATCH_MANAGER_SEQ = A.UCUBE_DISPATCH_MANAGER_SEQ AND 
					AB.SYSTEM_SEQ = B.SYSTEM_SEQ AND 
					AB.SERVICE_GROUP_SEQ = C.SERVICE_GROUP_SEQ AND 
					C.SERVICE_GROUP_TYPE_SEQ = H.SERVICE_GROUP_TYPE_SEQ  
	    		 			
	    		 	)AA
	    		 	LEFT OUTER JOIN UCUBE_VERSION_MANAGER G 
	    		 	ON (AA.DISPATCH_VERSION = G.UCUBE_VERSION_MANAGER_SEQ),
	    		 	UCUBE_SERVICE_MASTER D,
	    		 	UCUBE_INTERFACE_MASTER E,
	    		 	(
	    		 		SELECT INTERFACE_SEQ , SERVICE_SEQ 
	    		 		FROM UCUBE_INTERFACE_SERVICE 
	    		 		GROUP BY INTERFACE_SEQ , SERVICE_SEQ 
	    		 	) I
	    		 	
	    		 WHERE  AA.SERVICE_GROUP_SEQ = D.SERVICE_GROUP_SEQ AND 
	    		      D.SERVICE_SEQ = I.SERVICE_SEQ AND 
	    		      I.INTERFACE_SEQ = E.INTERFACE_SEQ 
	    		  ORDER BY SYSTEM_ID, SERVICE_GROUP_ID, SERVICE_ID, INTERFACE_ID 
	    	      ) RESULT 
			     WHERE 
			      RESULT.SYSTEM_ID LIKE  '%'||?||'%'
			      AND RESULT.SERVICE_ID LIKE  '%'||?||'%'
			      AND RESULT.INTERFACE_ID LIKE  '%'||?||'%'
		]]>
	</query>

	<query id="distributeList.selectRefSGIDs" desc="Destination INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				AA.*,
				F.SERVICE_SEQ, H.SERVICE_GROUP_ID, I.SYSTEM_ID
			FROM
				(
					SELECT
						A.SYSTEM_SEQ, B.SYSTEM_ID,
						A.SERVICE_GROUP_SEQ, C.SERVICE_GROUP_ID AS CSERVICE_GROUP_ID,
						D.SERVICE_SEQ AS ASERVICE_SEQ, D.SERVICE_ID,
						F.INTERFACE_SEQ, F.INTERFACE_ID,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_INTERFACE
							WHERE INTERFACE_SEQ = F.INTERFACE_SEQ
						) AS IF_VERSION
					FROM
						UCUBE_DISPATCH_MANAGER A,
						UCUBE_SYSTEM_MASTER B,
						UCUBE_SERVICE_GROUP_MASTER C
							LEFT OUTER JOIN UCUBE_SERVICE_MASTER D
							ON (D.SERVICE_GROUP_SEQ = C.SERVICE_GROUP_SEQ)
							LEFT OUTER JOIN UCUBE_INTERFACE_SERVICE E
							ON (E.SERVICE_SEQ = D.SERVICE_SEQ)
							LEFT OUTER JOIN UCUBE_INTERFACE_MASTER F
							ON (F.INTERFACE_SEQ = E.INTERFACE_SEQ)
					WHERE
						A.STATUS_FLAG <> 'F' AND
						A.STATUS_FLAG <> 'I' AND
						A.SYSTEM_SEQ = B.SYSTEM_SEQ AND
						A.SERVICE_GROUP_SEQ = C.SERVICE_GROUP_SEQ
				) AA,
				UCUBE_INTERFACE_SERVICE F,
				UCUBE_SERVICE_MASTER G,
				UCUBE_SERVICE_GROUP_MASTER H,
				UCUBE_SYSTEM_MASTER I
			WHERE
				F.INTERFACE_SEQ = AA.INTERFACE_SEQ AND
				F.VERSION = AA.IF_VERSION AND
				F.SERVICE_SEQ = G.SERVICE_SEQ AND
				G.SERVICE_GROUP_SEQ = H.SERVICE_GROUP_SEQ AND
				AA.ASERVICE_SEQ <> F.SERVICE_SEQ AND
				AA.SERVICE_GROUP_SEQ <> H.SERVICE_GROUP_SEQ AND
				H.SYSTEM_SEQ = I.SYSTEM_SEQ
			ORDER BY AA.SYSTEM_ID, AA.CSERVICE_GROUP_ID, AA.SERVICE_ID, AA.INTERFACE_ID, H.SERVICE_GROUP_ID
		]]>
	</query>


	<query id="distributeList.selectInterfacePerServiceCnt" desc="Destination INFO Select" fetchSize="10">
		<![CDATA[
			SELECT ima.interface_id, COUNT(ise.service_seq) AS CNTS 
			FROM UCUBE_INTERFACE_SERVICE ise, ucube_interface_master ima
			WHERE ise.interface_seq=ima.interface_seq 
				AND ise.service_seq IN (SELECT service_seq FROM ucube_service_master WHERE service_group_seq IN(SELECT service_group_seq FROM ucube_dispatch_manager WHERE status_flag='C'))
				AND version = (SELECT MAX(VERSION) FROM UCUBE_INTERFACE_SERVICE WHERE INTERFACE_SEQ = ise.INTERFACE_SEQ)
			GROUP BY ima.interface_id
			ORDER BY ima.interface_id
		]]>
	</query>


	<query id="distributeList.selectSGTypeInfo" desc="Destination INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				A.SERVICE_GROUP_SEQ,
				A.SERVICE_GROUP_TYPE_SEQ,
				B.SERVICE_GROUP_TYPE_ID
			FROM
				UCUBE_SERVICE_GROUP_MASTER A,
				UCUBE_SERVICE_GROUP_TYPE B
			WHERE
				A.SERVICE_GROUP_SEQ = ? AND
				B.SERVICE_GROUP_TYPE_SEQ = A.SERVICE_GROUP_TYPE_SEQ
		]]>
	</query>


	<query id="distributeList.selectSenderReceiverInfo" desc="Sender Receiver INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				AA.*,
				(
					SELECT EAI_BASE_DIRECTORY
					FROM UCUBE_SYSTEM
					WHERE SYSTEM_SEQ = AA.SYSTEM_SEQ AND
					VERSION = AA.SYS_VERSION
				) AS BASE_DIR,   
				(
					SELECT IP_ADDRESS
					FROM UCUBE_SYSTEM
					WHERE SYSTEM_SEQ = AA.SYSTEM_SEQ AND
					VERSION = AA.SYS_VERSION
				) AS SYS_IP,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'TYPE'
				) AS COL_TYPE,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'SOURCE_NAME'
				) AS COL_SOURCENAME,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'CLASS_NAME'
				) AS COL_CLASS,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'RUN_TYPE'
				) AS COL_RUNTYPE,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'DESTINATION_TYPE'
				) AS COL_DESTINATIONTYPE,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'DESTINATION_NAME'
				) AS COL_DESTINATIONNAME,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'ENABLE_LOCALQUEUE'
				) AS COL_LOCALQUEUE,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'MAX_LQ_SIZE'
				) AS COL_MAXLQSIZE,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'ONMESSAGE_WAIT_TIME'
				) AS COL_ONMESSAGEWAITTIME
			FROM
				(
					SELECT
						C.SYSTEM_SEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_SYSTEM
							WHERE SYSTEM_SEQ = C.SYSTEM_SEQ
						) AS SYS_VERSION,
						C.SYSTEM_ID,
						A.SERVICE_GROUP_SEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_SERVICE_GROUP
							WHERE SERVICE_GROUP_SEQ = A.SERVICE_GROUP_SEQ
						) AS SG_VERSION,
						B.SERVICE_GROUP_ID,
						A.SERVICE_SEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_SERVICE
							WHERE SERVICE_SEQ = A.SERVICE_SEQ
						) AS SERV_VERSION,
						A.SERVICE_ID,
						D.FUNCTION_UNIT_SEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_FUNCTION_UNIT
							WHERE FUNCTION_UNIT_SEQ = D.FUNCTION_UNIT_SEQ
						) AS FUNC_UNIT_VERSION,
						E.CONNECTION_SEQ,
						F.QUEUE_SEQ,
						F.QUEUE_ID,
						G.ENGINE_SEQ,
						G.JMSPROVIDER_URL,
						G.INITIAL_CONTEXT_FACTORY,
						G.QUEUE_CONNECTION_FACTORY,
						G.QUEUE_PREFIX,
						G.USERNAME,
						G.PASSWORD
					FROM
						UCUBE_SERVICE_MASTER A,
						UCUBE_SERVICE_GROUP_MASTER B,
						UCUBE_SYSTEM_MASTER C,
						UCUBE_FUNCTION_UNIT_MASTER D,
						UCUBE_CONNECTION E,
						UCUBE_QUEUE F,
						UCUBE_ENGINE G
					WHERE
						A.SERVICE_GROUP_SEQ = ? AND
						A.SERVICE_GROUP_SEQ = B.SERVICE_GROUP_SEQ AND
						B.SYSTEM_SEQ = C.SYSTEM_SEQ AND
						D.SERVICE_SEQ = A.SERVICE_SEQ AND
						D.FUNCTION_UNIT_SEQ = E.FUNCTION_UNIT_SEQ AND
						F.QUEUE_SEQ = E.QUEUE_SEQ AND
						G.ENGINE_SEQ = F.ENGINE_SEQ
				) AA
		]]>
	</query>


	<query id="distributeList.selectBridgeBrokerCntInfo" desc="Bridge INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				A.*,
				(
					SELECT IP_ADDRESS
					FROM UCUBE_SYSTEM
					WHERE SYSTEM_SEQ = A.SYSTEM_SEQ AND
					VERSION = A.SYS_VERSION
				) AS SYS_IP
			FROM (
					SELECT
						E.SYSTEM_SEQ,
						E.SYSTEM_ID,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_SYSTEM
							WHERE SYSTEM_SEQ = D.SYSTEM_SEQ
						) AS SYS_VERSION,
						D.SERVICE_GROUP_SEQ,
						D.SERVICE_GROUP_ID,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_SERVICE_GROUP
							WHERE SERVICE_GROUP_SEQ = D.SERVICE_GROUP_SEQ
						) AS SG_VERSION,
						B.SERVICE_SEQ, B.SERVICE_ID,
						COUNT( B.* ) AS BCNT
					FROM
						UCUBE_SERVICE_MASTER B,
						UCUBE_FUNCTION_UNIT_MASTER C,
						UCUBE_SERVICE_GROUP_MASTER D,
						UCUBE_SYSTEM_MASTER E
					WHERE
						B.SERVICE_GROUP_SEQ = ? AND
						B.SERVICE_SEQ = C.SERVICE_SEQ AND
						B.SERVICE_GROUP_SEQ = D.SERVICE_GROUP_SEQ AND
						D.SYSTEM_SEQ = E.SYSTEM_SEQ
					GROUP BY E.SYSTEM_SEQ, E.SYSTEM_ID, SYS_VERSION, D.SERVICE_GROUP_SEQ, D.SERVICE_GROUP_ID, SG_VERSION, B.SERVICE_SEQ, B.SERVICE_ID
					ORDER BY B.SERVICE_ID
				) A
			WHERE A.BCNT = 2
		]]>
	</query>


	<query id="distributeList.selectBridgeInfo" desc="Bridge INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				AA.*,
				(
					SELECT D.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS D, UCUBE_COLUMN_NAME_DEFINITION E
					WHERE D.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						D.VERSION = AA.FUNC_UNIT_VERSION AND
						E.COLUMN_NAME_DEFINITION_SEQ = D.COLUMN_NAME_DEFINITION_SEQ AND
						E.COLUMN_NAME_DEFINITION_ID = 'POSITION'
				) AS COL_POSITION,
				(
					SELECT D.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS D, UCUBE_COLUMN_NAME_DEFINITION E
					WHERE D.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						D.VERSION = AA.FUNC_UNIT_VERSION AND
						E.COLUMN_NAME_DEFINITION_SEQ = D.COLUMN_NAME_DEFINITION_SEQ AND
						E.COLUMN_NAME_DEFINITION_ID = 'INIT'
				) AS COL_INIT,
				(
					SELECT D.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS D, UCUBE_COLUMN_NAME_DEFINITION E
					WHERE D.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						D.VERSION = AA.FUNC_UNIT_VERSION AND
						E.COLUMN_NAME_DEFINITION_SEQ = D.COLUMN_NAME_DEFINITION_SEQ AND
						E.COLUMN_NAME_DEFINITION_ID = 'CONFIG_FILE'
				) AS COL_CONFIG_FILE,
				(
					SELECT D.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS D, UCUBE_COLUMN_NAME_DEFINITION E
					WHERE D.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						D.VERSION = AA.FUNC_UNIT_VERSION AND
						E.COLUMN_NAME_DEFINITION_SEQ = D.COLUMN_NAME_DEFINITION_SEQ AND
						E.COLUMN_NAME_DEFINITION_ID = 'RUN_TYPE'
				) AS COL_RUNTYPE,
				(
					SELECT D.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS D, UCUBE_COLUMN_NAME_DEFINITION E
					WHERE D.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						D.VERSION = AA.FUNC_UNIT_VERSION AND
						E.COLUMN_NAME_DEFINITION_SEQ = D.COLUMN_NAME_DEFINITION_SEQ AND
						E.COLUMN_NAME_DEFINITION_ID = 'NEXT_SERVICE_NAME'
				) AS COL_NS_NAME,
				(
					SELECT D.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS D, UCUBE_COLUMN_NAME_DEFINITION E
					WHERE D.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						D.VERSION = AA.FUNC_UNIT_VERSION AND
						E.COLUMN_NAME_DEFINITION_SEQ = D.COLUMN_NAME_DEFINITION_SEQ AND
						E.COLUMN_NAME_DEFINITION_ID = 'NEXT_SERVICE_FROM_SPECIFIC_INFO'
				) AS COL_NS_FROM_SPEC_INFO,
				(
					SELECT D.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS D, UCUBE_COLUMN_NAME_DEFINITION E
					WHERE D.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						D.VERSION = AA.FUNC_UNIT_VERSION AND
						E.COLUMN_NAME_DEFINITION_SEQ = D.COLUMN_NAME_DEFINITION_SEQ AND
						E.COLUMN_NAME_DEFINITION_ID = 'NEXT_SERVICE_KEEP_TRANSACTION'
				) AS COL_NS_KEEP_TRANSACTION
			FROM
				(
					SELECT
						A.SERVICE_GROUP_SEQ,
						A.SERVICE_SEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_SERVICE
							WHERE SERVICE_SEQ = A.SERVICE_SEQ
						) AS SERV_VERSION,
						A.SERVICE_ID,
						B.FUNCTION_UNIT_SEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_FUNCTION_UNIT
							WHERE FUNCTION_UNIT_SEQ = B.FUNCTION_UNIT_SEQ
						) AS FUNC_UNIT_VERSION,
						B.FUNCTION_UNIT_ID,
						B.FUNCTION_UNIT_TYPE_SEQ,
						C.FUNCTION_UNIT_TYPE_ID
					FROM
						UCUBE_SERVICE_MASTER A,
						UCUBE_FUNCTION_UNIT_MASTER B,
						UCUBE_FUNCTION_UNIT_TYPE C
					WHERE
						A.SERVICE_GROUP_SEQ = ? AND
						B.SERVICE_SEQ = A.SERVICE_SEQ AND
						B.FUNCTION_UNIT_TYPE_SEQ = C.FUNCTION_UNIT_TYPE_SEQ
					ORDER BY C.FUNCTION_UNIT_TYPE_ID DESC
				) AA
		]]>
	</query>


	<query id="distributeList.selectBridgeConfInfo" desc="Bridge Config INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				AA.*,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'TYPE'
				) AS COL_TYPE,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'SOURCE_NAME'
				) AS COL_SOURCENAME,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'CLASS_NAME'
				) AS COL_CLASS,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'RUN_TYPE'
				) AS COL_RUNTYPE,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'DESTINATION_TYPE'
				) AS COL_DESTINATIONTYPE,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'DESTINATION_NAME'
				) AS COL_DESTINATIONNAME,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'ENABLE_LOCALQUEUE'
				) AS COL_LOCALQUEUE,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'MAX_LQ_SIZE'
				) AS COL_MAXLQSIZE,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						H.VERSION = AA.FUNC_UNIT_VERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'ONMESSAGE_WAIT_TIME'
				) AS COL_ONMESSAGEWAITTIME
			FROM
				(
					SELECT
						A.SERVICE_GROUP_SEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_SERVICE_GROUP
							WHERE SERVICE_GROUP_SEQ = A.SERVICE_GROUP_SEQ
						) AS SG_VERSION,
						A.SERVICE_SEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_SERVICE
							WHERE SERVICE_SEQ = A.SERVICE_SEQ
						) AS SERV_VERSION,
						A.SERVICE_ID,
						B.FUNCTION_UNIT_SEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_FUNCTION_UNIT
							WHERE FUNCTION_UNIT_SEQ = B.FUNCTION_UNIT_SEQ
						) AS FUNC_UNIT_VERSION,
						C.FUNCTION_UNIT_TYPE_ID,
						D.CONNECTION_SEQ,
						E.QUEUE_SEQ,
						E.QUEUE_ID,
						F.ENGINE_SEQ,
						F.JMSPROVIDER_URL,
						F.INITIAL_CONTEXT_FACTORY,
						F.QUEUE_CONNECTION_FACTORY,
						F.QUEUE_PREFIX,
						F.USERNAME,
						F.PASSWORD
					FROM
						UCUBE_SERVICE_MASTER A,
						UCUBE_FUNCTION_UNIT_MASTER B,
						UCUBE_FUNCTION_UNIT_TYPE C,
						UCUBE_CONNECTION D,
						UCUBE_QUEUE E,
						UCUBE_ENGINE F
					WHERE
						A.SERVICE_SEQ = ? AND
						B.SERVICE_SEQ = A.SERVICE_SEQ AND
						B.FUNCTION_UNIT_TYPE_SEQ = C.FUNCTION_UNIT_TYPE_SEQ AND
						C.FUNCTION_UNIT_TYPE_ID = ? AND
						B.FUNCTION_UNIT_SEQ = D.FUNCTION_UNIT_SEQ AND
						E.QUEUE_SEQ = D.QUEUE_SEQ AND
						F.ENGINE_SEQ = E.ENGINE_SEQ
				) AA
		]]>
	</query>


	<query id="distributeList.selectCommMonInfo" desc="Destination INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				AA.*,
				C.EAI_BASE_DIRECTORY,
				B.SRC_PC,
				B.RECONNECT_INTERVAL,
				B.EVENT_QUEUE,
				B.DATA_QUEUE,
				B.ENCODING_VALUE,
				B.ENABLE_MONITOR,
				B.BACK_GROUND_CONN,
				B.TYPE,
				B.DESTINATION_NAME,
				B.JMSPROVIDER_URL,
				B.INITIAL_CONTEXT_FACTORY,
				B.TOPIC_CONNECTION_FACTORY,
				B.TOPIC_NAME,
				B.RECONNECT_TRY_COUNT,
				B.USERNAME,
				B.PASSWORD,
				B.ENABLE_LOCALQUEUE,
				B.SEND_STATUS_INTERVAL,
				B.TOPIC_PREFIX
			FROM
				(
					SELECT
						A.SERVICE_GROUP_SEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_SERVICE_GROUP
							WHERE SERVICE_GROUP_SEQ = A.SERVICE_GROUP_SEQ
						) AS SG_VERSION,
						A.SERVICE_GROUP_ID,
						A.SYSTEM_SEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_SYSTEM
							WHERE SYSTEM_SEQ = A.SYSTEM_SEQ
						) AS SYS_VERSION
					FROM
						UCUBE_SERVICE_GROUP_MASTER A
					WHERE
						A.SERVICE_GROUP_SEQ = ?
				) AA,
				UCUBE_SERVICE_GROUP B,
				UCUBE_SYSTEM C
			WHERE
				B.SERVICE_GROUP_SEQ = AA.SERVICE_GROUP_SEQ AND
				B.VERSION = AA.SG_VERSION AND
				C.SYSTEM_SEQ = AA.SYSTEM_SEQ AND
				C.VERSION = AA.SYS_VERSION
		]]>
	</query>


	<query id="distributeList.selectInterfaceInfo" desc="Interface INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				AAAA.*,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AAAA.SENDER_SERVICE_FUSEQ AND
						H.VERSION = AAAA.SENDER_SERVICE_FUVERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'DESTINATION_NAME'
				) AS DESTINATION_NAME
			FROM
				(
					SELECT
						AAA.*,
						(
							SELECT SERVICE_ID
							FROM UCUBE_SERVICE_MASTER
							WHERE SERVICE_SEQ = AAA.SENDER_SERVICE_SEQ
						) AS ADAPTER_NAME,
						E.FUNCTION_UNIT_SEQ AS SENDER_SERVICE_FUSEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_FUNCTION_UNIT
							WHERE FUNCTION_UNIT_SEQ = E.FUNCTION_UNIT_SEQ
						) AS SENDER_SERVICE_FUVERSION,
						D.INTERFACE_SOURCE_TYPE, D.INTERFACE_TARGET_TYPE, D.PERSISTENT, D.SEQUENTIAL_DATA, D.DESTINATION_DIRECTORY,
						D.DESTINATION_FILE_NAME, D.USE_SOURCE_FILE_NAME, D.DELIMITER, D.FILE_TYPE, D.FILE_ACTION,
						D.FILE_CHUNK_SIZE, D.POST_PROCESSING_ACTION, D.POST_PROCESSING_DIRECTORY, D.POST_PROCESSING_FILE_NAME, D.POST_PROCESSING_OVERWRITE,
						D.POST_PROCESSING_FILE_COUNT, D.SYSTEM_COMMAND
					FROM
						(
							SELECT
								AA.*,
								C.INTERFACE_ID,
								(
									SELECT MAX(VERSION)
									FROM UCUBE_INTERFACE
									WHERE INTERFACE_SEQ = C.INTERFACE_SEQ
								) AS IF_VERSION,
								(
									SELECT BBB.SERVICE_SEQ
									FROM
										UCUBE_INTERFACE_SERVICE BBB,
										UCUBE_SERVICE_MASTER FFF,
										UCUBE_SERVICE_GROUP_MASTER GGG,
										UCUBE_SERVICE_GROUP_TYPE HHH
									WHERE
										BBB.INTERFACE_SEQ = AA.INTERFACE_SEQ AND
										BBB.VERSION = AA.IF_SERV_VERSION AND
										BBB.SERVICE_SEQ = FFF.SERVICE_SEQ AND
										FFF.SERVICE_GROUP_SEQ = GGG.SERVICE_GROUP_SEQ AND
										GGG.SERVICE_GROUP_TYPE_SEQ = HHH.SERVICE_GROUP_TYPE_SEQ AND
										HHH.SERVICE_GROUP_TYPE_ID = ?
								) AS SENDER_SERVICE_SEQ
							FROM
								(
									SELECT
										A.SERVICE_SEQ,
										A.SERVICE_GROUP_SEQ,
										B.INTERFACE_SEQ,
										MAX(B.VERSION) AS IF_SERV_VERSION
									FROM
										UCUBE_SERVICE_MASTER A,
										UCUBE_INTERFACE_SERVICE B
									WHERE
										A.SERVICE_GROUP_SEQ = ? AND
										A.SERVICE_SEQ = B.SERVICE_SEQ
									GROUP BY A.SERVICE_SEQ, A.SERVICE_GROUP_SEQ, B.INTERFACE_SEQ
								) AA,
								UCUBE_INTERFACE_SERVICE BB,
								UCUBE_INTERFACE_MASTER C
							WHERE
								AA.SERVICE_SEQ = BB.SERVICE_SEQ AND
								AA.INTERFACE_SEQ = BB.INTERFACE_SEQ AND
								AA.IF_SERV_VERSION = BB.VERSION AND
								BB.INTERFACE_SEQ = C.INTERFACE_SEQ
						) AAA,
						UCUBE_INTERFACE D,
						UCUBE_FUNCTION_UNIT_MASTER E
					WHERE
						AAA.INTERFACE_SEQ = D.INTERFACE_SEQ AND
						AAA.IF_VERSION = D.VERSION AND
						AAA.SENDER_SERVICE_SEQ = E.SERVICE_SEQ
				) AAAA
		]]>
	</query>


	<query id="distributeList.selectInterfaceQueueInfo" desc="Interface Queue INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				D.SERVICE_SEQ,
				D.FUNCTION_UNIT_SEQ, E.VERSION,
				F.CONNECTION_SEQ, F.INTERFACE_SEQ,
				G.QUEUE_SEQ, G.QUEUE_ID
			FROM
				UCUBE_FUNCTION_UNIT_MASTER D,
				UCUBE_FUNCTION_UNIT E,
				UCUBE_CONNECTION F,
				UCUBE_QUEUE G
			WHERE
				D.SERVICE_SEQ = ? AND
				D.FUNCTION_UNIT_SEQ = E.FUNCTION_UNIT_SEQ AND
				E.FUNCTION_UNIT_SEQ = F.FUNCTION_UNIT_SEQ AND
				F.INTERFACE_SEQ = ? AND
				F.QUEUE_SEQ = G.QUEUE_SEQ
		]]>
	</query>


	<query id="distributeList.updateIgnoreDispatchManagerStateInfo" desc="Dispatch Master State INFO Update">
		<![CDATA[
			UPDATE
				UCUBE_DISPATCH_MANAGER
			SET
				STATUS_FLAG = 'I'
			WHERE
				SERVICE_GROUP_SEQ = ? AND
				STATUS_FLAG <> 'C' AND STATUS_FLAG <> 'F'
		]]>
	</query>


	<query id="distributeList.updateIgnoreVersionManagerStateInfo" desc="Dispatch Master State INFO Update">
		<![CDATA[
			UPDATE
				UCUBE_VERSION_MANAGER
			SET
				STATUS_FLAG = 'I'
			WHERE
				SERVICE_GROUP_SEQ = ? AND
				STATUS_FLAG <> 'C' AND STATUS_FLAG <> 'F'
		]]>
	</query>


	<query id="distributeList.deleteIgnoreVersionManagerStateInfo" desc="Dispatch Master State INFO Delete" fetchSize="10">
		<![CDATA[
			DELETE FROM
				UCUBE_VERSION_DETAIL
			WHERE
				UCUBE_VERSION_MANAGER_SEQ IN (
					SELECT UCUBE_VERSION_MANAGER_SEQ
					FROM UCUBE_VERSION_MANAGER
					WHERE STATUS_FLAG = ?
				)
		]]>
	</query>


	<query id="distributeList.selectVersionMasterInfo" desc="Version Master INFO Insert" fetchSize="10">
		<![CDATA[
			SELECT
				NEXTVAL('UCUBE_VERSION_MANAGER_UCUBE_VERSION_MANAGER_SEQ_SEQ') AS UCUBE_VERSION_MANAGER_SEQ,
				(COALESCE(MAX(VERSION),0)+1) AS SG_VERSION
			FROM
				UCUBE_VERSION_MANAGER
			WHERE
				SERVICE_GROUP_SEQ = ?
		]]>
	</query>


	<query id="distributeList.insertVersionMasterInfo" desc="Version Master INFO Insert">
		<![CDATA[
			INSERT INTO UCUBE_VERSION_MANAGER (
				UCUBE_VERSION_MANAGER_SEQ, SERVICE_GROUP_SEQ, VERSION, STATUS_FLAG
			)
			VALUES (
				?, ?, ?, 'G'
			)
		]]>
	</query>


	<query id="distributeList.updateDispatchMasterInfo" desc="Version Master INFO Update">
		<![CDATA[
			UPDATE
				UCUBE_DISPATCH_MANAGER
			SET
				STATUS_FLAG = 'G',
				DISPATCH_VERSION = ?
			WHERE
				SERVICE_GROUP_SEQ = ? AND
				STATUS_FLAG = ?
		]]>
	</query>


	<query id="distributeList.insertVersionDetailInfo" desc="Version Detail INFO Insert" fetchSize="10">
		<![CDATA[
			INSERT INTO UCUBE_VERSION_DETAIL (
				UCUBE_VERSION_DETAIL_SEQ, UCUBE_VERSION_MANAGER_SEQ,
				SERVICE_GROUP_VERSION,
				SYSTEM_SEQ, SYSTEM_VERSION,
				SERVICE_SEQ, SERVICE_VERSION,
				FUNCTION_UNIT_SEQ, FUNCTION_UNIT_VERSION,
				INTERFACE_SEQ, INTERFACE_VERSION, INTERFACE_SERVICE_VERSION
			)
			SELECT
				NEXTVAL('UCUBE_VERSION_DETAIL_UCUBE_VERSION_DETAIL_SEQ_SEQ'),
				(
					SELECT UCUBE_VERSION_MANAGER_SEQ
					FROM UCUBE_VERSION_MANAGER
					WHERE SERVICE_GROUP_SEQ = AA.SERVICE_GROUP_SEQ AND
						VERSION = (
							SELECT MAX(VERSION)
							FROM UCUBE_VERSION_MANAGER
							WHERE SERVICE_GROUP_SEQ = AA.SERVICE_GROUP_SEQ
						)
				) AS VERSION_MANAGER_SEQ,
				(
					SELECT MAX(VERSION)
					FROM UCUBE_SERVICE_GROUP
					WHERE SERVICE_GROUP_SEQ = AA.SERVICE_GROUP_SEQ
				) AS SG_VERSION,
				D.SYSTEM_SEQ,
				(
					SELECT MAX(VERSION)
					FROM UCUBE_SYSTEM
					WHERE SYSTEM_SEQ = D.SYSTEM_SEQ
				) AS SYS_VERSION,
				AA.SERVICE_SEQ,
				(
					SELECT MAX(VERSION)
					FROM UCUBE_SERVICE
					WHERE SERVICE_SEQ = AA.SERVICE_SEQ
				) AS SERV_VERSION,
				E.FUNCTION_UNIT_SEQ,
				(
					SELECT MAX(VERSION)
					FROM UCUBE_FUNCTION_UNIT
					WHERE FUNCTION_UNIT_SEQ = E.FUNCTION_UNIT_SEQ
				) AS FUNC_UNIT_VERSION,
				AA.INTERFACE_SEQ,
				(
					SELECT MAX(VERSION)
					FROM UCUBE_INTERFACE
					WHERE INTERFACE_SEQ = AA.INTERFACE_SEQ
				) AS IF_VERSION,
				AA.IF_SERV_VERSION
			FROM
				(
					SELECT
						A.SERVICE_SEQ,
						A.SERVICE_GROUP_SEQ,
						B.INTERFACE_SEQ,
						MAX(B.VERSION) AS IF_SERV_VERSION
					FROM
						UCUBE_SERVICE_MASTER A,
						UCUBE_INTERFACE_SERVICE B
					WHERE
						A.SERVICE_GROUP_SEQ = ? AND
						A.SERVICE_SEQ = B.SERVICE_SEQ
					GROUP BY A.SERVICE_SEQ, A.SERVICE_GROUP_SEQ, B.INTERFACE_SEQ
				) AA,
				UCUBE_SERVICE_GROUP_MASTER C,
				UCUBE_SYSTEM_MASTER D,
				UCUBE_FUNCTION_UNIT_MASTER E
			WHERE
				AA.SERVICE_GROUP_SEQ = C.SERVICE_GROUP_SEQ AND
				C.SYSTEM_SEQ = D.SYSTEM_SEQ AND
				AA.SERVICE_SEQ = E.SERVICE_SEQ
			ORDER BY
				AA.SERVICE_GROUP_SEQ, AA.SERVICE_SEQ, E.FUNCTION_UNIT_SEQ, AA.INTERFACE_SEQ
		]]>
	</query>


	<query id="distributeList.updateDispatchManagerStateInfo" desc="Dispatch Master State INFO Update">
		<![CDATA[
			UPDATE
				UCUBE_DISPATCH_MANAGER
			SET
				STATUS_FLAG = ?
			WHERE
				DISPATCH_VERSION = ? AND
				STATUS_FLAG = ?
		]]>
	</query>


	<query id="distributeList.updateVersionManagerStateInfo" desc="Version Master State INFO Update">
		<![CDATA[
			UPDATE
				UCUBE_VERSION_MANAGER
			SET
				STATUS_FLAG = ?
			WHERE
				UCUBE_VERSION_MANAGER_SEQ = ? AND
				STATUS_FLAG = ?
		]]>
	</query>

	<query id="distributeList.selectBrokerConfInfo" desc="distributeList.selectBrokerConfInfo">
		<![CDATA[
SELECT  * , IP_ADDRESS AS SYS_IP,QUEUE_ID AS QUEUE_NAME
      FROM
        (
          SELECT
            C.SYSTEM_SEQ,
            (
              SELECT MAX(VERSION)
              FROM UCUBE_SYSTEM
              WHERE SYSTEM_SEQ = C.SYSTEM_SEQ
            ) AS SYS_VERSION,
            C.SYSTEM_ID,
            A.SERVICE_GROUP_SEQ,
            (
              SELECT MAX(VERSION)
              FROM UCUBE_SERVICE_GROUP
              WHERE SERVICE_GROUP_SEQ = A.SERVICE_GROUP_SEQ
            ) AS SG_VERSION,
            B.SERVICE_GROUP_TYPE_SEQ,
            K.SERVICE_GROUP_TYPE_ID,
            B.SERVICE_GROUP_ID,
            A.SERVICE_SEQ,
            (
              SELECT MAX(VERSION)
              FROM UCUBE_SERVICE
              WHERE SERVICE_SEQ = A.SERVICE_SEQ
            ) AS SERV_VERSION,
            A.SERVICE_ID,
            D.FUNCTION_UNIT_SEQ,
            (
              SELECT MAX(VERSION)
              FROM UCUBE_FUNCTION_UNIT
              WHERE FUNCTION_UNIT_SEQ = D.FUNCTION_UNIT_SEQ
            ) AS FUNC_UNIT_VERSION,
            D.FUNCTION_UNIT_ID,           
            E.CONNECTION_SEQ,
            F.QUEUE_SEQ,
            F.QUEUE_ID,
            G.ENGINE_SEQ,
            G.JMSPROVIDER_URL,
            G.INITIAL_CONTEXT_FACTORY,
            G.QUEUE_CONNECTION_FACTORY,
            G.QUEUE_PREFIX,
            G.USERNAME,
            G.PASSWORD,
            H.FUNCTION_UNIT_TYPE_ID
          FROM
            UCUBE_SERVICE_MASTER A,
            UCUBE_SERVICE_GROUP_MASTER B,
            UCUBE_SYSTEM_MASTER C,
            UCUBE_FUNCTION_UNIT_MASTER D 
            LEFT OUTER JOIN UCUBE_CONNECTION E
									ON (D.FUNCTION_UNIT_SEQ = E.FUNCTION_UNIT_SEQ)
									LEFT OUTER JOIN UCUBE_QUEUE F
									ON (F.QUEUE_SEQ = + E.QUEUE_SEQ)
									LEFT OUTER JOIN UCUBE_ENGINE G
									ON (G.ENGINE_SEQ = + F.ENGINE_SEQ),
									UCUBE_FUNCTION_UNIT_TYPE H,
									UCUBE_SERVICE_GROUP_TYPE K
          WHERE
            A.SERVICE_GROUP_SEQ = ? AND
            A.SERVICE_GROUP_SEQ = B.SERVICE_GROUP_SEQ AND
            B.SYSTEM_SEQ = C.SYSTEM_SEQ AND
            D.SERVICE_SEQ = A.SERVICE_SEQ  AND
            D.FUNCTION_UNIT_TYPE_SEQ = H.FUNCTION_UNIT_TYPE_SEQ AND
            B.SERVICE_GROUP_TYPE_SEQ = K.SERVICE_GROUP_TYPE_SEQ
            
        ) AA, UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I, UCUBE_SYSTEM J
        WHERE H.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
            H.VERSION = AA.FUNC_UNIT_VERSION AND
            I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
            J.SYSTEM_SEQ = AA.SYSTEM_SEQ AND
            J.VERSION = AA.SYS_VERSION
            ORDER BY SERVICE_SEQ, AA.FUNCTION_UNIT_SEQ  
		]]>
		</query>
		<query id="distributeList.selectDbSql" desc="distributeList.selectDbSql">
		<![CDATA[
SELECT 
C.interface_id,
A.function_unit_seq, 
A.sql_seq, 
A.type, 
A.post_sql, 
A.param_start, 
A.param_length, 
A.sql, 
B.p_sql_result As child_p_sql_result,
B.type AS child_type,
B.param_start AS child_param_start,
B.param_length AS child_param_length,
B.sql AS child_sql
FROM
(
SELECT D.function_unit_seq, MAX(D.version) AS version
FROM ucube_service_group_master A, ucube_service_master B, ucube_function_UNIT_master C, ucube_dbadapter_sql_parent D 
WHERE A.SERVICE_GROUP_SEQ = B.SERVICE_GROUP_SEQ AND
B.SERVICE_SEQ = C.SERVICE_SEQ AND
C.FUNCTION_UNIT_SEQ =D.FUNCTION_UNIT_SEQ AND
A.SERVICE_GROUP_SEQ = ?
GROUP BY D.function_unit_seq
) AA, ucube_dbadapter_sql_parent A
LEFT OUTER JOIN ucube_dbadapter_sql_child B
ON (
A.function_unit_seq = B.function_unit_seq AND
A.version = B.version AND
A.sql_seq = B.sql_seq 
),
ucube_interface_master C
WHERE  AA.function_unit_seq =A.function_unit_seq AND 
AA.version = A.version AND
A.interface_seq = C.interface_seq
		]]>
	</query>
		<query id="distributeList.selectLayout" desc="distributeList.selectLayout">
		<![CDATA[
SELECT *
FROM 
(
SELECT D.interface_seq, D.function_unit_seq, MAX(D.version) AS version
FROM ucube_service_group_master A, ucube_service_master B, ucube_function_UNIT_master C, ucube_dbadapter_layout_parent D 
WHERE A.SERVICE_GROUP_SEQ = B.SERVICE_GROUP_SEQ AND
B.SERVICE_SEQ = C.SERVICE_SEQ AND
C.FUNCTION_UNIT_SEQ =D.FUNCTION_UNIT_SEQ AND
A.SERVICE_GROUP_SEQ = ?
GROUP BY D.interface_seq, D.function_unit_seq
) AA, 
ucube_dbadapter_layout_parent A
LEFT OUTER JOIN ucube_dbadapter_layout_child B
ON (
A.function_unit_seq = B.function_unit_seq AND
A.version = B.version AND
A.linkage_sql_seq = B.linkage_sql_seq 
),
ucube_interface_master C
WHERE 
AA.interface_seq = A.interface_seq AND
AA.function_unit_seq = A.function_unit_seq AND
AA.version = A.version AND
A.interface_seq = C.interface_seq
		]]>
	</query>	
</queryMap>

<?xml version='1.0' encoding='EUC-KR'?>
<queryMap desc="uComposer Project Query File">

	<query id="uComposerSystemMaster.insert" desc="uComposerSystem insert01" fetchSize="10">
		<![CDATA[
			INSERT INTO ucube_system_master(system_id) 
			VALUES (?)
		]]>
	</query>

	<query id="uComposerSystemMaster.select" desc="uComposerSystem select01" fetchSize="10">
		<![CDATA[
			SELECT system_seq, system_id
  			FROM ucube_system_master 
  			WHERE system_id = ?
		]]>
	</query>
	
	<query id="uComposerSystem.insert" desc="uComposerSystem insert" fetchSize="10">
		<![CDATA[
			INSERT INTO ucube_system(
		            system_seq, version, description, ip_address, host_name, 
		            hw, os, os_version, language_support, online_backup, 
		            eai_base_directory, ucube_user_seq, last_updated_timestamp)
		    VALUES (?, coalesce((SELECT MAX(version)+1 FROM ucube_system WHERE system_seq = ?), 1), ?, ?, ?, 
		    		?, ?, ?, ?, ?,  
		            ?, ?, NOW());
		]]>
	</query>

	<query id="uComposerSystem.select" desc="System Select" fetchSize="10">
		<![CDATA[
			SELECT *
  			FROM ucube_system_master sm, ucube_system sy
  			WHERE sm.system_seq = sy.system_seq AND sy.system_seq = ? 
  				AND version = (SELECT MAX(version) FROM ucube_system WHERE system_seq = sy.system_seq)
		]]>
	</query>
	
	<query id="uComposerSystemAll.select" desc="uComposerSystem select01" fetchSize="10">
		<![CDATA[
			SELECT system_seq, system_id
  			FROM ucube_system_master
  			WHERE usable IS NOT FALSE
		]]>
	</query>	
	
</queryMap>
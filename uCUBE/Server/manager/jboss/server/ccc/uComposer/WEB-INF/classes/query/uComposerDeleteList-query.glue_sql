<?xml version='1.0' encoding='UTF-8'?>
<queryMap desc="uComposer Project Query File">

	<query id="uComposerDeleteSystem.delete" desc="System Delete" fetchSize="10">
		<![CDATA[
			UPDATE 
				ucube_system_master
			SET 
				usable = FALSE
			WHERE 
				system_seq = ?
		]]>
	</query>
	
	<query id="uComposerDeleteServiceGroup.delete" desc="ServiceGroup Delete" fetchSize="10">
		<![CDATA[
			UPDATE 
				ucube_service_group_master
			SET 
				usable = FALSE
			WHERE 
				service_group_seq = ?
		]]>
	</query>
	
	<query id="uComposerDeleteService.delete" desc="Service Delete" fetchSize="10">
		<![CDATA[
			UPDATE 
				ucube_service_master
			SET 
				usable = FALSE
			WHERE 
				service_seq = ?
		]]>
	</query>

	<query id="uComposerDeleteInterface.delete" desc="Interface Delete" fetchSize="10">
		<![CDATA[
			UPDATE 
				ucube_interface_master
			SET 
				usable = FALSE
			WHERE 
				interface_seq = ?
		]]>
	</query>
	

</queryMap>

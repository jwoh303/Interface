<?xml version='1.0' encoding='EUC-KR'?>
<queryMap desc="uComposer Project Query File">

	<query id="uComposerInterfaceMaster.insert" desc="Interface Master Insert" fetchSize="10">
		<![CDATA[
    		INSERT INTO ucube_interface_master(
				interface_id)
    		VALUES (?);
		]]>
	</query>
	
	<query id="uComposerInterfaceMaster.select" desc="Interface Master Select" fetchSize="10">
		<![CDATA[
    		SELECT 
    			interface_seq
    		FROM 
    			ucube_interface_master
			WHERE	
    			interface_id = ?
		]]>
	</query>
	
	<query id="uComposerInterface.insert" desc="Interface Insert" fetchSize="10">
		<![CDATA[
    		INSERT INTO ucube_interface(
		            interface_seq, 
		            version, 
		            description, 
		            interface_source_type, 
		            interface_target_type, 
		            persistent, 
		            sequential_data, 
		            destination_directory, 
		            destination_file_name, 
		            use_source_file_name, 
		            delimiter, 
		            file_type, 
		            file_action, 
		            file_chunk_size, 
		            post_processing_action, 
		            post_processing_directory, 
		            post_processing_file_name, 
		            post_processing_overwrite, 
		            post_processing_file_count, 
		            system_command, 
		            ucube_user_seq, 
		            last_updated_timestamp)
		    VALUES (?, coalesce((SELECT MAX(version)+1 FROM ucube_interface WHERE interface_seq = ?), 1), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NOW())
		]]>
	</query>

	<query id="uComposerInterface.select" desc="Interface Select" fetchSize="10">
		<![CDATA[
    		SELECT 
    			*
    		FROM 
    			ucube_interface_master im, ucube_interface int
			WHERE	
    			im.interface_seq = int.interface_seq AND int.interface_seq = ?
    			AND version = (SELECT MAX(version) FROM ucube_interface WHERE interface_seq = int.interface_seq)
		]]>
	</query>
	
	<query id="uComposerInterfaceAll.select" desc="Interface All Select" fetchSize="10">
		<![CDATA[
    		SELECT 
    			ima.*, (SELECT COUNT(*) FROM ucube_interface_service WHERE interface_seq=ima.interface_seq) AS intervace_used_cnt
    		FROM 
    			ucube_interface_master ima
    		WHERE
    			usable IS NOT FALSE	
		]]>
	</query>
	
</queryMap>

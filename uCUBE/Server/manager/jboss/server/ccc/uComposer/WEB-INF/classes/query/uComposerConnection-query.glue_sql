<?xml version='1.0' encoding='EUC-KR'?>
<queryMap desc="uComposer Project Query File">

	<query id="uComposerFunctionUnitMasterByService.select" desc="functionUnit Master Insert" fetchSize="10">
		<![CDATA[
    		SELECT *
	    	FROM ucube_function_unit_master fum, ucube_function_unit_type fut
	        WHERE service_seq = ? 
				AND  fum.function_unit_type_seq =  fut.function_unit_type_seq
				AND port_type = ?
 		]]>
	</query>

	<query id="uComposerEngine.insert" desc="Engine Insert" fetchSize="10">
		<![CDATA[
    		INSERT INTO ucube_engine(
	            engine_id, description, type, jmsprovider_url, 
	            initial_context_factory, queue_connection_factory, topic_prefix, 
	            queue_prefix, username, "password")
   			VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
		]]>
	</query>
	
	<query id="uComposerEngine.select" desc="Engine Select" fetchSize="10">
		<![CDATA[
    		SELECT 
    			engine_seq
    		FROM 
    			ucube_engine
			WHERE	
    			engine_id=?
		]]>
	</query>

	<query id="uComposerEngineAll.select" desc="Engine Select" fetchSize="10">
		<![CDATA[
    		SELECT 
    			*
    		FROM 
    			ucube_engine
		]]>
	</query>

	<query id="uComposerQueue.insert" desc="Queue Insert" fetchSize="10">
		<![CDATA[
    		INSERT INTO ucube_queue(
            	queue_id, description, engine_seq)
    		VALUES (?, ?, ?);
		]]>
	</query>
	
	<query id="uComposerQueue.select" desc="Queue Select" fetchSize="10">
		<![CDATA[
    		SELECT 
    			queue_seq
    		FROM 
    			ucube_queue
			WHERE	
    			queue_id=?
		]]>
	</query>

	<query id="uComposerQueueAll.select" desc="Queue Select" fetchSize="10">
		<![CDATA[
    		SELECT 
    			*
    		FROM 
    			ucube_queue
		]]>
	</query>

	<query id="uComposerConnection.insert" desc="Connection Insert" fetchSize="10">
		<![CDATA[
    		INSERT INTO ucube_connection(
            	function_unit_seq, queue_seq, interface_seq)
    		VALUES (?, ?, ?);
		]]>
	</query>
	
	<query id="uComposerConnection.select" desc="Connection Select" fetchSize="10">
		<![CDATA[
			SELECT  
				con.queue_seq, que.engine_seq, que.queue_id, eng.engine_id
			FROM 
				ucube_connection con, ucube_queue que, ucube_engine eng
			WHERE 
				con.queue_seq = que.queue_seq
				AND que.engine_seq = eng.engine_seq
				AND function_unit_seq = ?
				AND interface_seq = ?
		]]>
	</query>

	<query id="uComposerConnection.delete" desc="Connection Delete" fetchSize="10">
		<![CDATA[
    		DELETE FROM 
    			ucube_connection con
            WHERE	
            	queue_seq = (SELECT queue_seq FROM ucube_connection WHERE function_unit_seq = ? AND interface_seq = con.interface_seq) 
            	AND interface_seq = ?
		]]>
	</query>

	<query id="uComposerConnection2.delete" desc="Connection Delete" fetchSize="10">
		<![CDATA[
    		DELETE FROM 
    			ucube_connection con
            WHERE	
            	queue_seq = ? 
            	AND interface_seq = ?
		]]>
	</query>
		
	<query id="uComposerConnectionAll.select" desc="Connection Select" fetchSize="10">
		<![CDATA[
    		SELECT 
    			connection_seq, qu.queue_seq, engine_seq
    		FROM 
    			ucube_connection co, ucube_queue qu
			WHERE	
    			co.queue_seq=qu.queue_seq 
    			AND interface_seq = ?
		]]>
	</query>
		
</queryMap>

<?xml version="1.0" encoding="EUC-KR"?>
<service name="distributeList-service" initial="EventRouter">

	<activity name="EventRouter" class="com.posdata.glue.biz.activity.PosDefaultRouter">
		<transition name="find.x" value="Select" />
		<transition name="distribute.x" value="Distribute" />

		<transition name="distreset.x" value="ResetDistribute" />
	</activity>

	<activity name="Select" class="com.posdata.eai.distributor.SelectDistributeList">
		<transition name="success" value="end" />
	</activity>

	<activity name="Distribute" class="com.posdata.eai.distributor.Distribute">
		<transition name="success" value="Select" />
		<property name="pfrom" value="normal" />
	</activity>

	<activity name="ResetDistribute" class="com.posdata.eai.distributor.ResetDistribute">
		<transition name="success" value="Select" />
	</activity>

</service>

<?xml version="1.0" encoding="UTF-8"?>
<service name="serviceConfigManager-service" initial="EventRouter">
  <activity name="CreateServiceConfigFile" class="com.posdata.eai.ucomposer.ServiceConfigFileManager">
    <transition name="success" value="end" />
  </activity>
  <activity name="ModifyServiceConfigFile" class="com.posdata.eai.ucomposer.ServiceConfigFileManager">
    <transition name="success" value="end" />
  </activity>
  <activity name="GetSeviceConfigFile" class="com.posdata.eai.ucomposer.ServiceConfigFileInfo">
    <transition name="success" value="end" />
  </activity>
  <activity name="EventRouter" class="com.posdata.glue.biz.activity.PosDefaultRouter">
    <transition name="find.x" value="GetSeviceConfigFile" />
    <transition name="delete.x" value="DeleteServiceConfigFile" />
    <transition name="insert.x" value="CreateServiceConfigFile" />
    <transition name="update.x" value="ModifyServiceConfigFile" />
  </activity>
  <activity name="DeleteServiceConfigFile" class="com.posdata.eai.ucomposer.ServiceConfigFileManager">
    <transition name="success" value="GetSeviceConfigFile" />
  </activity>
</service>


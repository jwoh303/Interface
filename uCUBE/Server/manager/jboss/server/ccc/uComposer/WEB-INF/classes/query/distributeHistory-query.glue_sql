<?xml version='1.0' encoding='EUC-KR'?>
<queryMap desc="uComposer Project Query File">

	<query id="distributeAllHistory.select" desc="Distribute History List Select" fetchSize="10">
		<![CDATA[
			SELECT
				A.SYSTEM_SEQ, B.SYSTEM_ID,
				A.SERVICE_GROUP_SEQ, C.SERVICE_GROUP_ID,
				D.SERVICE_SEQ, D.SERVICE_ID,
				E.INTERFACE_SEQ, E.INTERFACE_ID,
				H.SERVICE_GROUP_TYPE_ID,
				G.UCUBE_USERS_SEQ, F.USER_ID,
				A.DISPATCH_VERSION, G.STATUS_FLAG,
				TO_CHAR(G.DISPATCHED_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS') AS DISPATCHED_TIME,
				TO_CHAR(G.RECEIVED_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS') AS RECEIVED_TIME,
				TO_CHAR(G.RUNED_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS') AS RUNED_TIME,
				G.REDISPATCHED_SEQ,
				(
					CASE WHEN G.REDISPATCHED_SEQ IS NOT NULL THEN
						(
							SELECT TO_CHAR(DISPATCHED_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS')
							FROM UCUBE_VERSION_MANAGER
							WHERE UCUBE_VERSION_MANAGER_SEQ = G.REDISPATCHED_SEQ
						)
						ELSE ''
					END
				) AS REDISPATCHED_TIME
			FROM
				UCUBE_DISPATCH_MANAGER A
					LEFT OUTER JOIN UCUBE_VERSION_MANAGER G
					ON (A.DISPATCH_VERSION = G.UCUBE_VERSION_MANAGER_SEQ)
					LEFT OUTER JOIN UCUBE_USERS F
					ON (G.UCUBE_USERS_SEQ = F.UCUBE_USERS_SEQ),
				UCUBE_SYSTEM_MASTER B,
				UCUBE_SERVICE_GROUP_MASTER C
					LEFT OUTER JOIN UCUBE_SERVICE_MASTER D
							ON (D.SERVICE_GROUP_SEQ = C.SERVICE_GROUP_SEQ)
							LEFT OUTER JOIN UCUBE_INTERFACE_SERVICE J
							ON (J.SERVICE_SEQ = D.SERVICE_SEQ)
							LEFT OUTER JOIN UCUBE_INTERFACE_MASTER E
							ON (E.INTERFACE_SEQ = J.INTERFACE_SEQ),
				UCUBE_SERVICE_GROUP_TYPE H
			WHERE
				A.STATUS_FLAG <> 'C' AND
				A.SYSTEM_SEQ = B.SYSTEM_SEQ AND
				A.SERVICE_GROUP_SEQ = C.SERVICE_GROUP_SEQ AND
				C.SERVICE_GROUP_TYPE_SEQ = H.SERVICE_GROUP_TYPE_SEQ
			ORDER BY DISPATCHED_TIME, B.SYSTEM_ID, C.SERVICE_GROUP_ID, D.SERVICE_ID, E.INTERFACE_ID
		]]>
	</query>
	
    <query id="distributeHistory.select" desc="Distribute History List Select" fetchSize="10">
		<![CDATA[
		       SELECT   SYSTEM_SEQ, SYSTEM_ID, SERVICE_GROUP_SEQ, SERVICE_GROUP_ID, SERVICE_SEQ, SERVICE_ID,
			   INTERFACE_SEQ,  INTERFACE_ID, SERVICE_GROUP_TYPE_ID, UCUBE_USERS_SEQ ,USER_ID,
               DISPATCH_VERSION, STATUS_FLAG,  DISPATCHED_TIME, RECEIVED_TIME, RUNED_TIME , REDISPATCHED_TIME
                FROM( 
                SELECT
				A.SYSTEM_SEQ, B.SYSTEM_ID,
				A.SERVICE_GROUP_SEQ, C.SERVICE_GROUP_ID,
				D.SERVICE_SEQ, D.SERVICE_ID,
				E.INTERFACE_SEQ, E.INTERFACE_ID,
				H.SERVICE_GROUP_TYPE_ID,
				G.UCUBE_USERS_SEQ, F.USER_ID,
				A.DISPATCH_VERSION, G.STATUS_FLAG,
				TO_CHAR(G.DISPATCHED_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS') AS DISPATCHED_TIME,
				TO_CHAR(G.RECEIVED_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS') AS RECEIVED_TIME,
				TO_CHAR(G.RUNED_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS') AS RUNED_TIME,
				G.REDISPATCHED_SEQ,
				(
					CASE WHEN G.REDISPATCHED_SEQ IS NOT NULL THEN
						(
							SELECT TO_CHAR(DISPATCHED_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS')
							FROM UCUBE_VERSION_MANAGER
							WHERE UCUBE_VERSION_MANAGER_SEQ = G.REDISPATCHED_SEQ
						)
						ELSE ''
					END
				) AS REDISPATCHED_TIME
			FROM
				UCUBE_DISPATCH_MANAGER A
					LEFT OUTER JOIN UCUBE_VERSION_MANAGER G
					ON (A.DISPATCH_VERSION = G.UCUBE_VERSION_MANAGER_SEQ)
					LEFT OUTER JOIN UCUBE_USERS F
					ON (G.UCUBE_USERS_SEQ = F.UCUBE_USERS_SEQ),
				UCUBE_SYSTEM_MASTER B,
				UCUBE_SERVICE_GROUP_MASTER C
					LEFT OUTER JOIN UCUBE_SERVICE_MASTER D
							ON (D.SERVICE_GROUP_SEQ = C.SERVICE_GROUP_SEQ)
							LEFT OUTER JOIN UCUBE_INTERFACE_SERVICE J
							ON (J.SERVICE_SEQ = D.SERVICE_SEQ)
							LEFT OUTER JOIN UCUBE_INTERFACE_MASTER E
							ON (E.INTERFACE_SEQ = J.INTERFACE_SEQ),
				UCUBE_SERVICE_GROUP_TYPE H
			WHERE
				A.STATUS_FLAG <> 'C' AND
				A.SYSTEM_SEQ = B.SYSTEM_SEQ AND
				A.SERVICE_GROUP_SEQ = C.SERVICE_GROUP_SEQ AND
				C.SERVICE_GROUP_TYPE_SEQ = H.SERVICE_GROUP_TYPE_SEQ
			ORDER BY DISPATCHED_TIME, B.SYSTEM_ID, C.SERVICE_GROUP_ID, D.SERVICE_ID, E.INTERFACE_ID
			)RESULT
		   WHERE 
		         DISPATCHED_TIME BETWEEN ? AND ?
		         AND RESULT.SYSTEM_ID LIKE '%'||? ||'%'
		         AND RESULT.SERVICE_GROUP_ID LIKE '%'||?||'%'
		         AND RESULT.SERVICE_ID LIKE '%'||?||'%'        
		         ORDER BY DISPATCHED_TIME, SYSTEM_ID, SERVICE_GROUP_ID, SERVICE_ID, INTERFACE_ID
		
			]]>
	</query>

	<query id="distributeHistory.selectSenderReceiverInfo" desc="Sender Receiver INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				AA.*,
				(
					SELECT IP_ADDRESS
					FROM UCUBE_SYSTEM
					WHERE SYSTEM_SEQ = AA.SYSTEM_SEQ AND
					VERSION = AA.SYS_VERSION
				) AS SYS_IP,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'TYPE'
				) AS COL_TYPE,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'SOURCE_NAME'
				) AS COL_SOURCENAME,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'CLASS_NAME'
				) AS COL_CLASS,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'RUN_TYPE'
				) AS COL_RUNTYPE,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'DESTINATION_TYPE'
				) AS COL_DESTINATIONTYPE,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'DESTINATION_NAME'
				) AS COL_DESTINATIONNAME,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'ENABLE_LOCALQUEUE'
				) AS COL_LOCALQUEUE,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'MAX_LQ_SIZE'
				) AS COL_MAXLQSIZE,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'ONMESSAGE_WAIT_TIME'
				) AS COL_ONMESSAGEWAITTIME
			FROM
				(
					SELECT
						B.SYSTEM_SEQ,
						B.SYSTEM_VERSION AS SYS_VERSION,
						C.SYSTEM_ID,
						A.SERVICE_GROUP_SEQ,
						B.SERVICE_GROUP_VERSION AS SG_VERSION,
						D.SERVICE_GROUP_ID,
						B.SERVICE_SEQ,
						B.SERVICE_VERSION AS SERV_VERSION,
						E.SERVICE_ID,
						B.FUNCTION_UNIT_SEQ,
						B.FUNCTION_UNIT_VERSION AS FUNC_UNIT_VERSION,
						F.CONNECTION_SEQ,
						G.QUEUE_SEQ,
						G.QUEUE_ID,
						H.ENGINE_SEQ,
						H.JMSPROVIDER_URL,
						H.INITIAL_CONTEXT_FACTORY,
						H.QUEUE_CONNECTION_FACTORY,
						H.QUEUE_PREFIX,
						H.USERNAME,
						H.PASSWORD
					FROM
						UCUBE_VERSION_MANAGER A,
						UCUBE_VERSION_DETAIL B,
						UCUBE_SYSTEM_MASTER C,
						UCUBE_SERVICE_GROUP_MASTER D,
						UCUBE_SERVICE_MASTER E,
						UCUBE_CONNECTION F,
						UCUBE_QUEUE G,
						UCUBE_ENGINE H
					WHERE
						A.UCUBE_VERSION_MANAGER_SEQ = ? AND
						A.UCUBE_VERSION_MANAGER_SEQ = B.UCUBE_VERSION_MANAGER_SEQ AND
						B.SYSTEM_SEQ = C.SYSTEM_SEQ AND
						A.SERVICE_GROUP_SEQ = D.SERVICE_GROUP_SEQ AND
						B.SERVICE_SEQ = E.SERVICE_SEQ AND
						B.FUNCTION_UNIT_SEQ = F.FUNCTION_UNIT_SEQ AND
						G.QUEUE_SEQ = F.QUEUE_SEQ AND
						H.ENGINE_SEQ = G.ENGINE_SEQ
				) AA
		]]>
	</query>


	<query id="distributeHistory.selectBridgeBrokerCntInfo" desc="Bridge INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				B.SYSTEM_SEQ,
				B.SYSTEM_VERSION AS SYS_VERSION,
				C.SYSTEM_ID,
				A.SERVICE_GROUP_SEQ,
				B.SERVICE_GROUP_VERSION AS SG_VERSION,
				D.SERVICE_GROUP_ID,
				B.SERVICE_SEQ,
				B.SERVICE_VERSION AS SERV_VERSION,
				E.SERVICE_ID,
				F.IP_ADDRESS AS SYS_IP
			FROM
				UCUBE_VERSION_MANAGER A,
				UCUBE_VERSION_DETAIL B,
				UCUBE_SYSTEM_MASTER C,
				UCUBE_SERVICE_GROUP_MASTER D,
				UCUBE_SERVICE_MASTER E,
				UCUBE_SYSTEM F
			WHERE
				A.UCUBE_VERSION_MANAGER_SEQ = ? AND
				A.UCUBE_VERSION_MANAGER_SEQ = B.UCUBE_VERSION_MANAGER_SEQ AND
				B.SYSTEM_SEQ = C.SYSTEM_SEQ AND
				A.SERVICE_GROUP_SEQ = D.SERVICE_GROUP_SEQ AND
				B.SERVICE_SEQ = E.SERVICE_SEQ AND
				B.SYSTEM_SEQ = F.SYSTEM_SEQ
			ORDER BY E.SERVICE_ID
		]]>
	</query>


	<query id="distributeHistory.selectBridgeInfo" desc="Bridge INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				AA.*,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'POSITION'
				) AS COL_POSITION,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'INIT'
				) AS COL_INIT,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'CONFIG_FILE'
				) AS COL_CONFIG_FILE,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'RUN_TYPE'
				) AS COL_RUNTYPE,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'NEXT_SERVICE_NAME'
				) AS COL_NS_NAME,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'NEXT_SERVICE_FROM_SPECIFIC_INFO'
				) AS COL_NS_FROM_SPEC_INFO,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'NEXT_SERVICE_KEEP_TRANSACTION'
				) AS COL_NS_KEEP_TRANSACTION
			FROM
				(
					SELECT
						A.SERVICE_GROUP_SEQ,
						B.SERVICE_SEQ,
						B.SERVICE_VERSION AS SERV_VERSION,
						C.SERVICE_ID,
						B.FUNCTION_UNIT_SEQ,
						B.FUNCTION_UNIT_VERSION AS FUNC_UNIT_VERSION,
						D.FUNCTION_UNIT_ID,
						D.FUNCTION_UNIT_TYPE_SEQ,
						E.FUNCTION_UNIT_TYPE_ID
					FROM
						UCUBE_VERSION_MANAGER A,
						UCUBE_VERSION_DETAIL B,
						UCUBE_SERVICE_MASTER C,
						UCUBE_FUNCTION_UNIT_MASTER D,
						UCUBE_FUNCTION_UNIT_TYPE E
					WHERE
						A.UCUBE_VERSION_MANAGER_SEQ = ? AND
						A.UCUBE_VERSION_MANAGER_SEQ = B.UCUBE_VERSION_MANAGER_SEQ AND
						B.SERVICE_SEQ = C.SERVICE_SEQ AND
						B.FUNCTION_UNIT_SEQ = D.FUNCTION_UNIT_SEQ AND
						D.FUNCTION_UNIT_TYPE_SEQ = E.FUNCTION_UNIT_TYPE_SEQ
					ORDER BY E.FUNCTION_UNIT_TYPE_ID DESC
				) AA
		]]>
	</query>


	<query id="distributeHistory.selectBridgeConfInfo" desc="Bridge Config INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				AA.*,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'TYPE'
				) AS COL_TYPE,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'SOURCE_NAME'
				) AS COL_SOURCENAME,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'CLASS_NAME'
				) AS COL_CLASS,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'RUN_TYPE'
				) AS COL_RUNTYPE,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'DESTINATION_TYPE'
				) AS COL_DESTINATIONTYPE,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'DESTINATION_NAME'
				) AS COL_DESTINATIONNAME,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'ENABLE_LOCALQUEUE'
				) AS COL_LOCALQUEUE,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'MAX_LQ_SIZE'
				) AS COL_MAXLQSIZE,
				(
					SELECT I.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS I, UCUBE_COLUMN_NAME_DEFINITION J
					WHERE I.FUNCTION_UNIT_SEQ = AA.FUNCTION_UNIT_SEQ AND
						I.VERSION = AA.FUNC_UNIT_VERSION AND
						J.COLUMN_NAME_DEFINITION_SEQ = I.COLUMN_NAME_DEFINITION_SEQ AND
						J.COLUMN_NAME_DEFINITION_ID = 'ONMESSAGE_WAIT_TIME'
				) AS COL_ONMESSAGEWAITTIME
			FROM
				(
					SELECT
						A.SERVICE_GROUP_SEQ,
						B.SERVICE_GROUP_VERSION AS SG_VERSION,
						B.SERVICE_SEQ,
						B.SERVICE_VERSION AS SERV_VERSION,
						C.SERVICE_ID,
						B.FUNCTION_UNIT_SEQ,
						B.FUNCTION_UNIT_VERSION AS FUNC_UNIT_VERSION,
						E.FUNCTION_UNIT_TYPE_ID,
						F.CONNECTION_SEQ,
						G.QUEUE_SEQ,
						G.QUEUE_ID,
						H.ENGINE_SEQ,
						H.JMSPROVIDER_URL,
						H.INITIAL_CONTEXT_FACTORY,
						H.QUEUE_CONNECTION_FACTORY,
						H.QUEUE_PREFIX,
						H.USERNAME,
						H.PASSWORD
					FROM
						UCUBE_VERSION_MANAGER A,
						UCUBE_VERSION_DETAIL B,
						UCUBE_SERVICE_MASTER C,
						UCUBE_FUNCTION_UNIT_MASTER D,
						UCUBE_FUNCTION_UNIT_TYPE E,
						UCUBE_CONNECTION F,
						UCUBE_QUEUE G,
						UCUBE_ENGINE H
					WHERE
						A.UCUBE_VERSION_MANAGER_SEQ = ? AND
						A.UCUBE_VERSION_MANAGER_SEQ = B.UCUBE_VERSION_MANAGER_SEQ AND
						B.SERVICE_SEQ = C.SERVICE_SEQ AND
						B.FUNCTION_UNIT_SEQ = D.FUNCTION_UNIT_SEQ AND
						D.FUNCTION_UNIT_TYPE_SEQ = E.FUNCTION_UNIT_TYPE_SEQ AND
						E.FUNCTION_UNIT_TYPE_ID = ? AND
						B.FUNCTION_UNIT_SEQ = F.FUNCTION_UNIT_SEQ AND
						F.QUEUE_SEQ = G.QUEUE_SEQ AND
						G.ENGINE_SEQ = H.ENGINE_SEQ
				) AA
		]]>
	</query>


	<query id="distributeHistory.selectCommMonInfo" desc="Destination INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				AA.*,
				C.EAI_BASE_DIRECTORY,
				B.SRC_PC,
				B.RECONNECT_INTERVAL,
				B.EVENT_QUEUE,
				B.DATA_QUEUE,
				B.ENCODING_VALUE,
				B.ENABLE_MONITOR,
				B.BACK_GROUND_CONN,
				B.TYPE,
				B.DESTINATION_NAME,
				B.JMSPROVIDER_URL,
				B.INITIAL_CONTEXT_FACTORY,
				B.TOPIC_CONNECTION_FACTORY,
				B.TOPIC_NAME,
				B.RECONNECT_TRY_COUNT,
				B.USERNAME,
				B.PASSWORD,
				B.ENABLE_LOCALQUEUE,
				B.SEND_STATUS_INTERVAL,
				B.TOPIC_PREFIX
			FROM
				(
					SELECT
						A.SERVICE_GROUP_SEQ,
						B.SERVICE_GROUP_VERSION AS SG_VERSION,
						c.SERVICE_GROUP_ID,
						b.SYSTEM_SEQ,
						B.SYSTEM_VERSION AS SYS_VERSION
					FROM
						UCUBE_VERSION_MANAGER A,
						UCUBE_VERSION_DETAIL B,
						UCUBE_SERVICE_GROUP_MASTER c
					WHERE
						A.UCUBE_VERSION_MANAGER_SEQ = ? AND
						A.UCUBE_VERSION_MANAGER_SEQ = B.UCUBE_VERSION_MANAGER_SEQ AND
						a.SERVICE_GROUP_SEQ = C.SERVICE_GROUP_SEQ
				) AA,
				UCUBE_SERVICE_GROUP B,
				UCUBE_SYSTEM C
			WHERE
				B.SERVICE_GROUP_SEQ = AA.SERVICE_GROUP_SEQ AND
				B.VERSION = AA.SG_VERSION AND
				C.SYSTEM_SEQ = AA.SYSTEM_SEQ AND
				C.VERSION = AA.SYS_VERSION
		]]>
	</query>


	<query id="distributeHistory.selectInterfaceInfo" desc="Interface INFO Select" fetchSize="10">
		<![CDATA[
			SELECT
				AAAA.*,
				(
					SELECT H.COLUMN_VALUE
					FROM UCUBE_FUNCTION_UNIT_COLUMNS H, UCUBE_COLUMN_NAME_DEFINITION I
					WHERE H.FUNCTION_UNIT_SEQ = AAAA.SENDER_SERVICE_FUSEQ AND
						H.VERSION = AAAA.SENDER_SERVICE_FUVERSION AND
						I.COLUMN_NAME_DEFINITION_SEQ = H.COLUMN_NAME_DEFINITION_SEQ AND
						I.COLUMN_NAME_DEFINITION_ID = 'DESTINATION_NAME'
				) AS DESTINATION_NAME
			FROM
				(
					SELECT
						AAA.*,
						(
							SELECT SERVICE_ID
							FROM UCUBE_SERVICE_MASTER
							WHERE SERVICE_SEQ = AAA.SENDER_SERVICE_SEQ
						) AS ADAPTER_NAME,
						E.FUNCTION_UNIT_SEQ AS SENDER_SERVICE_FUSEQ,
						(
							SELECT MAX(VERSION)
							FROM UCUBE_FUNCTION_UNIT
							WHERE FUNCTION_UNIT_SEQ = E.FUNCTION_UNIT_SEQ
						) AS SENDER_SERVICE_FUVERSION,
						D.INTERFACE_SOURCE_TYPE, D.INTERFACE_TARGET_TYPE, D.PERSISTENT, D.SEQUENTIAL_DATA, D.DESTINATION_DIRECTORY,
						D.DESTINATION_FILE_NAME, D.USE_SOURCE_FILE_NAME, D.DELIMITER, D.FILE_TYPE, D.FILE_ACTION,
						D.FILE_CHUNK_SIZE, D.POST_PROCESSING_ACTION, D.POST_PROCESSING_DIRECTORY, D.POST_PROCESSING_FILE_NAME, D.POST_PROCESSING_OVERWRITE,
						D.POST_PROCESSING_FILE_COUNT, D.SYSTEM_COMMAND
					FROM
						(
							SELECT
								AA.*,
								(
									SELECT BBB.SERVICE_SEQ
									FROM
										UCUBE_INTERFACE_SERVICE BBB,
										UCUBE_SERVICE_MASTER FFF,
										UCUBE_SERVICE_GROUP_MASTER GGG,
										UCUBE_SERVICE_GROUP_TYPE HHH
									WHERE
										BBB.INTERFACE_SEQ = AA.INTERFACE_SEQ AND
										BBB.VERSION = AA.IF_SERV_VERSION AND
										BBB.SERVICE_SEQ = FFF.SERVICE_SEQ AND
										FFF.SERVICE_GROUP_SEQ = GGG.SERVICE_GROUP_SEQ AND
										GGG.SERVICE_GROUP_TYPE_SEQ = HHH.SERVICE_GROUP_TYPE_SEQ AND
										HHH.SERVICE_GROUP_TYPE_ID = 'JMS_Sender'
								) AS SENDER_SERVICE_SEQ
							FROM
								(
									SELECT
										B.SERVICE_SEQ,
										A.SERVICE_GROUP_SEQ,
										B.INTERFACE_SEQ,
										C.INTERFACE_ID,
										B.INTERFACE_VERSION AS IF_VERSION,
										B.INTERFACE_SERVICE_VERSION AS IF_SERV_VERSION
									FROM
										UCUBE_VERSION_MANAGER A,
										UCUBE_VERSION_DETAIL B,
										UCUBE_INTERFACE_MASTER C
									WHERE
										A.UCUBE_VERSION_MANAGER_SEQ = ? AND
										A.UCUBE_VERSION_MANAGER_SEQ = B.UCUBE_VERSION_MANAGER_SEQ AND
										B.INTERFACE_SEQ = C.INTERFACE_SEQ
									GROUP BY B.SERVICE_SEQ, A.SERVICE_GROUP_SEQ, B.INTERFACE_SEQ, C.INTERFACE_ID, B.INTERFACE_VERSION, B.INTERFACE_SERVICE_VERSION
								) AA
						) AAA,
						UCUBE_INTERFACE D,
						UCUBE_FUNCTION_UNIT_MASTER E
					WHERE
						AAA.INTERFACE_SEQ = D.INTERFACE_SEQ AND
						AAA.IF_VERSION = D.VERSION AND
						AAA.SENDER_SERVICE_SEQ = E.SERVICE_SEQ
				) AAAA
		]]>
	</query>


	<query id="distributeHistory.selectVersionMasterInfo" desc="Version Master INFO Insert" fetchSize="10">
		<![CDATA[
			SELECT
				NEXTVAL('UCUBE_VERSION_MANAGER_UCUBE_VERSION_MANAGER_SEQ_SEQ') AS UCUBE_VERSION_MANAGER_SEQ,
				(COALESCE(MAX(VERSION),0)+1) AS SG_VERSION,
				SERVICE_GROUP_SEQ
			FROM
				UCUBE_VERSION_MANAGER
			WHERE
				SERVICE_GROUP_SEQ = (
					SELECT SERVICE_GROUP_SEQ
					FROM UCUBE_VERSION_MANAGER
					WHERE UCUBE_VERSION_MANAGER_SEQ = ?
				)
			GROUP BY SERVICE_GROUP_SEQ
		]]>
	</query>


	<query id="distributeHistory.insertVersionMasterInfo" desc="Version Master INFO Insert">
		<![CDATA[
			INSERT INTO UCUBE_VERSION_MANAGER (
				UCUBE_VERSION_MANAGER_SEQ, SERVICE_GROUP_SEQ, VERSION, STATUS_FLAG, REDISPATCHED_SEQ
			)
			VALUES (
				?, ?, ?, 'G', ?
			)
		]]>
	</query>


	<query id="distributeHistory.insertDispatchMasterInfo" desc="Version Master INFO Insert">
		<![CDATA[
			INSERT INTO UCUBE_DISPATCH_MANAGER (
				UCUBE_DISPATCH_MANAGER_SEQ, DISPATCH_VERSION,
				SYSTEM_SEQ, SERVICE_GROUP_SEQ, STATUS_FLAG, LAST_UPDATED_TIMESTAMP
			)
			SELECT
				NEXTVAL('UCUBE_DISPATCH_MANAGER_UCUBE_DISPATCH_MANAGER_SEQ_SEQ') AS UCUBE_DISPATCH_MANAGER_SEQ,
				A.UCUBE_VERSION_MANAGER_SEQ,
				(
					SELECT SYSTEM_SEQ
					FROM UCUBE_VERSION_DETAIL
					WHERE UCUBE_VERSION_MANAGER_SEQ = A.UCUBE_VERSION_MANAGER_SEQ
					GROUP BY SYSTEM_SEQ
				) AS SYS_SEQ,
				A.SERVICE_GROUP_SEQ,
				'G',
				NOW()
			FROM
				UCUBE_VERSION_MANAGER A
			WHERE
				A.UCUBE_VERSION_MANAGER_SEQ = ?
		]]>
	</query>


	<query id="distributeHistory.insertVersionDetailInfo" desc="Version Detail INFO Insert" fetchSize="10">
		<![CDATA[
			INSERT INTO UCUBE_VERSION_DETAIL (
				UCUBE_VERSION_DETAIL_SEQ, UCUBE_VERSION_MANAGER_SEQ,
				SERVICE_GROUP_VERSION,
				SYSTEM_SEQ, SYSTEM_VERSION,
				SERVICE_SEQ, SERVICE_VERSION,
				FUNCTION_UNIT_SEQ, FUNCTION_UNIT_VERSION,
				INTERFACE_SEQ, INTERFACE_VERSION, INTERFACE_SERVICE_VERSION
			)
			SELECT
				NEXTVAL('UCUBE_VERSION_DETAIL_UCUBE_VERSION_DETAIL_SEQ_SEQ'),
				?,  -- NEW UVM_SEQ
				B.SERVICE_GROUP_VERSION,
				B.SYSTEM_SEQ, B.SYSTEM_VERSION,
				B.SERVICE_SEQ, B.SERVICE_VERSION,
				B.FUNCTION_UNIT_SEQ, B.FUNCTION_UNIT_VERSION,
				B.INTERFACE_SEQ, B.INTERFACE_VERSION, B.INTERFACE_SERVICE_VERSION
			FROM
				UCUBE_VERSION_MANAGER A,
				UCUBE_VERSION_DETAIL B
			WHERE
				A.UCUBE_VERSION_MANAGER_SEQ = ? AND  -- OLD UVM_SEQ
				B.UCUBE_VERSION_MANAGER_SEQ = A.UCUBE_VERSION_MANAGER_SEQ
			ORDER BY B.UCUBE_VERSION_DETAIL_SEQ
		]]>
	</query>

</queryMap>

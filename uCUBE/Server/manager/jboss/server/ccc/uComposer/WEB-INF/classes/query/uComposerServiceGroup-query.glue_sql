<?xml version='1.0' encoding='EUC-KR'?>
<queryMap desc="uComposer Project Query File">
	
	<query id="serviceGroupType.select" desc="Interface Group Master Insert" fetchSize="10">
		<![CDATA[
    		SELECT service_group_type_seq, service_group_type_id, description, service_group_type_category
		  	FROM ucube_service_group_type
		  	ORDER BY service_group_type_seq
		]]>
	</query>
	
	<query id="serviceGroupMaster.insert" desc="Interface Group Master Insert" fetchSize="10">
		<![CDATA[
    		INSERT INTO ucube_service_group_master(
            	system_seq, 
            	service_group_id, 
            	service_group_type_seq)
    		VALUES (?, ?, ?);
		]]>
	</query>
	
	<query id="serviceGroupMaster.select" desc="Interface Group Master Select" fetchSize="10">
		<![CDATA[
    		SELECT 
    			service_group_seq
    		FROM 
    			ucube_service_group_master
			WHERE	
    			system_seq=? AND service_group_id = ?
		]]>
	</query>
	
	<query id="serviceGroup.insert" desc="Interface Group Insert" fetchSize="10">
		<![CDATA[
			INSERT INTO ucube_service_group(
				service_group_seq, 
	            version, 
	            description, 
	            src_pc, 
	            reconnect_interval, 
	            event_queue, 
	            data_queue, 
	            encoding_value, 
	            enable_monitor, 
	            back_ground_conn, 
	            on_signal, 
	            log_config_file, 
	            log_maxfilesize, 
	            log_level, 
	            log_maxbackupindex, 
	            enable_livecheck, 
	            livecheck_server_port, 
	            check_memory_usage, 
	            event_type, 
	            seq_config_file, 
	            channel_server_start, 
	            channel_server_port, 
	            type,
	            destination_name, 
	            jmsprovider_url, 
	            initial_context_factory, 
	            topic_connection_factory, 
	            topic_name, 
	            topic_prefix, 
	            username, 
	            password, 
	            send_status_interval, 
	            reconnect_try_count, 
	            enable_localqueue, 
	            ucube_user_seq,
	            last_updated_timestamp)
	        VALUES (?, coalesce((SELECT MAX(version)+1 FROM ucube_service_group WHERE service_group_seq = ?), 1), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NOW());    
		]]>
	</query>

	<query id="serviceGroup.select" desc="Service Select" fetchSize="10">
		<![CDATA[
    		SELECT 
    			*
    		FROM 
    			ucube_service_group_master sgm, ucube_service_group sg
			WHERE	
    			sgm.service_group_seq = sg.service_group_seq AND sg.service_group_seq = ?
    			AND version = (SELECT MAX(version) FROM ucube_service_group WHERE service_group_seq = sg.service_group_seq)
		]]>
	</query>
	
	<query id="serviceGroupAll.select" desc="Service Select" fetchSize="10">
		<![CDATA[
    		SELECT 
    			*
    		FROM 
    			ucube_service_group_master
    		WHERE
    			usable IS NOT FALSE	
		]]>
	</query>
	
</queryMap>

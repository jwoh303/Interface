<?xml version='1.0' encoding='UTF-8'?>
<queryMap desc="uComposer Project Query File">

	<query id="mapper.interface.select" desc="Mapper List Select" fetchSize="10">
		<![CDATA[
			SELECT interface_id
			FROM ucube_interface_master
			WHERE interface_seq = ? 
		]]>
	</query>
	
	<query id="mapper.function_unit_seq.select" desc="Mapper List Select" fetchSize="10">
		<![CDATA[
			SELECT function_unit_seq
  			FROM ucube_function_unit_master
  			WHERE service_seq = ? AND function_unit_type_seq = 16
		]]>
	</query>
	
	<query id="mapper.select" desc="Mapper List Select" fetchSize="10">
		<![CDATA[
			SELECT *
			FROM ucube_ifd_manager
			WHERE interface_seq = ? and function_unit_seq = ?
			and version = (select MAX(version) from ucube_ifd_manager where interface_seq = ? and function_unit_seq = ?) 
		]]>
	</query>
	
	<query id="mapper.insert_ifd_manager" desc="Mapper Rule Insert">
		<![CDATA[
			INSERT INTO UCUBE_IFD_MANAGER(
            interface_seq, function_unit_seq, version)
    		VALUES (?, ?, coalesce((SELECT MAX(version)+1 FROM UCUBE_IFD_MANAGER WHERE interface_seq = ? and function_unit_seq = ?), 1))
		]]>
	</query>
	
	<query id="mapper.select_max_value" desc="Mapper select max_value from ucube_ifd_manager" fetchSize="10">
		<![CDATA[
			SELECT MAX(rule_seq) FROM UCUBE_IFD_MANAGER
		]]>
	</query>
	
	<query id="mapper.select_ruleseq_value" desc="Mapper select rule_seq from ucube_ifd_manager">
		<![CDATA[
			SELECT rule_seq FROM UCUBE_IFD_MANAGER 
			WHERE rule_seq = ?
		]]>
	</query>
	
	<query id="mapper.select_input_field" desc="Mapper Rule select INPUT_FIELD">
		<![CDATA[
			SELECT INPUT_FIELD_NO, INPUT_FIELD_NAME, INPUT_FIELD_START, INPUT_FIELD_LENGTH
  			FROM UCUBE_INPUT_FIELD
  			WHERE rule_seq = ? 
		]]>
	</query>
	
	<query id="mapper.insert_input_field" desc="Mapper Rule Insert INPUT_FIELD">
		<![CDATA[
			INSERT INTO UCUBE_INPUT_FIELD(
            rule_seq, INPUT_FIELD_NO, INPUT_FIELD_NAME, INPUT_FIELD_START, INPUT_FIELD_LENGTH)
    		VALUES (?, ?, ?, ?, ?)

		]]>
	</query>
	
	<query id="mapper.select_output_field" desc="Mapper Rule select OUTPUT_FIELD">
		<![CDATA[
			SELECT OUTPUT_FORMAT_NO, OUTPUT_FORMAT_NAME, INPUT_FORMAT_SEQ, INPUT_FIELD_NO, TRANS_FUNCTION, TRANS_FUNCTION_FIELD1, TRANS_FUNCTION_FIELD2
  			FROM UCUBE_OUTPUT_FIELD
  			WHERE rule_seq = ? 
		]]>
	</query>
	
	<query id="mapper.insert_output_field" desc="Mapper Rule Insert UCUBE_OUTPUT_FIELD">
		<![CDATA[
			INSERT INTO UCUBE_OUTPUT_FIELD(
            rule_seq, OUTPUT_FORMAT_NO, OUTPUT_FORMAT_NAME, INPUT_FORMAT_SEQ, INPUT_FIELD_NO, TRANS_FUNCTION, TRANS_FUNCTION_FIELD1, TRANS_FUNCTION_FIELD2)
    		VALUES (?, ?, ?, 0, ?, ?, ?, ?)
		]]>
	</query>
	
	<query id="mapper.select.getinterface" desc="Mapper Rule Select interface id for creating XSL ">
		<![CDATA[
			SELECT t1.interface_seq, t1.interface_id 
			FROM ucube_interface_master t1 INNER JOIN ucube_ifd_manager t2 
			on t1.interface_seq = t2.interface_seq 
			and function_unit_seq=? 
			and version = (select MAX(version) from ucube_ifd_manager where function_unit_seq = ?) ;
		]]>
	</query>
		
	<query id="mapper.select.createxsl" desc="Mapper Rule Select for creating XSL ">
		<![CDATA[
			SELECT OUTPUT.OUTPUT_FORMAT_NO, OUTPUT.OUTPUT_FORMAT_NAME, OUTPUT.TRANS_FUNCTION, OUTPUT.TRANS_FUNCTION_FIELD1, OUTPUT.TRANS_FUNCTION_FIELD2, INPUT.INPUT_FIELD_NAME, INPUT.INPUT_FIELD_START, INPUT.INPUT_FIELD_LENGTH 
			FROM UCUBE_OUTPUT_FIELD OUTPUT , UCUBE_INPUT_FIELD INPUT
			WHERE OUTPUT.rule_seq = INPUT.rule_seq
			AND OUTPUT.INPUT_FIELD_NO = INPUT.INPUT_FIELD_NO
			AND OUTPUT.rule_seq = ?
		]]>
	</query>
	
	<query id="mapper.select.createxslForGen" desc="Mapper Rule Select for creating XSL for Generation">
		<![CDATA[
			SELECT OUTPUT.OUTPUT_FORMAT_NO, OUTPUT.OUTPUT_FORMAT_NAME, OUTPUT.TRANS_FUNCTION, OUTPUT.TRANS_FUNCTION_FIELD1, OUTPUT.TRANS_FUNCTION_FIELD2, INPUT.INPUT_FIELD_NAME, INPUT.INPUT_FIELD_START, INPUT.INPUT_FIELD_LENGTH 
			FROM UCUBE_OUTPUT_FIELD OUTPUT , UCUBE_INPUT_FIELD INPUT
			WHERE OUTPUT.rule_seq = INPUT.rule_seq
			AND OUTPUT.INPUT_FIELD_NO = INPUT.INPUT_FIELD_NO
			AND OUTPUT.rule_seq = (SELECT rule_seq
				FROM ucube_ifd_manager
				WHERE interface_seq = ? and function_unit_seq = ?
				and version = (select MAX(version) from ucube_ifd_manager where interface_seq = ? and function_unit_seq = ?) )
		]]>
	</query>
	
	<query id="mapper.delete_trans_function" desc="Mapper Rule delete UCUBE_TRANS_FUNCTION ">
		<![CDATA[
			DELETE FROM UCUBE_TRANS_FUNCTION
			WHERE rule_seq = ?
		]]>
	</query>
	
	<query id="mapper.delete_output_field" desc="Mapper Rule delete UCUBE_OUTPUT_FIELD ">
		<![CDATA[
			DELETE FROM UCUBE_OUTPUT_FIELD
			WHERE rule_seq = ?
		]]>
	</query>
	
	<query id="mapper.delete_input_field" desc="Mapper Rule delete UCUBE_OUTPUT_FIELD ">
		<![CDATA[
			DELETE FROM UCUBE_INPUT_FIELD
			WHERE rule_seq = ?
		]]>
	</query>
	
	<query id="mapper.delete_ifd_manager" desc="Mapper Rule delete UCUBE_IFD_MANAGER ">
		<![CDATA[
			DELETE FROM UCUBE_IFD_MANAGER WHERE rule_seq = ?
		]]>
	</query>
	
</queryMap>

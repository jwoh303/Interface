<?xml version="1.0" encoding="EUC-KR"?>
<service name="uComposerConnection-service" initial="EventRouter">
  <activity name="Insert" class="com.posdata.eai.ucomposer.ConnectionInsert">
    <transition name="success" value="Select" />
  </activity>
  <activity name="Select" class="com.posdata.eai.ucomposer.ConnectionSelect">
    <transition name="success" value="end" />
  </activity>
  <activity name="EventRouter" class="com.posdata.glue.biz.activity.PosDefaultRouter">
    <transition name="insert.x" value="Insert" />
    <transition name="select.x" value="Select" />
    <transition name="delete.x" value="Delete" />
  </activity>
  <activity name="Delete" class="com.posdata.eai.ucomposer.ConnectionDelete">
    <transition name="success" value="end" />
  </activity>
</service>


<?xml version='1.0' encoding='EUC-KR'?>
<queryMap desc="uComposer Project Query File">

	<query id="uComposerDbAdapterSqlFucntionUnit.select" desc="Distribute History List Select" fetchSize="10">
		<![CDATA[
			SELECT function_unit_seq 
			FROM ucube_function_unit_master 
			WHERE service_seq = ? 
				AND (function_unit_type_seq=9 OR function_unit_type_seq=17)
		]]>
	</query>
	
	<query id="uComposerDbAdapterSqlVersion.select" desc="Distribute History List Select" fetchSize="10">
		<![CDATA[
			SELECT MAX(version) AS version
			FROM ucube_dbadapter_sql_parent
			WHERE interface_seq = ? AND function_unit_seq = ?
		]]>
	</query>
	
	<query id="uComposerDbAdapterSqlParent.insert" desc="Distribute History List Select" fetchSize="10">
		<![CDATA[
			INSERT INTO 
				ucube_dbadapter_sql_parent(interface_seq, function_unit_seq, sql_seq, version, type, post_sql, param_start, param_length, sql)
		    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);
		]]>
	</query>
	
	<query id="uComposerDbAdapterSqlChild.insert" desc="Distribute History List Select" fetchSize="10">
		<![CDATA[
			INSERT INTO 
				ucube_dbadapter_sql_child( interface_seq, function_unit_seq, sql_seq, version, p_sql_result, type, param_start, param_length, sql)
		    VALUES (?, ?, ?, ?, ?, ?, ?,  ?, ?);
		]]>
	</query>
	
	<query id="uComposerDbAdapterSql.select" desc="Distribute History List Select" fetchSize="10">
		<![CDATA[
			SELECT dsp.*, dsc.p_sql_result AS p_sql_result_c, dsc.type AS type_c, dsc.param_start AS param_start_c, dsc.param_length AS param_length_c, dsc.sql AS sql_c
			FROM ucube_dbadapter_sql_parent dsp 
				LEFT JOIN ucube_dbadapter_sql_child dsc 
				ON dsc.interface_seq = dsp.interface_seq 
					AND dsc.function_unit_seq = dsp.function_unit_seq
					AND dsc.sql_seq = dsp.sql_seq 
					AND dsc.version = dsp.version
			WHERE dsp.interface_seq = ? AND dsp.function_unit_seq = ?
				AND dsp.version=(SELECT MAX(version) FROM ucube_dbadapter_sql_parent WHERE interface_seq=dsp.interface_seq AND function_unit_seq=dsp.function_unit_seq)
			ORDER BY dsp.sql_seq, p_sql_result desc
		]]>
	</query>

</queryMap>
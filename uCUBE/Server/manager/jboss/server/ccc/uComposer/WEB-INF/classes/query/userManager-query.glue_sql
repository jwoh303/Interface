<?xml version='1.0' encoding='EUC-KR'?>
<queryMap desc="uComposer Project Query File">

   <query id="eaiUserListVO.select" desc="user List Select">
		<![CDATA[
			SELECT USER_EMP_NO ,     EAI_USER_PASSWORD ,  LAST_NAME ,  SYS_USER_TP ,  TEAM_NM ,
			       OFFICE_NUMBER ,   HAND_PHONE ,     EMAIL_ADDRESS ,  SMS_RCV_FLAG,  LAST_UPDATE_TIMESTAMP
            FROM TB_S60_USER010
            WHERE USER_EMP_NO LIKE CONCAT(? , '%') 
		]]>
	</query>
	<query id="userCheck.select" desc="user Check Select">
		<![CDATA[
			SELECT COUNT(1) FROM TB_S60_USER010 WHERE USER_EMP_NO = ?
		]]>
	</query>
	
	<query id="eaiUserAdd.insert" desc="user add Insert">
		<![CDATA[
			INSERT INTO TB_S60_USER010
           (USER_EMP_NO,EAI_USER_PASSWORD,LAST_NAME,SYS_USER_TP,HAND_PHONE,EMAIL_ADDRESS,SMS_RCV_FLAG)
            VALUES
           (?,?,?,?,?,?,?)
		]]>
	</query>
	
    <query id="eaiUserDel.delete" desc="user add Insert">
		<![CDATA[
			 
			 DELETE FROM TB_S60_USER010  WHERE USER_EMP_NO = ?
		]]>
	</query>
	
	<query id="modifyUser.update" desc="user modifye update">
		<![CDATA[
	        UPDATE TB_S60_USER010 
	        SET SYS_USER_TP=?,  HAND_PHONE=?,  EMAIL_ADDRESS=?,  SMS_RCV_FLAG=?,  LAST_NAME=? 
	        WHERE USER_EMP_NO=? 
	     ]]>
	</query>
	
</queryMap>
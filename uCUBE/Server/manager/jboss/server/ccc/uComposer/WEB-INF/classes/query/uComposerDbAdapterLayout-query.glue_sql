<?xml version='1.0' encoding='EUC-KR'?>
<queryMap desc="uComposer Project Query File">

	<query id="uComposerDbAdapterLayoutFucntionUnit.select" desc="Distribute History List Select" fetchSize="10">
		<![CDATA[
			SELECT function_unit_seq 
			FROM ucube_function_unit_master 
			WHERE service_seq = ? 
				AND function_unit_type_seq=9
		]]>
	</query>
	
	<query id="uComposerDbAdapterLayoutVersion.select" desc="Distribute History List Select" fetchSize="10">
		<![CDATA[
			SELECT MAX(version) AS version
			FROM ucube_dbadapter_layout_parent
			WHERE interface_seq = ? AND function_unit_seq = ?
		]]>
	</query>
	
	<query id="uComposerDbAdapterLayoutParent.insert" desc="Distribute History List Select" fetchSize="10">
		<![CDATA[
			INSERT INTO ucube_dbadapter_layout_parent(
            	interface_seq, function_unit_seq, linkage_sql_seq, version, tb_name, description, interface_length)
    		VALUES (?, ?, ?, ?, ?, ?, ?);
		]]>
	</query>
	
	<query id="uComposerDbAdapterLayoutChild.insert" desc="Distribute History List Select" fetchSize="10">
		<![CDATA[
			INSERT INTO ucube_dbadapter_layout_child(
	            interface_seq, function_unit_seq, linkage_sql_seq, version, column_seq, col_name, 
	            type, used, precision, start_index, data_length)
			VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
		]]>
	</query>
	
	<query id="uComposerDbAdapterLayout.select" desc="Distribute History List Select" fetchSize="10">
		<![CDATA[
			SELECT dlp.interface_seq, dlp.interface_length, dlp.function_unit_seq, dlp.linkage_sql_seq, tb_name, description, dlc.column_seq, dlc.col_name, dlc.type, dlc.used, dlc.precision, dlc.start_index, dlc.data_length
			FROM ucube_dbadapter_layout_parent dlp
				LEFT JOIN ucube_dbadapter_layout_child dlc 
				ON dlc.interface_seq=dlp.interface_seq
					AND dlc.function_unit_seq = dlp.function_unit_seq
					AND dlc.linkage_sql_seq = dlp.linkage_sql_seq 
					AND dlc.version = dlp.version
			WHERE dlp.interface_seq=? AND dlp.function_unit_seq = ?
				AND dlp.version=(SELECT MAX(version) FROM ucube_dbadapter_layout_parent WHERE interface_seq=dlp.interface_seq AND function_unit_seq=dlp.function_unit_seq)
			ORDER BY dlp.linkage_sql_seq, column_seq
		]]>
	</query>

</queryMap>
<?xml version="1.0" encoding="EUC-KR"?>
<ADAPTER>
	<LINKS>
		<LINK NAME="ALERTMAIL">
			<SOURCEINFO>
				<TYPE>SOURCE</TYPE>
				<SOURCE_NAME>JBOSSMQ</SOURCE_NAME>
				<RUN_TYPE>AUTO_LAUNCH</RUN_TYPE>
				<DESTINATION_TYPE>SMS</DESTINATION_TYPE>
				<SOURCE_CLASS_NAME>com.posdata.eai.adapter.jms.JMSSource</SOURCE_CLASS_NAME>
				<JMSPROVIDER_URL>localhost:1099</JMSPROVIDER_URL>
				<INITIAL_CONTEXT_FACTORY>org.jnp.interfaces.NamingContextFactory</INITIAL_CONTEXT_FACTORY>
				<TOPIC_CONNECTION_FACTORY>UIL2ConnectionFactory</TOPIC_CONNECTION_FACTORY>
				<ONMESSAGE_WAIT_TIME>5000</ONMESSAGE_WAIT_TIME>
				<TOPIC_NAME>ALERT.TOPIC</TOPIC_NAME>
				<TOPIC_PREFIX>topic/</TOPIC_PREFIX>
				<USERNAME>guest</USERNAME>
				<PASSWORD>guest</PASSWORD>
				<DESTINATION_NAME>MAIL</DESTINATION_NAME>
			</SOURCEINFO>
			<DESTINATIONINFO>
				<TYPE>DESTINATION</TYPE>
				<DESTINATION_NAME>MAIL</DESTINATION_NAME>
				<DESTINATION_CLASS_NAME>com.posdata.eai.adapter.alertmail.AlertMailDestination</DESTINATION_CLASS_NAME>
				<SMS_CONFIG_FILE>${UCUBE_HOME}/service/alertmail/config/cfg/mailconfig.cfg</SMS_CONFIG_FILE>
			</DESTINATIONINFO>
		</LINK>
	</LINKS>
	<COMMON>
		<LOG_LEVEL>DEBUG</LOG_LEVEL>
		<EAI_BASE_DIRECTORY>${UCUBE_HOME}/service/alertmail</EAI_BASE_DIRECTORY>
		<SRC_PC>TEST</SRC_PC>
		<ENCODING_VALUE>EUC-KR</ENCODING_VALUE>
		<ENABLE_LIVECHECK>FALSE</ENABLE_LIVECHECK>
		<LIVECHECK_SERVER_PORT>3435</LIVECHECK_SERVER_PORT>
		<ENABLE_MONITOR>FALSE</ENABLE_MONITOR>
	</COMMON>
	<MONITOR>
		<TYPE>DESTINATION</TYPE>
		<DESTINATION_NAME>MON</DESTINATION_NAME>
		<JMSPROVIDER_URL>localhost:1099</JMSPROVIDER_URL>
		<INITIAL_CONTEXT_FACTORY>org.jnp.interfaces.NamingContextFactory</INITIAL_CONTEXT_FACTORY>
		<TOPIC_CONNECTION_FACTORY>UIL2ConnectionFactory</TOPIC_CONNECTION_FACTORY>
		<TOPIC_NAME>ADAPTER.MONITOR</TOPIC_NAME>
		<TOPIC_PREFIX>topic/</TOPIC_PREFIX>
		<USERNAME>guest</USERNAME>
		<PASSWORD>guest</PASSWORD>
		<ENABLE_LOCALQUEUE>FALSE</ENABLE_LOCALQUEUE>
		<SEND_STATUS_INTERVAL>3000</SEND_STATUS_INTERVAL>
	</MONITOR>
</ADAPTER>

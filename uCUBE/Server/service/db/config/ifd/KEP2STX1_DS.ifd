######Common to all adapterse.######

#FILE, TC or DB.
INTERFACE_SOURCE_TYPE=FILE

#FILE, TC or DB.
INTERFACE_TARGET_TYPE=FILE

#TRUE or FALSE
PERSISTENT=TRUE

SEQUENTIAL_DATA=FALSE

#######FOR USE OF FILE ADAPTERS ONLY######
#this flag is used by file receive adapter to store file.
DESTINATION_DIRECTORY=${UCUBE_HOME}/service/db/backup/out/YYYY/MM/DD

#Default Destination File Name
DESTINATION_FILE_NAME=

#This flag is only for file send TRUE/FALSE
USE_SOURCE_FILE_NAME=TRUE

#this flag is used only in case of FILE to TC,TC to FILE
DELIMITER=

#FILE_TYPE=BINARY
FILE_TYPE=BINARY
ENCONDING_VALUE=EUC-KR

#File action.  Values APPEND, OVERWRITE, NEWFILE (Default Value)
FILE_ACTION=NEWFILE

#no. of bytes to be sent in one time.  Set this value based on the system load and system memory configuration
FILE_CHUNK_SIZE=500000

FILE_CHUNK_LINE=100

#NO_ACTION,MOVE,DELETE or COPY
POST_PROCESSING_ACTION=MOVE
POST_PROCESSING_DIRECTORY=${UCUBE_HOME}/service/db/backup/out
#POST_PROCESSING_FILE_NAME=
POST_PROCESSING_OVERWRITE=FALSE
POST_PROCESSING_FILE_COUNT=10


#This Parameter is for using a Unix system Command
#The command could be with or without the switch parametere
#Usage: SYSTEM_COMMAND COMMAND
#Example: ls -al
SYSTEM_COMMAND=

QUEUE_COUNT=1
QUEUE1=STX1

ADAPTER_NAME=KEP
DESTINATION_NAME=JMS

#----- > Do not remove this line <---------------

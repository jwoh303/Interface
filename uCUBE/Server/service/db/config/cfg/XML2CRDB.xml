<?xml version="1.0" encoding="UTF-8"?>
<SERVICEBROKER_HANDLER>
    <SERVICE_BROKER NAME="XML2CRDB">
        <SERVICE NAME="JMSSOURCE">
            <POSITION>START</POSITION>
            <INIT>TRUE</INIT>
            <CONFIG_FILE>JMSSOURCE2.xml</CONFIG_FILE>
	        <QUEUE_NAME>CKEP</QUEUE_NAME>
            <RUN_TYPE>INSTANCE</RUN_TYPE>
            <NEXT_SERVICE>
                <NAME>XMLDBDestination2</NAME>
                <FROM_SPECIFIC_INFO>FALSE</FROM_SPECIFIC_INFO>
                <KEEP_TRANSACTION>TRUE</KEEP_TRANSACTION>
            </NEXT_SERVICE>
        </SERVICE>
        <SERVICE NAME="XMLDBDestination2">
            <POSITION>END</POSITION>
            <INIT>TRUE</INIT>
            <CONFIG_FILE>XMLDBDestination2.xml</CONFIG_FILE>
            <RUN_TYPE>INSTANCE</RUN_TYPE>
        </SERVICE>
        </SERVICE_BROKER>
        <COMMON>
                <LOG_LEVEL>DEBUG</LOG_LEVEL>
                <EAI_BASE_DIRECTORY>${UCUBE_HOME}/service/db</EAI_BASE_DIRECTORY>
                <SRC_PC>KEP</SRC_PC>
                <RECONNECT_INTERVAL>10000</RECONNECT_INTERVAL>
                <EVENT_QUEUE>EVENT.QUEUE</EVENT_QUEUE>
                <DATA_QUEUE>DATA.QUEUE</DATA_QUEUE>
                <ENCODING_VALUE>EUC-KR</ENCODING_VALUE>
                <ENABLE_MONITOR>TRUE</ENABLE_MONITOR>
                <BACK_GROUND_CONN>TRUE</BACK_GROUND_CONN>
        </COMMON>
        <MONITOR>
                <TYPE>DESTINATION</TYPE>
                <DESTINATION_NAME>MON</DESTINATION_NAME>
                <JMSPROVIDER_URL>localhost:1099</JMSPROVIDER_URL>
                <INITIAL_CONTEXT_FACTORY>org.jnp.interfaces.NamingContextFactory</INITIAL_CONTEXT_FACTORY>
                <TOPIC_CONNECTION_FACTORY>UIL2ConnectionFactory</TOPIC_CONNECTION_FACTORY>
                <TOPIC_NAME>ADAPTER.MONITOR</TOPIC_NAME>
                <USERNAME>guest</USERNAME>
                <PASSWORD>guest</PASSWORD>
                <ENABLE_LOCALQUEUE>FALSE</ENABLE_LOCALQUEUE>
                <SEND_STATUS_INTERVAL>60000</SEND_STATUS_INTERVAL>
                <TOPIC_PREFIX>topic/</TOPIC_PREFIX>
        </MONITOR>
</SERVICEBROKER_HANDLER>

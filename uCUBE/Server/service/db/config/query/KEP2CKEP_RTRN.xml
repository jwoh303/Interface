        <SQL_DOC INTERFACE_ID="KEP2CKEP_RTRN">
                <V_SQL NAME='$G_RS' ISLOOP="TRUE" COMMIT_BY_RESULT="FALSE">
                       SELECT KEP_SEQ
                       FROM  KEPCON.IF_C_RTRN_UC
                       WHERE IF_FLAG = 'N'
                       ORDER BY KEP_SEQ
                </V_SQL>
                <P_SQL SEQ="1" TYPE="SELECT" POST_SQL="TRUE">
                <![CDATA[
          					  SELECT KEP_SEQ
          						,DOC_TYPE
          						,TARGET
          						,DATA01
          						,DATA02
          						,DATA03
          						,DATA04
          						,DATA05
          						,DATA06
          						,DATA07
          						,DATA08
          						,DATA09
          						,DATA10
          						,DATA11
          						,DATA12
          						,DATA13
          						,DATA14
          						,DATA15
          						,DATA16
          						,DATA17
          						,DATA18
          						,DATA19
          						,DATA20
          						,CREATE_DATE
          						,IF_FLAG
          						,IF_DATE
          						,IF_MSG
          					FROM KEPCON.IF_C_RTRN_UC
          					WHERE IF_FLAG = 'N'
          					  AND KEP_SEQ = $G_RS.KEP_SEQ$
                ]]>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
                        <![CDATA[
                           UPDATE KEPCON.IF_C_RTRN_UC
                           SET    IF_FLAG = 'Y'
                                , IF_DATE = sysdate
                           WHERE  KEP_SEQ = $G_RS.KEP_SEQ$
                        ]]>
                        </C_SQL>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">
                        <![CDATA[
                           UPDATE KEPCON.IF_C_RTRN_UC
                           SET    IF_FLAG = 'E'
                                , IF_DATE = sysdate
                           WHERE  KEP_SEQ = $G_RS.KEP_SEQ$
                        ]]>
                        </C_SQL>
                </P_SQL>
        </SQL_DOC>

<?xml version="1.0" encoding="EUC-KR"?>
<SQL>
        <!-- *********************************************************************** -->
        <SQL_DOC INTERFACE_ID="KEP2KOLN_RT">
                <V_SQL NAME='$G_RS' ISLOOP="TRUE" COMMIT_BY_RESULT="FALSE">
                        SELECT DOC_NAME AS DOC_NAME, TARGET AS BUYER, KEY_1 AS QUOTATION_NO, KEY_2 AS QUOTATION_SEQ, KEY_3 AS REVISION
                        FROM ICOMTRXL
                        WHERE DOC_NAME = 'QTHDDOWN'
                        AND TARGET IN (SELECT BUYER FROM IF_ADMIN WHERE BUYER_ID='KOLN')
                        AND KEY_9 = 'N'
                        GROUP BY DOC_NAME, TARGET, KEY_1, KEY_2, KEY_3
                </V_SQL>
                <P_SQL SEQ="1" TYPE="SELECT" POST_SQL="TRUE">
                <![CDATA[

                        SELECT nvl(a.status,' ') as status,
                               to_char(sysdate,'YYYYMMDD') as ADD_DATE,
                               to_char(sysdate,'HH24MISS') as ADD_TIME,
                               nvl(a.quotation_no       ,' ') as QUOTATION_NO,
                               nvl(a.quotation_seq      ,' ') as QUOTATION_SEQ,
                               nvl(a.revision           ,  0) as REVISION_NO,
                               nvl(a.buyer_item_no      ,' ') as BUYER_ITEM_NO,
                               nvl(a.description        ,' ') as DESCRIPTION,
                               nvl(a.specification      ,' ') as SPECFICATION,
                               nvl(a.unit_measure       ,' ') as UNIT_MEASURE,
                               nvl(b.atob_unit_price    , 0 ) as UNIT_PRICE,
                               nvl(a.atob_remark        ,' ') as SEND_REMARK
                         FROM KEPRQDT a, KEPQTDT b, ICOMCMPY c
                        WHERE a.BUYER        = '$G_RS.BUYER$'
                          AND a.QUOTATION_NO = '$G_RS.QUOTATION_NO$'
                          AND a.QUOTATION_SEQ= '$G_RS.QUOTATION_SEQ$'
                          AND a.REVISION     = '$G_RS.REVISION$'
                          AND a.BUYER = b.BUYER
                          AND a.QUOTATION_NO = b.QUOTATION_NO
                          AND a.QUOTATION_SEQ= b.QUOTATION_SEQ
                          AND a.REVISION = b.REVISION
                          AND b.STATUS in ('C','R')
                          AND b.bid_success_flag = 'Y'
                          AND b.agent = c.com_code

                ]]>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
                        <![CDATA[
                                UPDATE ICOMTRXL
                                SET KEY_9 = 'Z', KEY_10 = TO_CHAR(SYSDATE,'YYYYMMDD HH24MISS')
                                WHERE  DOC_NAME = '$G_RS.DOC_NAME$'
                                AND TARGET       = '$G_RS.BUYER$'
                                AND KEY_1       = '$G_RS.QUOTATION_NO$'
                                AND KEY_2       = '$G_RS.QUOTATION_SEQ$'
                                AND KEY_3      = '$G_RS.REVISION$'
                                AND KEY_9 = 'N'
                        ]]>
                        </C_SQL>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">
                        <![CDATA[
                                UPDATE ICOMTRXL
                                SET KEY_9 = 'E', KEY_10 = TO_CHAR(SYSDATE,'YYYYMMDD HH24MISS')
                                WHERE  DOC_NAME = '$G_RS.DOC_NAME$'
                                AND TARGET       = '$G_RS.BUYER$'
                                AND KEY_1       = '$G_RS.QUOTATION_NO$'
                                AND KEY_2       = '$G_RS.QUOTATION_SEQ$'
                                AND KEY_3      = '$G_RS.REVISION$'
                                AND KEY_9 = 'N'
                        ]]>
                        </C_SQL>
                </P_SQL>
        </SQL_DOC>
        <RETRY_CODE>
                <CODE>03113</CODE>
                <CODE>03114</CODE>
                <CODE>02154</CODE>
                <CODE>02541</CODE>
                <CODE>04068</CODE>
        </RETRY_CODE>
</SQL>

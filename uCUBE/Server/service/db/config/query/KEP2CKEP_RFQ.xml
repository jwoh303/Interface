<SQL>
        <!-- *********************************************************************** -->
        <SQL_DOC INTERFACE_ID="KEP2CKEP_RFQ">
                <V_SQL NAME='$G_RS' ISLOOP="TRUE" COMMIT_BY_RESULT="FALSE">
                       SELECT KEP_SEQ
                       FROM  KEPCON.IF_C_REDT_UC
                       WHERE IF_FLAG = 'N'
                       ORDER BY KEP_SEQ
                </V_SQL>
                <P_SQL SEQ="1" TYPE="SELECT" POST_SQL="TRUE">
                <![CDATA[
                       SELECT KEP_SEQ
                            , KEP_SEQ
                            , SITE
                            , BUYER
                            , QUOTATION_NO
                            , QUOTATION_SEQ
                            , REVISION
                            , STATUS
                            , ADD_DATE
                            , BUYER_ITEM_NO
                            , DESCRIPTION
                            , SPECIFICATION
                            , MAKER_NAME
                            , ORIGIN_NAME
                            , UNIT_MEASURE
                            , PREV_UNIT_PRICE
                            , OLD_AGENT
                            , REMARK
                            , CATEG_NAME1
                            , CATEG_NAME2
                            , REMARK_HEAD
                            , H_IMAGE_KEY
                            , REMARK_DETAIL1
                            , REMARK_DETAIL2
                            , D_IMAGE_KEY
                            , DWING_NO
                            , DW_IMAGE_KEY
                            , REQ_USER_NAME
                            , REQ_USER_DEPT
                            , QC_INSPECTION
                            , DELY_CONDITION
                            , FILE_NAME
                            , LOAD_DATE
                            , LOAD_TIME
                            , REQ_USER_TEL
                            , REF_IF_NO
                            , RD_DATE
                            , CLOSE_DATE
                            , ITEM_QTY
                            , ERROR_MSG
                            , HD_REMARK
                            , ADD_USER_ID
                            , BYIT_COMORG_CODE
                            , IF_FLAG
                            , REMARK_URL
                            , CREATE_DATE
                            , CLOSE_TIME
                            , ETC_REMARK
                            , REQ_USER_FAX
                            , REQ_USER_MAIL
                            , ITEM_GUBUN
                            , CATEGORY_NO
                            , YEAR_QTY
                            , CONTRACT_NO
                            , CONTRACT_SEQ
                            , MAKER_PART_NO
                            , PLANT
                            , UNTPRC_SRLNO
                       FROM  KEPCON.IF_C_REDT_UC
                       WHERE KEP_SEQ = $G_RS.KEP_SEQ$

                ]]>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
                        <![CDATA[
                           UPDATE KEPCON.IF_C_REDT_UC
                           SET    IF_FLAG = 'Y'
                                , IF_DATM = sysdate
                           WHERE  KEP_SEQ = $G_RS.KEP_SEQ$
                        ]]>
                        </C_SQL>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">
                           UPDATE KEPCON.IF_C_REDT_UC
                           SET    IF_FLAG = 'E'
                                , IF_DATM = sysdate
                           WHERE  KEP_SEQ = $G_RS.KEP_SEQ$
                        <![CDATA[
                        ]]>
                        </C_SQL>
                </P_SQL>
        </SQL_DOC>
        <RETRY_CODE>

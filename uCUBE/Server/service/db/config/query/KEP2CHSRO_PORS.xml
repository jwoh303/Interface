<?xml version="1.0" encoding="UTF-8"?>
<SQL>
        <!-- *********************************************************************** -->
        <SQL_DOC INTERFACE_ID="KEP2CHSRO_PORS">
                <V_SQL NAME='$G_RS' ISLOOP="TRUE" COMMIT_BY_RESULT="FALSE">
                        SELECT KEP_SEQ
                        FROM   KEPCON.IF_C_FILE_UC
                        WHERE  DOC_TYPE = 'PORS'
                        AND    BUYER IN  ('CNHANW0001')
                        AND    IF_FLAG = 'N'
                        ORDER  BY BUYER, KEY_NO, KEY_SEQ
                </V_SQL>
                <P_SQL SEQ="1" TYPE="SELECT" POST_SQL="TRUE">
                <![CDATA[
                        SELECT f_split(data01,'^',1)   AS PLANT
                             , key_no   as LEGACY_PO_NO
                             , key_seq  as LEGACY_PO_SEQ
                             , f_split(data01,'^',2)   AS BUYER_ITEM_NO
                        FROM   KEPCON.IF_C_FILE_UC
                        WHERE  KEP_SEQ = '$G_RS.KEP_SEQ$'
                ]]>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
                        <![CDATA[
                                UPDATE KEPCON.IF_C_FILE_UC
                                SET    IF_FLAG  = 'Y'
                                     , IF_DATE  = to_char(SYSDATE,'YYYYMMDD')
                                     , IF_TIME  = to_char(SYSDATE,'HH24MISS')
                                WHERE  KEP_SEQ = '$G_RS.KEP_SEQ$'
                        ]]>
                        </C_SQL>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">
                        <![CDATA[
                                UPDATE KEPCON.IF_C_FILE_UC
                                SET    IF_FLAG  = 'E'
                                     , IF_DATE  = to_char(SYSDATE,'YYYYMMDD')
                                     , IF_TIME  = to_char(SYSDATE,'HH24MISS')
                                WHERE  KEP_SEQ = '$G_RS.KEP_SEQ$'
                        ]]>
                        </C_SQL>
                </P_SQL>
        </SQL_DOC>
        <RETRY_CODE>
                <CODE>03113</CODE>
                <CODE>03114</CODE>
                <CODE>02154</CODE>
                <CODE>02541</CODE>
                <CODE>04068</CODE>
        </RETRY_CODE>
</SQL>

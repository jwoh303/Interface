<?xml version="1.0" encoding="UTF-8"?>
<SQL>
        <!-- *********************************************************************** -->
        <SQL_DOC INTERFACE_ID="KEP2CKEP_IV">
                <V_SQL NAME='$G_RS' ISLOOP="TRUE" COMMIT_BY_RESULT="FALSE">
                       SELECT KEP_SEQ
                       FROM  KEPCON.IF_C_IVDT_UC
                       WHERE IF_FLAG = 'N'
                       ORDER BY KEP_SEQ
                </V_SQL>
                <P_SQL SEQ="1" TYPE="SELECT" POST_SQL="TRUE">
                <![CDATA[
                       SELECT KEP_SEQ
                            , SITE
                            , BUYER
                            , STATUS
                            , LEGACY_IV_NO
                            , LEGACY_IV_SEQ
                            , REVISION
                            , PO_NO
                            , PO_SEQ
                            , LEGACY_PO_NO
                            , LEGACY_PO_SEQ
                            , BUYER_ITEM_NO
                            , INVOICE_DATE
                            , INV_QTY
                            , INV_NO
                            , INV_SEQ
                            , ERROR_MSG
                            , LOAD_DATE
                            , LOAD_TIME
                            , IF_FLAG
                            , REMARK
                            , DS_DATE
                            , STC_D_SELLER_PRICE
                            , PROCESS_TYPE
                            , TABLE_FLAG
                            , DELIVERY_QTY
                            , DELIVERY_DATE
                            , PLANT
                       FROM  KEPCON.IF_C_IVDT_UC
                       WHERE KEP_SEQ = $G_RS.KEP_SEQ$

                ]]>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
                        <![CDATA[
                           UPDATE KEPCON.IF_C_IVDT_UC
                           SET    IF_FLAG = 'Y'
                                , IF_DATM = sysdate
                           WHERE  KEP_SEQ = $G_RS.KEP_SEQ$
                        ]]>
                        </C_SQL>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">
                           UPDATE KEPCON.IF_C_IVDT_UC
                           SET    IF_FLAG = 'E'
                                , IF_DATM = sysdate
                           WHERE  KEP_SEQ = $G_RS.KEP_SEQ$
                        <![CDATA[
                        ]]>
                        </C_SQL>
                </P_SQL>
        </SQL_DOC>
        <RETRY_CODE>
                <CODE>03113</CODE>
                <CODE>03114</CODE>
                <CODE>02154</CODE>
                <CODE>02541</CODE>
                <CODE>04068</CODE>
        </RETRY_CODE>
</SQL>

<?xml version="1.0" encoding="UTF-8"?>
<SQL>
        <!-- *********************************************************************** -->
        <SQL_DOC INTERFACE_ID="KEP2CKEP_GR">
                <V_SQL NAME='$G_RS' ISLOOP="TRUE" COMMIT_BY_RESULT="FALSE">
                       SELECT KEP_SEQ
                       FROM  KEPCON.IF_C_GRDT_UC
                       WHERE IF_FLAG = 'N'
                       ORDER BY KEP_SEQ

                </V_SQL>
                <P_SQL SEQ="1" TYPE="SELECT" POST_SQL="TRUE">
                <![CDATA[
                       SELECT KEP_SEQ
                            , SITE
                            , BUYER
                            , STATUS
                            , LEGACY_PO_NO
                            , LEGACY_PO_SEQ
                            , BUYER_ITEM_NO
                            , BUYER_ITEM_NO1
                            , CURRENCY_CODE
                            , UNIT_PRICE
                            , GR_QTY
                            , GR_AMT
                            , GR_DATE
                            , LEGACY_PR_NO
                            , LEGACY_INV_NO
                            , LEGACY_GR_NO
                            , LEGACY_GR_SEQ
                            , REVISION
                            , RO_QTY
                            , RO_AMT
                            , REMARK
                            , ERROR_MSG
                            , REF_IF_NO
                            , REF_IF_NO1
                            , FILE_NAME
                            , LOAD_DATE
                            , LOAD_TIME
                            , ADD_USER_ID
                            , CHANGE_DATE
                            , CHANGE_TIME
                            , CHANGE_USER_ID
                            , IF_FLAG
                            , BYIT_COMORG_CODE
                            , PO_NO
                            , PO_SEQ
                            , TARGET_PRICE
                            , DELY_TO_LOCATION
                            , PLANT
                            , IF_DATM
                       FROM  KEPCON.IF_C_GRDT_UC
                       WHERE KEP_SEQ = $G_RS.KEP_SEQ$

                ]]>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
                        <![CDATA[
                           UPDATE KEPCON.IF_C_GRDT_UC
                           SET    IF_FLAG = 'Y'
                                , IF_DATM = sysdate
                           WHERE  KEP_SEQ = $G_RS.KEP_SEQ$
                        ]]>
                        </C_SQL>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">
                           UPDATE KEPCON.IF_C_GRDT_UC
                           SET    IF_FLAG = 'E'
                                , IF_DATM = sysdate
                           WHERE  KEP_SEQ = $G_RS.KEP_SEQ$
                        <![CDATA[
                        ]]>
                        </C_SQL>
                </P_SQL>
        </SQL_DOC>
        <RETRY_CODE>
                <CODE>03113</CODE>
                <CODE>03114</CODE>
                <CODE>02154</CODE>
                <CODE>02541</CODE>
                <CODE>04068</CODE>
        </RETRY_CODE>
</SQL>

<?xml version="1.0" encoding="EUC-KR"?>
<SQL>
	<!-- *********************************************************************** -->
	<SQL_DOC INTERFACE_ID="KEP2FASH_RT">
		<V_SQL NAME='$G_RS' ISLOOP="TRUE" COMMIT_BY_RESULT="FALSE"> 
			SELECT TARGET AS BUYER, KEY_1 AS QUOTATION_NO, KEY_2 AS QUOTATION_SEQ, KEY_3 AS REVISION, KEY_4
			FROM ICOMTRXL
			WHERE  DOC_NAME = 'QTHDDOWN'
			AND TARGET   IN ('KRKOLO0035','KRKOLO0037','KRKOLO0044')
			AND TRIM(KEY_9) = 'N'
			GROUP BY TARGET, KEY_1, KEY_2, KEY_3, KEY_4
		</V_SQL> 
		<P_SQL SEQ="1" TYPE="SELECT" POST_SQL="TRUE">
		<![CDATA[
			
			SELECT 
				BUYER,
				QUOTATION_NO,
				QUOTATION_SEQ,
				REVISION,
				QUOTATION_DATE,
				BUYER_ITEM_NO,
				DESCRIPTION,
				UNIT_MEASURE,
				MAKER_NAME,
				SUPPLIER,
				(
					SELECT  NVL(COM_NAME_LOC,' ')
					FROM  ICOMCMPY
					WHERE  COM_CODE   = SUPPLIER
					AND  STATUS IN ('C','R')
					AND  ROWNUM = 1
				) AS SELLER_NAME,
				(
					SELECT  NVL(USER_NAME_LOC,' ')
					FROM  ICOMLUSR
					WHERE  COM_CODE   = SUPPLIER
					AND  STATUS IN ('C','R')
					AND  ROWNUM = 1
				) AS SUPPLIER_PERSON_NAME,
				(
					SELECT  NVL(PHONE_NUMBER,' ')
					FROM  ICOMLUSR
					WHERE  COM_CODE   =SUPPLIER
					AND  STATUS IN ('C','R')
					AND  ROWNUM = 1
				) AS SUPPLIER_TELNO,
				UNIT_PRICE,
				QUOTATION_PRICE,
				ADD_DATE,
				REQ_USER_ID,
				REQ_USER_NAME,
				REQ_USER_DEPT_CODE,
				REQ_USER_DEPT_NAME,
				REQ_USER_TEL,
				REQ_USER_MAIL,
				CLOSE_DATE,
				ITEM_QTY,
				REQ_USER_TEL,
				REMARK
			FROM (
					SELECT 
						A.BUYER ,
								A.QUOTATION_NO AS QUOTATION_NO,
								A.QUOTATION_SEQ AS QUOTATION_SEQ,
								A.REVISION AS REVISION,
								TO_CHAR(SYSDATE,'YYYYMMDD') AS QUOTATION_DATE,
								A.BUYER_ITEM_NO AS BUYER_ITEM_NO,
								B.DESCRIPTION||'/'||B.SPECIFICATION AS DESCRIPTION,
								B.UNIT_MEASURE AS UNIT_MEASURE,
								NVL(B.MAKER_NAME,' ') AS MAKER_NAME,
								NVL(D.AGENT,B.AGENT) AS SUPPLIER,
								NVL(A.PREV_UNIT_PRICE,0) AS UNIT_PRICE,
								NVL(D.ATOB_UNIT_PRICE,B.UNIT_PRICE) AS QUOTATION_PRICE,
								A.ADD_DATE AS ADD_DATE,
								A.ADD_USER_ID AS REQ_USER_ID,
								A.REQ_USER_NAME AS REQ_USER_NAME,
								' ' AS REQ_USER_DEPT_CODE,
								A.REQ_USER_DEPT AS REQ_USER_DEPT_NAME,
								NVL(A.REQ_USER_TEL,' ') AS REQ_USER_TEL,
								NVL(A.REQ_USER_MAIL,' ') AS REQ_USER_MAIL,
								A.CLOSE_DATE AS CLOSE_DATE,
								NVL(A.ITEM_QTY,0) AS ITEM_QTY,
								' ' AS REMARK
						   FROM IF_REDT A, ICOMCQDT B, KEPRQDT C, KEPQTDT D
						  WHERE A.BUYER         = '$G_RS.BUYER$'
							AND A.QUOTATION_NO  = '$G_RS.QUOTATION_NO$'
							AND A.QUOTATION_SEQ = '$G_RS.QUOTATION_SEQ$'
							AND TO_NUMBER(A.REVISION) = '$G_RS.REVISION$'
							AND A.BUYER = C.BUYER
							AND A.QUOTATION_NO = C.QUOTATION_NO
							AND A.QUOTATION_SEQ= C.QUOTATION_SEQ
							AND TO_NUMBER(A.REVISION)  = C.REVISION
							AND A.BYIT_COMORG_CODE = B.BUYER
							AND C.BUYER_ITEM_NO = B.BUYER_ITEM_NO
							AND C.CONTRACT_NO   = B.CONTRACT_NO
							AND C.CONTRACT_SEQ  = B.CONTRACT_SEQ
							AND D.BUYER(+) = C.BUYER
							AND D.QUOTATION_NO(+) = C.QUOTATION_NO
							AND D.QUOTATION_SEQ(+)= C.QUOTATION_SEQ
							AND D.STATUS(+) ^= 'O'
							AND D.BID_SUCCESS_FLAG(+) = 'Y'
			)

		]]>
			<C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
			<![CDATA[
				
				DECLARE

					V_SEND_DATE		ICOMPORS.SEND_DATE%TYPE;
					V_SEND_TIME		ICOMPORS.SEND_TIME%TYPE;
					V_SEND_DATETIME	ICOMTRXL.KEY_8%TYPE;

				BEGIN
					
					SELECT
					TO_CHAR(SYSDATE,'YYYYMMDD'), TO_CHAR(SYSDATE,'HH24MISS'), TO_CHAR(SYSDATE,'YYYYMMDD HH24MISS')
					INTO V_SEND_DATE, V_SEND_TIME, V_SEND_DATETIME
					FROM DUAL;
					

					IF '$G_RS.KEY_4$' LIKE '%BYIT%' THEN

						UPDATE IF_REDT
						SET IF_FLAG = 'Y',
						HD_REMARK='기등록전송'||V_SEND_DATETIME
						WHERE BUYER = '$G_RS.BUYER$'
						AND QUOTATION_NO  = '$G_RS.QUOTATION_NO$'
						AND QUOTATION_SEQ = '$G_RS.QUOTATION_SEQ$'
						AND TO_NUMBER(REVISION)  = '$G_RS.REVISION$'
						;
					
					END IF;

					UPDATE ICOMTRXL
					SET KEY_9 = 'D', KEY_8 = TO_CHAR(SYSDATE,'YYYYMMDD HH24MISS')
					WHERE  DOC_NAME = 'QTHDDOWN'
					AND TARGET       = '$G_RS.BUYER$'
					AND KEY_1       = '$G_RS.QUOTATION_NO$'
					AND KEY_2       = '$G_RS.QUOTATION_SEQ$'
					AND KEY_3       = '$G_RS.REVISION$'
                                        AND KEY_9       = 'N'
					;

				END;

			]]>
			</C_SQL>
			<C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">
			<![CDATA[
				UPDATE ICOMTRXL
				SET KEY_9 = 'E', KEY_8 = TO_CHAR(SYSDATE,'YYYYMMDD HH24MISS')
				WHERE  DOC_NAME = 'QTHDDOWN'
				AND TARGET       = '$G_RS.BUYER$'
				AND KEY_1       = '$G_RS.QUOTATION_NO$'
				AND KEY_2       = '$G_RS.QUOTATION_SEQ$'
				AND KEY_3       = '$G_RS.REVISION$'
                                AND KEY_9       = 'N'
			]]>
			</C_SQL>
		</P_SQL>
	</SQL_DOC>
	<RETRY_CODE>
		<CODE>03113</CODE>
		<CODE>03114</CODE>
		<CODE>02154</CODE>
		<CODE>02541</CODE>
		<CODE>04068</CODE>
	</RETRY_CODE>
</SQL>

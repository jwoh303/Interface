<?xml version="1.0" encoding="UTF-8"?>
<SQL>
        <!-- *********************************************************************** -->
        <SQL_DOC INTERFACE_ID="KEP2CHRNA_ITEM">
                <V_SQL NAME='$G_RS' ISLOOP="TRUE" COMMIT_BY_RESULT="FALSE">
                <![CDATA[
                        SELECT KEP_SEQ
                        FROM   KEPCON.IF_C_FILE_UC
                        WHERE  DOC_TYPE = 'ITEM_DOWN'
                        AND    BUYER IN  ('CNHWAS0001 ','CNHWAS0003 ','CNHAOT0002','CNHAOT0003')
                        AND    IF_FLAG = 'N'
                        AND    ROWNUM <= 100
                        ORDER  BY BUYER, KEY_NO, KEY_SEQ
                ]]>
                </V_SQL>
                <P_SQL SEQ="1" TYPE="SELECT" POST_SQL="TRUE">
                <![CDATA[
                        SELECT data01                   as item_no
                             , TO_NUMBER(data02)        as price
                             , data03                   as status
                             , data04                   as close_flag
                             , data05                   as add_date
                             , case buyer
                               when 'CNHAOT0002' then
                                    'HST'
                               else 'HSR'
                               end                      as plant
                        FROM   KEPCON.IF_C_FILE_UC
                        WHERE  KEP_SEQ = '$G_RS.KEP_SEQ$'
                ]]>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="TRUE">
                        <![CDATA[
                                UPDATE KEPCON.IF_C_FILE_UC
                                SET    IF_FLAG  = 'Y'
                                     , IF_DATE  = to_char(SYSDATE,'YYYYMMDD')
                                     , IF_TIME  = to_char(SYSDATE,'HH24MISS')
                                WHERE  KEP_SEQ = '$G_RS.KEP_SEQ$'
                        ]]>
                        </C_SQL>
                        <C_SQL TYPE="UPDATE" P_SQL_RESULT="FALSE">
                        <![CDATA[
                                UPDATE KEPCON.IF_C_FILE_UC
                                SET    IF_FLAG  = 'E'
                                     , IF_DATE  = to_char(SYSDATE,'YYYYMMDD')
                                     , IF_TIME  = to_char(SYSDATE,'HH24MISS')
                                WHERE  KEP_SEQ = '$G_RS.KEP_SEQ$'
                        ]]>
                        </C_SQL>
                </P_SQL>
        </SQL_DOC>
        <RETRY_CODE>
                <CODE>03113</CODE>
                <CODE>03114</CODE>
                <CODE>02154</CODE>
                <CODE>02541</CODE>
                <CODE>04068</CODE>
        </RETRY_CODE>
</SQL>

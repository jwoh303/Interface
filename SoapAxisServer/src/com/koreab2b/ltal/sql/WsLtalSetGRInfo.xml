<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap      
    PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
    "http://ibatis.apache.org/dtd/sql-map-2.dtd">

<sqlMap namespace="WsLtalSetGRInfo">

	<update id="setGoodsReceive" parameterClass="com.koreab2b.ltal.vo.GoodsReceiveVO">
	<![CDATA[
		 INSERT INTO  IF_GRDT_UC (
                                KEP_SEQ ,
                                SITE    ,
                                BUYER   ,
                                STATUS  ,
                                LEGACY_GR_NO    ,
                                LEGACY_GR_SEQ   ,
                                GR_DATE  ,                              
                                LEGACY_PO_NO    ,
                                LEGACY_PO_SEQ   ,
                                BUYER_ITEM_NO   ,
                                GR_QTY  ,
                                LEGACY_INV_NO   ,
                                REF_IF_NO       ,
                                REF_IF_NO1      ,
                                LOAD_DATE       ,
                                LOAD_TIME       ,
                                IF_FLAG ,
                                DELY_TO_LOCATION ,
                                PLANT
                        ) VALUES (
                                SEQ_IF_GRDT_UC.NEXTVAL  ,
                                'KA',
                                'LTAL2',
                                DECODE(#STATUS#,'D','D','C'),
                                #LEGACY_GR_NO#,
                                #LEGACY_GR_SEQ#,
                                #GR_DATE#,
                                #LEGACY_PO_NO#,
                                #LEGACY_PO_SEQ#,
                                #BUYER_ITEM_NO#,
                                #GR_QTY#,
                                #LEGACY_IV_NO#,
                                #REF_IF_NO#,
                                #REF_IF_NO1#,
                                TO_CHAR(SYSDATE,'YYYYMMDD'),
                                TO_CHAR(SYSDATE,'HH24MISS'),
                                'N',
                                #DELY_TO_LOCATION#,
                                #PLANT#
                        )
		
	]]>
	</update>

</sqlMap>